page{background:#eef6f2;color:#183d33}.intake-page{padding:42rpx 30rpx 60rpx}.intake-brand{display:flex;flex-direction:column;align-items:center;gap:12rpx;margin-bottom:32rpx}.intake-brand>text:first-child{font-size:42rpx;font-weight:700}.intake-brand>text:last-child{font-size:28rpx;color:#5f786f}.intake-card{background:#fff;border-radius:28rpx;padding:36rpx;box-shadow:0 12rpx 45rpx #174c3610}.intake-title{display:block;font-size:36rpx;font-weight:700;margin-bottom:18rpx}.intake-note{display:block;font-size:28rpx;line-height:1.7;color:#5b7168}.intake-field{display:flex;flex-direction:column;gap:18rpx;padding-top:34rpx}.intake-field>text:first-child{font-size:30rpx;font-weight:600}.intake-field input{height:90rpx;background:#f5f8f6;border:2rpx solid #dae6de;border-radius:16rpx;padding:0 24rpx;font-size:32rpx;color:#173f33}.intake-hint{display:block;font-size:25rpx;line-height:1.7;color:#65786f}.intake-photo{width:100%;height:360rpx;border-radius:16rpx;background:#f4f7f5}.intake-upload{width:100%;font-size:28rpx;font-weight:600;color:#245b4d;background:#edf6f1;border:2rpx solid #accbbc;border-radius:16rpx;line-height:2.8}.intake-consent{margin-top:34rpx;font-size:25rpx;line-height:1.8;color:#3f6153}.intake-consent label{display:flex;align-items:flex-start}.intake-consent checkbox{transform:scale(.85);margin-right:4rpx}.intake-policy{display:block;margin:14rpx 0 0 57rpx;color:#245b4d;text-decoration:underline}.intake-error{display:block;color:#a13f36;font-size:27rpx;line-height:1.6;margin-top:22rpx}.intake-submit{width:100%;background:#245b4d;color:#fff;font-size:32rpx;font-weight:600;border-radius:50rpx;margin:32rpx 0 20rpx;line-height:2.9}.intake-submit[disabled]{background:#87a499;color:#fff}.intake-bottom{display:block;font-size:24rpx;line-height:1.6;text-align:center;color:#647b70;margin-top:30rpx}.intake-success{text-align:center;padding-top:60rpx}.intake-check{display:block;font-size:70rpx;color:#287552;margin-bottom:24rpx}
