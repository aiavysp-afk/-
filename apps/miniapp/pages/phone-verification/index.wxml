<view class="page">
  <view class="header"><text class="back" bindtap="finish">‹</text><text>验证手机号</text><view class="back-placeholder" /></view>
  <view class="visual"><view class="visual-ring"><view class="phone">▯</view><view class="check">✓</view></view></view>
  <view class="content">
    <text class="title">完成手机号验证</text>
    <text class="desc">首次微信登录会自动创建中原到家账号。手机号只用于预约联系、订单履约与售后核验，不会公开展示。</text>
    <view class="notice"><text>安全说明</text><text>优先使用微信官方手机号授权；无法使用时可选择阿里云短信验证。我们不会索取登录密码。</text></view>
    <button wx:if="{{!completed}}" class="primary" open-type="getPhoneNumber" bindgetphonenumber="verifyPhone" loading="{{busy}}" disabled="{{busy}}">微信授权验证手机号</button>
    <view wx:if="{{!completed}}" class="divider"><view /><text>或使用短信验证</text><view /></view>
    <view wx:if="{{!completed}}" class="sms-card">
      <input class="sms-input" type="number" maxlength="11" value="{{phone}}" bindinput="updatePhone" placeholder="请输入本人手机号" />
      <view class="code-row">
        <input class="sms-input code-input" type="number" maxlength="6" value="{{smsCode}}" bindinput="updateSmsCode" placeholder="4–6 位验证码" />
        <button class="code-button" bindtap="requestSmsCode" loading="{{busy && !smsRequested}}" disabled="{{busy || smsCountdown > 0}}">{{smsCountdown > 0 ? smsCountdown + '秒' : '获取验证码'}}</button>
      </view>
      <button class="sms-confirm" bindtap="confirmSmsCode" loading="{{busy && smsRequested}}" disabled="{{busy}}">验证并绑定</button>
    </view>
    <view wx:else class="success"><text class="success-icon">✓</text><view><text>手机号已验证</text><text wx:if="{{maskedPhone}}">{{maskedPhone}}</text></view></view>
    <button wx:if="{{completed}}" class="primary" bindtap="finish">完成并返回</button>
    <text wx:if="{{error}}" class="error">{{error}}</text>
    <text class="footnote">未完成验证仍可浏览服务，但不能提交订单。</text>
  </view>
</view>
