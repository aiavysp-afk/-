<view class="login-page">
  <view class="nav-bar">
    <text class="nav-back" bindtap="finish">‹</text>
    <text class="nav-title">登录</text>
    <view class="nav-space" />
  </view>

  <view class="hero">
    <view class="art-halo halo-one" />
    <view class="art-halo halo-two" />
    <view class="massage-art" aria-label="按摩放松主题插画">
      <view class="art-head" />
      <view class="art-body" />
      <view class="art-shoulder" />
      <view class="art-hand hand-left"><view class="art-finger" /><view class="art-finger" /><view class="art-finger" /></view>
      <view class="art-hand hand-right"><view class="art-finger" /><view class="art-finger" /><view class="art-finger" /></view>
      <view class="art-wave wave-one" />
      <view class="art-wave wave-two" />
    </view>
    <text class="brand">中原到家</text>
    <text class="slogan">安心上门 · 悦享松弛</text>
  </view>

  <view wx:if="{{completed}}" class="login-card success-card">
    <view class="success-mark">✓</view>
    <text class="login-title">登录成功</text>
    <text class="login-subtitle">{{maskedPhone || '手机号已完成验证'}}</text>
    <button class="primary-button" bindtap="enterHome">进入中原到家</button>
  </view>

  <view wx:else class="login-card">
    <text class="login-title">欢迎登录中原到家</text>
    <text class="login-subtitle">新手机号验证后自动注册，无需单独创建账号</text>

    <button
      class="primary-button quick-button"
      open-type="getPhoneNumber"
      bindgetphonenumber="quickLogin"
      loading="{{busy && loginMode === 'QUICK'}}"
      disabled="{{busy}}"
    >手机号一键登录</button>
    <text class="quick-tip">推荐使用微信官方手机号授权，安全快捷</text>

    <view class="divider"><view /><text>或使用短信验证码</text><view /></view>

    <view class="field-shell {{phoneFocused ? 'is-focused' : ''}}">
      <text class="field-prefix">+86</text>
      <input
        class="field-input"
        type="number"
        maxlength="11"
        value="{{phone}}"
        bindinput="updatePhone"
        bindfocus="focusPhone"
        bindblur="blurPhone"
        placeholder="请输入手机号"
        placeholder-class="field-placeholder"
      />
    </view>
    <view wx:if="{{smsRequested}}" class="field-shell code-shell {{codeFocused ? 'is-focused' : ''}}">
      <input
        class="field-input"
        type="number"
        maxlength="6"
        value="{{smsCode}}"
        bindinput="updateSmsCode"
        bindfocus="focusCode"
        bindblur="blurCode"
        placeholder="请输入短信验证码"
        placeholder-class="field-placeholder"
      />
      <button class="resend-button" bindtap="requestSmsCode" disabled="{{busy || smsCountdown > 0}}">{{smsCountdown > 0 ? smsCountdown + 's' : '重新获取'}}</button>
    </view>
    <button
      class="sms-button"
      bindtap="handleSmsAction"
      loading="{{busy && loginMode === 'SMS'}}"
      disabled="{{busy}}"
    >{{smsRequested ? '验证码登录' : '获取验证码'}}</button>

    <text wx:if="{{error}}" class="error-message">{{error}}</text>

    <view class="agreement-row">
      <view class="agreement-check {{accepted ? 'checked' : ''}}" bindtap="toggleAccepted"><text wx:if="{{accepted}}">✓</text></view>
      <view class="agreement-copy">
        <text bindtap="toggleAccepted">我已阅读并同意</text>
        <text class="agreement-link" data-type="user" bindtap="openAgreement">《用户协议》</text>
        <text class="agreement-link" data-type="privacy" bindtap="openAgreement">《隐私政策》</text>
        <text>及</text>
        <text class="agreement-link" data-type="service" bindtap="openAgreement">《上门服务公约》</text>
      </view>
    </view>
  </view>

  <view class="security-note"><text class="security-icon">◇</text><text>手机号仅用于预约联系、订单履约与售后核验</text></view>
</view>
