.login-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: env(safe-area-inset-top) 36rpx
    calc(44rpx + env(safe-area-inset-bottom));
  background: linear-gradient(155deg, #e3f6ec 0%, #f5fbf7 45%, #fff 100%);
  color: #173c33;
}
.nav-bar {
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.nav-back,
.nav-space {
  width: 66rpx;
}
.nav-back {
  font-size: 54rpx;
  line-height: 68rpx;
}
.nav-title {
  font-size: 29rpx;
  font-weight: 600;
}
.brand-heading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 58rpx 0 44rpx;
}
.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: #173f35;
  color: #fff;
  font-size: 49rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 28rpx #173f3526;
}
.brand {
  margin-top: 20rpx;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
}
.slogan {
  margin-top: 9rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #60796d;
}
.login-dialog {
  background: #fff;
  border: 1rpx solid #e3eee8;
  border-radius: 34rpx;
  padding: 42rpx 32rpx 34rpx;
  box-shadow: 0 18rpx 56rpx #173f3512;
  animation: login-appear 0.2s ease-out both;
}
.login-title,
.login-subtitle {
  display: block;
  text-align: center;
}
.login-title {
  font-size: 35rpx;
  font-weight: 700;
}
.login-subtitle {
  margin-top: 14rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.65;
  color: #60766b;
}
.login-actions {
  margin-top: 36rpx;
}
.primary-button,
.secondary-button {
  width: 100%;
  height: 94rpx;
  border-radius: 47rpx;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 94rpx;
  box-sizing: border-box;
}
.primary-button {
  background: linear-gradient(100deg, #22684f, #164b3c);
  color: #fff;
}
.secondary-button {
  margin-top: 20rpx;
  border: 2rpx solid #98c6b3;
  background: #f3faf6;
  color: #1f5541;
}
.primary-button[disabled],
.secondary-button[disabled] {
  background: #cbdad2;
  border-color: #cbdad2;
  color: #52665b;
  opacity: 0.8;
}
.sms-form {
  margin-top: 30rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #e4ede7;
}
.form-title {
  display: block;
  margin-bottom: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.availability-note {
  display: block;
  margin: 12rpx 0 20rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: #f1f7f3;
  color: #526d5d;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.6;
}
.capabilities-status {
  margin-top: 24rpx;
}
.capabilities-status .availability-note {
  margin-bottom: 12rpx;
}
.capabilities-retry {
  margin: 0;
  border: 1rpx solid #bfd9c9;
  border-radius: 30rpx;
  background: #f3faf6;
  color: #1f6a48;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 68rpx;
}
.capabilities-retry[disabled] {
  color: #78887f;
}
.field-shell {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 92rpx;
  padding: 0 20rpx;
  border: 2rpx solid #dce8e0;
  border-radius: 18rpx;
  background: #fbfdfb;
  transition: border-color 0.15s ease;
}
.field-shell.is-focused {
  border-color: #3e9872;
}
.field-prefix {
  padding-right: 18rpx;
  margin-right: 18rpx;
  border-right: 1rpx solid #dce8e0;
  font-size: 27rpx;
  font-weight: 600;
}
.field-input {
  flex: 1;
  width: 0;
  min-height: 88rpx;
  font-size: 27rpx;
  font-weight: 500;
  color: #173c33;
}
.field-placeholder {
  color: #798c81;
}
.code-shell {
  margin-top: 18rpx;
}
.resend-button {
  flex-shrink: 0;
  margin: 0 0 0 12rpx;
  padding: 0 10rpx;
  background: transparent;
  color: #257255;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 72rpx;
}
.resend-button[disabled] {
  color: #78887f;
}
.sms-login-button {
  margin-top: 22rpx;
}
.phone-help,
.security-note,
.service-note {
  display: block;
  color: #60786a;
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1.65;
}
.phone-help {
  margin-top: 16rpx;
}
.flow-note {
  margin-top: 24rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #eef7f1;
  color: #4e6d5b;
  font-size: 24rpx;
  line-height: 1.65;
}
.action-status,
.error-message {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.6;
}
.action-status {
  color: #287455;
}
.error-message {
  color: #a33e36;
}
.agreement-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 30rpx;
}
.agreement-check {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  box-sizing: border-box;
  border: 2rpx solid #91a99a;
  border-radius: 50%;
  color: #fff;
  font-size: 26rpx;
  margin-top: 1rpx;
}
.agreement-check.checked {
  border-color: #236448;
  background: #236448;
}
.agreement-copy {
  color: #657a6d;
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1.8;
}
.agreement-copy text {
  display: inline;
}
.agreement-link {
  color: #1f6a48;
}
.security-note {
  margin-top: 24rpx;
  text-align: center;
}
.service-note {
  margin-top: 8rpx;
  text-align: center;
}
.success-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin: 6rpx auto 26rpx;
  border-radius: 50%;
  background: #e1f3e8;
  color: #236448;
  font-size: 46rpx;
}
.success-mark ~ .primary-button {
  margin-top: 30rpx;
}
@keyframes login-appear {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
