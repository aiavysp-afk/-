.login-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 18% 18%, #f3ead3 0, transparent 31%),
    linear-gradient(160deg, #fffdf8 0, #f8f2e6 46%, #edf5ef 100%);
  padding: env(safe-area-inset-top) 34rpx 70rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}
.login-page:after {
  content: "";
  position: absolute;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  right: -210rpx;
  bottom: 180rpx;
  background: #183f3520;
  filter: blur(2rpx);
}
.nav-bar {
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 2;
}
.nav-back,
.nav-space {
  width: 72rpx;
}
.nav-back {
  font: 54rpx/72rpx Georgia;
  color: #173c33;
}
.nav-title {
  font-size: 29rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: #173c33;
}
.hero {
  height: 470rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 25rpx;
  box-sizing: border-box;
}
.art-halo {
  position: absolute;
  border-radius: 50%;
  border: 1rpx solid #c9aa653d;
}
.halo-one {
  width: 350rpx;
  height: 350rpx;
  top: 30rpx;
}
.halo-two {
  width: 272rpx;
  height: 272rpx;
  top: 69rpx;
  background: linear-gradient(145deg, #1e5549, #0f332c);
  box-shadow: 0 28rpx 70rpx #0e302733;
}
.massage-art {
  position: absolute;
  width: 330rpx;
  height: 250rpx;
  top: 85rpx;
}
.art-head {
  position: absolute;
  width: 90rpx;
  height: 72rpx;
  border-radius: 52% 48% 46% 54%;
  background: #f8efe0;
  left: 120rpx;
  top: 72rpx;
  transform: rotate(-6deg);
  box-shadow: inset 9rpx 0 #d6b77b;
}
.art-body {
  position: absolute;
  width: 240rpx;
  height: 78rpx;
  border: 7rpx solid #f8efe0;
  border-top: 0;
  border-radius: 0 0 55% 55%;
  left: 44rpx;
  top: 139rpx;
  transform: rotate(-5deg);
}
.art-shoulder {
  position: absolute;
  width: 165rpx;
  height: 60rpx;
  border-top: 8rpx solid #e5cc98;
  border-radius: 50%;
  left: 84rpx;
  top: 135rpx;
  transform: rotate(-4deg);
}
.art-hand {
  position: absolute;
  width: 68rpx;
  height: 44rpx;
  border: 6rpx solid #f8efe0;
  border-radius: 50%;
  top: 38rpx;
}
.hand-left {
  left: 56rpx;
  transform: rotate(26deg);
}
.hand-right {
  right: 54rpx;
  transform: rotate(-26deg);
}
.art-finger {
  height: 5rpx;
  width: 48rpx;
  border-radius: 6rpx;
  background: #f8efe0;
  margin: -10rpx 0 13rpx;
}
.hand-left .art-finger {
  transform: rotate(18deg);
  margin-left: -24rpx;
}
.hand-right .art-finger {
  transform: rotate(-18deg);
  margin-left: 38rpx;
}
.art-wave {
  position: absolute;
  width: 68rpx;
  height: 24rpx;
  border-top: 3rpx solid #c8a65c;
  border-radius: 50%;
  top: 4rpx;
}
.wave-one {
  left: 131rpx;
}
.wave-two {
  left: 151rpx;
  top: 25rpx;
}
.brand {
  font:
    600 36rpx "STSong",
    "Songti SC",
    serif;
  color: #173c33;
  letter-spacing: 12rpx;
  margin-left: 12rpx;
}
.slogan {
  font-size: 19rpx;
  color: #9c7c42;
  letter-spacing: 5rpx;
  margin-top: 10rpx;
}
.login-card {
  position: relative;
  z-index: 1;
  background: #ffffffeb;
  border: 1rpx solid #fff;
  border-radius: 34rpx;
  padding: 36rpx 32rpx 30rpx;
  box-shadow: 0 24rpx 70rpx #21473a14;
  backdrop-filter: blur(16rpx);
}
.login-title,
.login-subtitle {
  display: block;
  text-align: center;
}
.login-title {
  font:
    600 34rpx "STSong",
    "Songti SC",
    serif;
  color: #173c33;
  letter-spacing: 2rpx;
}
.login-subtitle {
  font-size: 19rpx;
  color: #84928d;
  margin-top: 11rpx;
}
.primary-button {
  margin-top: 32rpx;
  border-radius: 48rpx;
  background: linear-gradient(95deg, #214d42, #0f372f);
  color: #fff;
  font-size: 27rpx;
  line-height: 90rpx;
  box-shadow: 0 16rpx 36rpx #163f3330;
  letter-spacing: 2rpx;
}
.primary-button[disabled],
.sms-button[disabled] {
  opacity: 0.66;
}
.quick-tip {
  display: block;
  text-align: center;
  color: #a08b61;
  font-size: 17rpx;
  margin-top: 14rpx;
}
.divider {
  display: flex;
  align-items: center;
  gap: 18rpx;
  color: #a0aaa6;
  font-size: 18rpx;
  margin: 30rpx 0 22rpx;
}
.divider view {
  height: 1rpx;
  background: #e8e1d4;
  flex: 1;
}
.field-shell {
  height: 88rpx;
  border: 1rpx solid #e3e5df;
  background: #fbfcf9;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  box-sizing: border-box;
  transition:
    border-color 0.2s,
    box-shadow 0.2s;
}
.field-shell.is-focused {
  border-color: #b89b5e;
  box-shadow: 0 0 0 5rpx #c4a96818;
}
.field-prefix {
  padding-right: 20rpx;
  border-right: 1rpx solid #e0dfd8;
  color: #173c33;
  font-size: 23rpx;
}
.field-input {
  height: 86rpx;
  flex: 1;
  padding-left: 20rpx;
  color: #173c33;
  font-size: 24rpx;
}
.field-placeholder {
  color: #b4bbb7;
}
.code-shell {
  margin-top: 16rpx;
}
.code-shell .field-input {
  padding-left: 0;
}
.resend-button {
  margin: 0;
  padding: 0 4rpx;
  background: transparent;
  color: #98783c;
  font-size: 20rpx;
  line-height: 62rpx;
  min-width: 128rpx;
}
.resend-button[disabled] {
  color: #a8b1ad;
}
.sms-button {
  margin-top: 18rpx;
  border-radius: 22rpx;
  background: #edf3ef;
  color: #173f35;
  font-size: 24rpx;
  line-height: 82rpx;
  border: 1rpx solid #dce8e1;
}
.error-message {
  display: block;
  margin: 18rpx 4rpx 0;
  color: #a9473f;
  font-size: 20rpx;
  line-height: 1.5;
}
.agreement-row {
  display: flex;
  align-items: flex-start;
  gap: 13rpx;
  margin-top: 26rpx;
}
.agreement-check {
  width: 29rpx;
  height: 29rpx;
  flex: none;
  border: 2rpx solid #b8c1bd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 18rpx;
  margin-top: 2rpx;
  transition: all 0.2s;
}
.agreement-check.checked {
  background: #1c4a3f;
  border-color: #1c4a3f;
}
.agreement-copy {
  font-size: 18rpx;
  color: #949e9a;
  line-height: 1.65;
}
.agreement-copy text {
  display: inline;
}
.agreement-link {
  color: #8f6c2e;
}
.security-note {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  color: #82918b;
  font-size: 18rpx;
  margin-top: 25rpx;
}
.security-icon {
  color: #b18c46;
  font-size: 26rpx;
}
.success-card {
  padding-top: 50rpx;
  padding-bottom: 48rpx;
}
.success-mark {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: #1c4a3f;
  color: #f1d79d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  margin: 0 auto 26rpx;
  box-shadow: 0 15rpx 30rpx #173f3330;
}
.success-card .primary-button {
  margin-top: 36rpx;
}
.step-bar {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: -4rpx 24rpx 22rpx;
}
.step {
  display: flex;
  align-items: center;
  gap: 11rpx;
  color: #96a19d;
}
.step > text {
  width: 39rpx;
  height: 39rpx;
  border-radius: 50%;
  background: #e5e9e6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
}
.step > view text {
  display: block;
  font-size: 17rpx;
}
.step > view text:last-child {
  font-size: 14rpx;
  margin-top: 2rpx;
  color: #adb5b2;
}
.step.active {
  color: #173f35;
}
.step.active > text,
.step.done > text {
  background: #1c4a3f;
  color: #f3d99c;
}
.step.done {
  color: #557169;
}
.step-line {
  width: 78rpx;
  height: 2rpx;
  background: #d9dedb;
  margin: 0 16rpx;
}
.step-line.active {
  background: #7ca797;
}
.stage-kicker {
  display: block;
  text-align: center;
  color: #9b793c;
  font-size: 17rpx;
  letter-spacing: 4rpx;
  margin-bottom: 9rpx;
}
.flow-note {
  display: flex;
  align-items: center;
  gap: 13rpx;
  background: #f6f3e9;
  color: #6f776e;
  border-radius: 17rpx;
  padding: 17rpx 19rpx;
  font-size: 18rpx;
  line-height: 1.5;
  margin-top: 24rpx;
}
.flow-note text:first-child {
  width: 34rpx;
  height: 34rpx;
  flex: none;
  border-radius: 50%;
  background: #b18c46;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.stage-ready {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  color: #1c6b55;
  font-size: 18rpx;
  margin-bottom: 17rpx;
}
.stage-ready text:first-child {
  width: 31rpx;
  height: 31rpx;
  border-radius: 50%;
  background: #dff1e9;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sms-card .field-shell {
  margin-top: 27rpx;
}
.sms-card .code-shell {
  margin-top: 16rpx;
}
.primary-sms {
  background: linear-gradient(95deg, #214d42, #0f372f);
  color: #fff;
  border-color: transparent;
  border-radius: 42rpx;
}
.login-page > .agreement-row {
  position: relative;
  z-index: 1;
  margin: 22rpx 14rpx 0;
  padding: 0 9rpx;
}
