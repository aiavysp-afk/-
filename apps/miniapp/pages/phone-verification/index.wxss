.page{min-height:100vh;background:linear-gradient(155deg,#dffcf1 0,#f7fff9 45%,#fffdf4 100%);padding:env(safe-area-inset-top) 38rpx 60rpx;box-sizing:border-box}.header{height:92rpx;display:flex;align-items:center;justify-content:space-between;font-size:30rpx;font-weight:600}.back,.back-placeholder{width:72rpx}.back{font-size:54rpx;color:#173d34}.visual{height:390rpx;display:flex;align-items:center;justify-content:center}.visual-ring{width:280rpx;height:280rpx;border-radius:50%;background:linear-gradient(145deg,#78edc2,#11bf82);box-shadow:0 30rpx 70rpx #16bd7a2e;position:relative;display:flex;align-items:center;justify-content:center}.visual-ring:before{content:"";position:absolute;inset:25rpx;border:4rpx solid #ffffff7d;border-radius:50%}.phone{font-size:130rpx;color:#fff;font-family:Arial;transform:rotate(0)}.check{position:absolute;right:28rpx;bottom:38rpx;width:62rpx;height:62rpx;border-radius:50%;background:#fff;color:#11b678;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:34rpx}.content{text-align:center}.title{display:block;font-size:42rpx;font-weight:700;color:#142f28}.desc{display:block;margin:24rpx auto 30rpx;max-width:620rpx;color:#62746d;font-size:24rpx;line-height:1.75;text-align:left}.notice{padding:24rpx;background:#fff;border:1rpx solid #dff2e9;border-radius:24rpx;text-align:left;margin-bottom:32rpx}.notice text{display:block;font-size:21rpx;line-height:1.6;color:#71827b}.notice text:first-child{font-size:24rpx;color:#245b4d;font-weight:600;margin-bottom:7rpx}.primary{background:linear-gradient(90deg,#20ca86,#08b87c);color:#fff;border-radius:50rpx;font-size:27rpx;line-height:88rpx;box-shadow:0 18rpx 34rpx #10ba7a30}.error{display:block;margin-top:20rpx;color:#b4443c;font-size:22rpx}.footnote{display:block;color:#97a59f;font-size:20rpx;margin-top:26rpx}.success{display:flex;align-items:center;text-align:left;gap:18rpx;background:#fff;padding:24rpx;border-radius:24rpx;margin-bottom:28rpx}.success-icon{width:60rpx;height:60rpx;border-radius:50%;background:#dff8eb;color:#10b778;display:flex;align-items:center;justify-content:center;font-weight:700}.success view text{display:block;font-size:22rpx;color:#84928d}.success view text:first-child{font-size:27rpx;color:#183b31;font-weight:600;margin-bottom:4rpx}
.divider{display:flex;align-items:center;gap:18rpx;margin:30rpx 8rpx 22rpx;color:#91a19b;font-size:20rpx}.divider view{height:1rpx;background:#d7e9e1;flex:1}.sms-card{padding:26rpx;background:#ffffffd9;border:1rpx solid #dff1e8;border-radius:26rpx;text-align:left}.sms-input{height:82rpx;background:#f4faf7;border-radius:18rpx;padding:0 24rpx;font-size:25rpx;color:#173d34;box-sizing:border-box}.code-row{display:flex;gap:16rpx;margin-top:16rpx}.code-input{flex:1}.code-button{width:210rpx;margin:0;background:#e1f6ec;color:#147353;border-radius:18rpx;font-size:22rpx;line-height:82rpx;padding:0}.code-button[disabled]{color:#93aaa1;background:#eef5f2}.sms-confirm{margin-top:18rpx;background:#173f35;color:#fff;border-radius:18rpx;font-size:25rpx;line-height:82rpx}
