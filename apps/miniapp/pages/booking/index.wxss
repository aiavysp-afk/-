.booking {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.booking text {
  display: block;
  margin-bottom: 20rpx;
}
.title {
  font-size: 44rpx;
  color: #245b4d;
}
.price {
  font-size: 36rpx;
}
.field {
  background: white;
  padding: 28rpx;
  margin: 20rpx 0;
  border-radius: 16rpx;
}
.slots {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.slots button {
  font-size: 24rpx;
  margin: 0;
}
.selected,
.primary {
  background: #245b4d;
  color: white;
}
.preferred-note {
  color: #245b4d;
  background: #e5efeb;
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  font-size: 21rpx;
}
.preferred-note.warning {
  color: #80601f;
  background: #fff3d8;
}
.boundary {
  background: #efe8db;
  padding: 24rpx;
}
.login-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}
.login-card text {
  margin-bottom: 12rpx;
}
.error {
  color: #a3403b;
}
checkbox-group {
  font-size: 26rpx;
  line-height: 1.8;
}
.address-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: -8rpx;
}
.coordinate-ok {
  color: #245b4d;
  background: #e5efeb;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 23rpx;
}
.address-search text {
  font-size: 22rpx;
  color: #66736f;
  margin: 0;
}
.secondary {
  background: #e5efeb;
  color: #245b4d;
  font-size: 26rpx;
  margin: 0;
  flex: 1;
}
.suggestions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.suggestions button {
  background: #fff;
  text-align: left;
  margin: 0;
  padding: 20rpx 24rpx;
  line-height: 1.4;
}
.suggestions button text:first-child {
  font-weight: 600;
  color: #173d33;
}
.suggestions button text {
  font-size: 25rpx;
  color: #66736f;
  margin: 0;
}
