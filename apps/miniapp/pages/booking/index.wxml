<view class="booking"><view wx:if="{{service}}">
  <text class="title serif">{{service.name}}</text><text>{{service.description}}</text><text class="price">¥{{price}} · {{service.durationMinutes}}分钟</text><text wx:for="{{service.steps}}" wx:key="*this">· {{item}}</text><view class="boundary"><text wx:for="{{service.boundaries}}" wx:key="*this">{{item}}</text></view>
  <view class="login-card"><text>{{loggedIn?(phoneVerified?'账号与手机号均已验证，可继续下单':'已登录，请继续完成手机号验证'):'首次预约需要微信授权登录'}}</text><button wx:if="{{!loggedIn}}" class="secondary" bindtap="login" loading="{{loginBusy}}" disabled="{{loginBusy}}">微信授权登录 / 自动注册</button><navigator wx:elif="{{!phoneVerified}}" url="/pages/phone-verification/index">继续验证手机号 ›</navigator><text wx:if="{{loginError}}" class="error">{{loginError}}</text></view>
  <picker mode="date" value="{{date}}" bindchange="dateChanged" disabled="{{!!reservationId}}"><view class="field">预约日期：{{date}} ›</view></picker><view class="slots"><button wx:for="{{slots}}" wx:key="key" class="{{selected===index?'selected':''}}" data-index="{{index}}" bindtap="select" disabled="{{!!reservationId}}">{{item.label}}</button></view><text wx:if="{{!slots.length}}">当天暂无可预约时段，请更换日期</text>
  <input class="field" placeholder="联系人（至少2字）" value="{{contactName}}" data-field="contactName" bindinput="input" disabled="{{orderSubmissionAttempted}}" maxlength="40" /><input class="field" placeholder="下单联系手机号（11位）" type="number" value="{{phone}}" data-field="phone" bindinput="input" disabled="{{orderSubmissionAttempted}}" maxlength="11" /><input class="field" placeholder="搜索或定位后补充楼栋门牌" value="{{detail}}" data-field="detail" bindinput="input" disabled="{{orderSubmissionAttempted}}" maxlength="200" />
  <view wx:if="{{addressSuggestionAvailable}}" class="address-search"><button class="secondary" bindtap="locateAddress" loading="{{locationBusy}}" disabled="{{locationBusy || orderSubmissionAttempted}}">定位当前地址</button><button class="secondary" bindtap="searchAddress" loading="{{suggestionBusy}}" disabled="{{suggestionBusy || orderSubmissionAttempted}}">搜索{{serviceCity}}POI</button></view><text wx:if="{{latitude!==null}}" class="coordinate-ok">已选 GCJ-02 坐标，请人工补充并核对门牌号。</text><text wx:if="{{addressSuggestionAvailable}}">{{addressVerificationRequired?'下单前将按坐标核验郑州服务范围。':'高德地图仅用于辅助填写。'}}</text>
  <view wx:if="{{suggestions.length}}" class="suggestions"><button wx:for="{{suggestions}}" wx:key="id" data-index="{{index}}" bindtap="selectAddress" disabled="{{orderSubmissionAttempted}}"><text>{{item.title}}</text><text>{{item.address}}</text></button></view>
  <checkbox-group bindchange="consentChanged"><label><checkbox value="agree" checked="{{consent}}" />已阅读服务边界，知悉非医疗、正规上门服务；开始前全额退款需复核，开始后请联系客服。</label></checkbox-group>
  <text wx:if="{{quote}}">服务器报价 ¥{{quote}}</text><text class="error">{{error}}</text><button class="primary" bindtap="create" loading="{{busy}}" disabled="{{busy}}">{{reservationId?'使用原幂等键重试下单':'确认预约并创建订单'}}</button><text>创建订单不会自动扣款；请前往订单页核对金额并确认支付。</text><navigator url="/pages/profile/index" open-type="switchTab">需要帮助？前往“我的”联系客服</navigator>
  </view><text wx:else>{{error || '读取服务详情…'}}</text></view>
