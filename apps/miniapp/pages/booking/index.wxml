<view class="booking-page">
  <view wx:if="{{service}}">
    <view class="hero">
      <text class="hero-kicker">ZHONGYUAN CARE</text>
      <text class="hero-title">确认你的上门服务</text>
      <text class="hero-copy">项目、时段和价格都确认无误后再创建订单</text>
      <view class="hero-orbit"><view/><view/></view>
    </view>

    <view class="service-card">
      <view class="service-art"><view class="stone one"/><view class="stone two"/><text>SPA</text></view>
      <view class="service-copy">
        <view class="service-heading"><text>{{service.name}}</text><text>可预约</text></view>
        <text class="service-subtitle">{{service.subtitle}}</text>
        <view class="service-tags"><text wx:if="{{service.badge}}">{{service.badge}}</text><text>{{categoryName}}</text><text>{{service.durationMinutes}}分钟</text></view>
        <view class="service-price"><text>¥</text><text>{{price}}</text><text>/次</text></view>
      </view>
    </view>

    <view class="panel quantity-panel">
      <view><text class="panel-title">服务数量</text><text class="panel-note">当前预约系统每单支持 1 项服务</text></view>
      <view class="stepper"><button bindtap="quantityNotice">−</button><text>{{quantity}}</text><button bindtap="quantityNotice">＋</button></view>
    </view>

    <view class="panel appointment-panel">
      <view class="panel-head"><view><text class="panel-title">上门时间</text><text class="panel-note">仅使用后台真实可预约时段</text></view><text wx:if="{{selectedSlotLabel}}" class="selected-summary">{{date}} {{selectedSlotLabel}}</text></view>
      <view class="mode-tabs">
        <button class="{{appointmentMode==='soon'?'active':''}}" data-mode="soon" bindtap="setAppointmentMode" disabled="{{!!reservationId}}"><text>尽快上门</text><text>选择今日最早可约</text></button>
        <button class="{{appointmentMode==='schedule'?'active':''}}" data-mode="schedule" bindtap="setAppointmentMode" disabled="{{!!reservationId}}"><text>预约时间</text><text>选择未来日期时段</text></button>
      </view>
      <picker wx:if="{{appointmentMode==='schedule'}}" mode="date" value="{{date}}" start="{{minDate}}" end="{{maxDate}}" bindchange="dateChanged" disabled="{{!!reservationId}}"><view class="date-field"><text>预约日期</text><text>{{date}} ›</text></view></picker>
      <text wx:if="{{preferredTherapistId && selected >= 0}}" class="preferred-note">已优先选择该技师的可约时段，你仍可改选</text>
      <text wx:elif="{{preferredTherapistId && slots.length}}" class="preferred-note warning">该技师当日暂无时段，可返回技师页或改选其他可约人员</text>
      <view class="slots"><button wx:for="{{slots}}" wx:key="key" class="{{selected===index?'selected':''}}" data-index="{{index}}" bindtap="select" disabled="{{!!reservationId}}">{{item.label}}</button></view>
      <view wx:if="{{!slots.length}}" class="empty-slot"><text>当前日期暂无可预约时段</text><text>请选择其他日期后再试</text></view>
    </view>

    <view class="panel login-card">
      <view class="panel-head"><view><text class="panel-title">预约账号</text><text class="panel-note">{{loggedIn?(phoneVerified?'微信账号与手机号均已验证':'还需完成手机号验证'):'首次预约会自动注册账号'}}</text></view><text class="account-status {{phoneVerified?'ok':''}}">{{phoneVerified?'已就绪':'待完成'}}</text></view>
      <button wx:if="{{!loggedIn}}" class="secondary wide" bindtap="login" loading="{{loginBusy}}" disabled="{{loginBusy}}">微信授权登录 / 自动注册</button>
      <navigator wx:elif="{{!phoneVerified}}" class="verify-link" url="/pages/phone-verification/index">继续验证手机号 ›</navigator>
      <text wx:if="{{loginError}}" class="error">{{loginError}}</text>
    </view>

    <view class="panel address-panel">
      <view class="panel-head"><view><text class="panel-title">上门地址</text><text class="panel-note">可手动填写，也可用高德自动定位</text></view><text wx:if="{{latitude!==null}}" class="account-status ok">地址已识别</text></view>
      <view class="address-book-head">
        <view><text>我的地址簿</text><text>选择后仍会重新核验服务范围</text></view>
        <text bindtap="openAddressManager">管理地址 ›</text>
      </view>
      <text wx:if="{{addressBookLoading && !addressBookLoaded}}" class="address-book-state">正在读取已保存地址…</text>
      <text wx:if="{{addressBookError}}" class="address-book-state warning">{{addressBookError}}</text>
      <scroll-view wx:if="{{savedAddresses.length}}" class="saved-addresses" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="saved-address-track">
          <button wx:for="{{savedAddresses}}" wx:key="id" class="saved-address {{selectedAddressId===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="chooseSavedAddress" disabled="{{orderSubmissionAttempted}}">
            <view><text>{{item.contactName}}</text><text wx:if="{{item.isDefault}}">默认</text></view>
            <text>{{item.phone}}</text>
            <text>{{item.detail}}</text>
          </button>
        </view>
      </scroll-view>
      <view wx:if="{{addressBookLoaded && !addressBookLoading && !addressBookError && savedAddresses.length===0}}" class="address-book-empty"><text>暂无已保存地址</text><text bindtap="openAddressManager">去新增 ›</text></view>
      <input class="field" placeholder="联系人（至少2字）" value="{{contactName}}" data-field="contactName" bindinput="input" disabled="{{orderSubmissionAttempted}}" maxlength="40" />
      <input class="field" placeholder="下单联系手机号（11位）" type="number" value="{{phone}}" data-field="phone" bindinput="input" disabled="{{orderSubmissionAttempted}}" maxlength="11" />
      <input class="field" placeholder="手动填写小区/道路，或定位后自动带入" value="{{detail}}" data-field="detail" bindinput="input" disabled="{{orderSubmissionAttempted}}" maxlength="140" />
      <input class="field" placeholder="楼栋、单元、门牌号" value="{{doorNumber}}" data-field="doorNumber" bindinput="input" disabled="{{orderSubmissionAttempted}}" maxlength="50" />
      <view wx:if="{{addressSuggestionAvailable}}" class="address-actions"><button bindtap="locateAddress" loading="{{locationBusy}}" disabled="{{locationBusy || orderSubmissionAttempted}}">⌖ 高德定位当前地址</button><button bindtap="searchAddress" loading="{{suggestionBusy}}" disabled="{{suggestionBusy || orderSubmissionAttempted}}">⌕ 搜索{{serviceCity}}地址</button></view>
      <text wx:if="{{latitude!==null}}" class="coordinate-ok">已取得 GCJ-02 坐标，请核对并补充楼栋门牌</text>
      <text class="map-note">{{latitude!==null?'提交前将再次核验服务范围':'手动填写后，提交时会自动用高德识别坐标并核验服务范围'}}</text>
      <view wx:if="{{suggestions.length}}" class="suggestions"><button wx:for="{{suggestions}}" wx:key="id" data-index="{{index}}" bindtap="selectAddress" disabled="{{orderSubmissionAttempted}}"><text>{{item.title}}</text><text>{{item.address}}</text></button></view>
    </view>

    <view class="panel boundary-panel">
      <text class="panel-title">服务说明</text>
      <view class="boundary-list"><text wx:for="{{service.boundaries}}" wx:key="*this">✓ {{item}}</text></view>
      <checkbox-group bindchange="consentChanged"><label><checkbox value="agree" checked="{{consent}}" color="#1f6a55" />已阅读服务边界，知悉本项目为非医疗、正规上门服务；取消与退款按平台规则处理。</label></checkbox-group>
    </view>

    <view class="panel price-panel">
      <view class="panel-head"><view><text class="panel-title">价格明细</text><text class="panel-note">最终金额由服务器核价，不使用前端估算</text></view><text class="quote-badge">{{quoteDetails?'已核价':'待核价'}}</text></view>
      <view class="price-row"><text>服务项目费</text><text>¥{{quoteDetails?quoteDetails.serviceAmount:price}}</text></view>
      <view class="price-row"><text>出行费</text><text class="free-travel">免出行费（¥0.00）</text></view>
      <view class="price-row discount"><text>优惠减免</text><text>{{quoteDetails?'-¥'+quoteDetails.discount:'待优惠模块接入'}}</text></view>
      <view class="price-total"><text>应付合计</text><view><text>¥</text><text>{{quoteDetails?quoteDetails.payable:price}}</text></view></view>
      <text wx:if="{{!quoteDetails}}" class="quote-tip">填写完整预约信息后，先点击下方按钮获取服务器正式报价。</text>
    </view>

    <text class="error" wx:if="{{error}}">{{error}}</text>
    <button wx:if="{{!quoteDetails}}" class="primary action" bindtap="prepareOrder" loading="{{busy}}" disabled="{{busy || !slots.length}}">{{reservationId?'重新获取服务器报价':'核对订单与价格'}}</button>
    <button wx:else class="primary action" bindtap="create" loading="{{busy}}" disabled="{{busy}}">{{orderSubmissionAttempted?'使用原幂等键重试提交':'提交订单并支付 · ¥'+quoteDetails.payable}}</button>
    <text class="payment-note">提交成功后将立即打开微信支付；支付结果只以微信支付通知和服务器原单查询为准。</text>
    <navigator class="help-link" url="/pages/profile/index" open-type="switchTab">需要帮助？前往“我的”联系客服 ›</navigator>
    <view class="safe-bottom" />
  </view>
  <view wx:else class="loading-state"><view class="loading-mark">✦</view><text>{{error || '正在读取服务详情…'}}</text></view>
</view>
