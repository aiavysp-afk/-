<view class="page">
  <view class="header"><view><text>我的订单</text><text>预约、履约与售后记录</text></view><button open-type="contact" show-message-card session-from="orders">在线客服</button></view>
  <view wx:if="{{!loggedIn}}" class="auth-card"><view class="auth-icon">客</view><text>登录后查看你的全部预约</text><text>首次登录会自动注册并验证手机号</text><button bindtap="login">微信授权登录 / 自动注册</button></view>
  <view wx:elif="{{!phoneVerified}}" class="auth-card"><view class="auth-icon">验</view><text>还差一步即可查看订单</text><text>{{error}}</text><button bindtap="verifyPhone">继续验证手机号</button></view>
  <view wx:else>
    <view class="toolbar"><text>全部预约</text><button bindtap="load" disabled="{{loading}}">{{loading?'刷新中…':'刷新'}}</button></view>
    <text wx:if="{{error}}" class="error">{{error}}</text>
    <view wx:for="{{orders}}" wx:key="id" class="order-card">
      <view class="order-head"><view><text>{{item.orderNo}}</text><text>{{item.time}}</text></view><text>{{item.status}}</text></view>
      <view class="order-main"><view class="service-icon">✦</view><view><text class="name">{{item.serviceName}}</text><text>预约金额 ¥{{item.price}}</text></view></view>
      <view class="location-status"><text>{{item.technicianLocationLabel}}</text><button wx:if="{{item.technicianLocationAvailable}}" data-id="{{item.id}}" data-action="technician-location" bindtap="action" disabled="{{!!busy}}">查看位置</button></view>
      <view class="actions" wx:if="{{item.status==='PENDING_PAYMENT'}}"><button class="primary" data-id="{{item.id}}" data-action="pay" bindtap="action" disabled="{{!!busy}}">查看支付渠道并确认</button><button data-id="{{item.id}}" data-action="cancel" bindtap="action" disabled="{{!!busy}}">取消订单</button></view>
      <button wx:if="{{item.confirmAvailable}}" class="primary wide" data-id="{{item.id}}" data-action="confirm-completion" bindtap="action" disabled="{{!!busy}}">确认服务已完成</button>
      <button wx:if="{{item.refundAvailable}}" class="secondary wide" data-id="{{item.id}}" data-action="refund" bindtap="action" disabled="{{!!busy}}">申请开始前全额退款（需复核）</button>
      <button class="safety-action wide" wx:if="{{item.safetyAvailable}}" data-id="{{item.id}}" data-action="safety" bindtap="action" disabled="{{!!busy}}">记录紧急安全事件</button>
      <view wx:for="{{item.safetyIncidents}}" wx:for-item="incident" wx:key="id" class="safety-record"><text>安全事件 · {{incident.statusLabel}}</text><text>分类：{{incident.category}}</text><text>系统记录不等于通知送达；危险请立即报警或呼叫急救</text></view>
      <view wx:for="{{item.refunds}}" wx:for-item="refund" wx:key="id" class="refund"><text>退款记录 · {{refund.id}}</text><text>状态：{{refund.status}}</text><text wx:if="{{refund.status==='REQUESTED'}}">等待另一位授权财务复核，不代表已到账</text><text wx:if="{{refund.status==='UNKNOWN' || refund.status==='ABNORMAL' || refund.status==='CLOSED'}}">渠道结果需财务核实，请勿重复申请</text></view>
    </view>
    <view wx:if="{{showEmptyOrders}}" class="empty"><view>▤</view><text>暂无预约记录</text><text>选一个适合你的正规上门服务</text><navigator url="/pages/services/index" open-type="switchTab">去看看服务</navigator></view>
    <view class="help-note"><text>售后说明</text><text>服务开始后及争议退款请联系人工客服，不能自动套用开始前退款规则。</text><button open-type="contact" show-message-card session-from="orders-footer">联系在线客服</button></view>
  </view>
  <view class="safe-bottom" />
</view>
