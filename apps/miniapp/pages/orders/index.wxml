<view class="order-page"><text class="order-title serif">我的预约</text><text class="error">{{error}}</text><button wx:if="{{!loggedIn}}" bindtap="login">微信登录后查看订单</button><button wx:else bindtap="load" disabled="{{loading}}">刷新订单</button><text wx:if="{{loading}}">读取订单与退款记录…</text>
  <view wx:for="{{orders}}" wx:key="id" class="order-card"><text>{{item.orderNo}}</text><text class="name">{{item.serviceName}}</text><text>{{item.time}} · ¥{{item.price}}</text><text>订单状态：{{item.status}}</text><view wx:if="{{item.status==='PENDING_PAYMENT'}}"><button data-id="{{item.id}}" data-action="pay" bindtap="action" disabled="{{!!busy}}">查看支付渠道并确认</button><button data-id="{{item.id}}" data-action="cancel" bindtap="action" disabled="{{!!busy}}">取消未支付订单</button></view><button wx:if="{{item.confirmAvailable}}" data-id="{{item.id}}" data-action="confirm-completion" bindtap="action" disabled="{{!!busy}}">确认服务已完成</button><button wx:if="{{item.refundAvailable}}" data-id="{{item.id}}" data-action="refund" bindtap="action" disabled="{{!!busy}}">申请开始前全额退款（需人工复核）</button><button class="safety-action" wx:if="{{item.safetyAvailable}}" data-id="{{item.id}}" data-action="safety" bindtap="action" disabled="{{!!busy}}">记录紧急安全事件</button><view wx:for="{{item.safetyIncidents}}" wx:for-item="incident" wx:key="id" class="safety-record"><text>安全事件 · {{incident.statusLabel}}</text><text>分类：{{incident.category}}</text><text>系统记录不等于通知送达；危险请立即报警或呼叫急救</text></view><view wx:for="{{item.refunds}}" wx:for-item="refund" wx:key="id" class="refund"><text>退款 {{refund.id}}</text><text>状态：{{refund.status}}</text><text wx:if="{{refund.status==='REQUESTED'}}">等待另一位授权财务复核，不代表已到账</text><text wx:if="{{refund.status==='UNKNOWN' || refund.status==='ABNORMAL' || refund.status==='CLOSED'}}">渠道结果需财务核实，请勿重复申请</text></view></view>
  <view wx:if="{{showEmptyOrders}}" class="empty"><text>暂无预约记录</text><navigator url="/pages/services/index" open-type="switchTab">去看看服务</navigator></view><text>服务开始后及争议退款请联系客服，不能自动套用开始前退款规则。</text><navigator url="/pages/profile/index" open-type="switchTab">前往“我的”联系客服或拨打商家紧急值班电话</navigator>
</view>
