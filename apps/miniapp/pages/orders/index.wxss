.page {
  min-height: 100vh;
  padding: 0 24rpx 30rpx;
  background: linear-gradient(180deg, #e0fcf1 0, #f4f7f6 540rpx);
  box-sizing: border-box;
}
.header {
  height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.header view text {
  display: block;
}
.header view text:first-child {
  font-size: 34rpx;
  font-weight: 700;
  color: #193b32;
}
.header view text:last-child {
  font-size: 17rpx;
  color: #7b8b85;
  margin-top: 3rpx;
}
.header button {
  margin: 0;
  background: #ffffffb3;
  color: #11865e;
  border-radius: 24rpx;
  font-size: 19rpx;
  line-height: 56rpx;
  padding: 0 18rpx;
}
.auth-card {
  margin-top: 55rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 45rpx 30rpx;
  text-align: center;
  box-shadow: 0 18rpx 50rpx #244a3d12;
}
.auth-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 36rpx;
  background: linear-gradient(145deg, #d9fff0, #9aefd0);
  color: #10875f;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: auto;
  font: 34rpx "STSong";
}
.auth-card > text {
  display: block;
}
.auth-card > text:nth-child(2) {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e3e35;
  margin: 25rpx 0 8rpx;
}
.auth-card > text:nth-child(3) {
  font-size: 19rpx;
  color: #84928d;
}
.auth-card button {
  margin-top: 30rpx;
  background: linear-gradient(90deg, #22cb88, #08b879);
  color: #fff;
  border-radius: 42rpx;
  line-height: 78rpx;
  font-size: 23rpx;
}
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 22rpx 5rpx 15rpx;
}
.toolbar text {
  font-size: 29rpx;
  font-weight: 700;
}
.toolbar button {
  margin: 0;
  background: transparent;
  color: #10aa70;
  font-size: 19rpx;
  line-height: 52rpx;
}
.order-card {
  background: #fff;
  padding: 24rpx;
  border-radius: 28rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 12rpx 32rpx #22443a0c;
}
.order-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-bottom: 17rpx;
  border-bottom: 1rpx solid #eef1ef;
}
.order-head view text {
  display: block;
  font-size: 16rpx;
  color: #929f9a;
}
.order-head view text:first-child {
  font-size: 18rpx;
  color: #4f615b;
  margin-bottom: 4rpx;
}
.order-head > text {
  font-size: 18rpx;
  color: #0eaa70;
  background: #e2fff1;
  border-radius: 18rpx;
  padding: 6rpx 11rpx;
}
.order-main {
  display: flex;
  align-items: center;
  gap: 17rpx;
  padding: 21rpx 0;
}
.service-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 25rpx;
  background: linear-gradient(145deg, #d9fff0, #8ce6c1);
  color: #0bac70;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
}
.order-main view text {
  display: block;
  color: #7d8c87;
  font-size: 18rpx;
}
.name {
  font-size: 28rpx !important;
  color: #203f36 !important;
  font-weight: 700;
  margin-bottom: 6rpx;
}
.location-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #eff8f4;
  border-radius: 18rpx;
  padding: 16rpx 18rpx;
  color: #45665b;
  font-size: 18rpx;
}
.location-status button {
  margin: 0;
  background: #16b979;
  color: #fff;
  font-size: 18rpx;
  line-height: 52rpx;
  border-radius: 25rpx;
  padding: 0 18rpx;
}
.actions {
  display: flex;
  gap: 12rpx;
  margin-top: 17rpx;
}
.actions button {
  flex: 1;
  font-size: 19rpx;
  line-height: 64rpx;
  border-radius: 30rpx;
  background: #f1f4f3;
  color: #5c6d67;
}
.actions .primary,
.primary {
  background: #12bc7b;
  color: #fff;
}
.wide {
  margin-top: 15rpx;
  font-size: 19rpx;
  line-height: 66rpx;
  border-radius: 31rpx;
}
.secondary {
  background: #f1f5f3;
  color: #436158;
}
.safety-action {
  background: #fff0ec;
  color: #9a4339;
  border: 1rpx solid #f0c7be;
}
.safety-record,
.refund {
  padding: 18rpx;
  margin-top: 14rpx;
  border-radius: 17rpx;
  background: #fff3ef;
  color: #6e4038;
}
.refund {
  background: #f3f7f5;
  color: #536760;
}
.safety-record text,
.refund text {
  display: block;
  font-size: 17rpx;
  line-height: 1.6;
}
.safety-record text:first-child,
.refund text:first-child {
  font-size: 20rpx;
  font-weight: 600;
}
.empty {
  height: 65vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.empty view {
  width: 110rpx;
  height: 110rpx;
  border-radius: 39rpx;
  background: #dffff0;
  color: #0eae72;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 39rpx;
}
.empty text {
  font-size: 19rpx;
  color: #889691;
  margin-top: 8rpx;
}
.empty > text:nth-child(2) {
  font-size: 30rpx;
  color: #26463d;
  font-weight: 700;
  margin-top: 23rpx;
}
.empty navigator {
  background: #12bc7b;
  color: #fff;
  border-radius: 38rpx;
  padding: 16rpx 52rpx;
  font-size: 21rpx;
  margin-top: 28rpx;
}
.help-note {
  background: #fff;
  border-radius: 24rpx;
  padding: 22rpx;
  margin-top: 24rpx;
}
.help-note > text {
  display: block;
  color: #7a8984;
  font-size: 18rpx;
  line-height: 1.6;
}
.help-note > text:first-child {
  font-size: 23rpx;
  font-weight: 700;
  color: #294a40;
  margin-bottom: 5rpx;
}
.help-note button {
  margin-top: 15rpx;
  background: #e0fff0;
  color: #0aa86d;
  font-size: 19rpx;
  line-height: 60rpx;
  border-radius: 28rpx;
}
.error {
  display: block;
  color: #aa4a40;
  background: #fff1ed;
  border-radius: 18rpx;
  padding: 16rpx;
  margin-bottom: 15rpx;
}
.review-action {
  background: #e3fff2;
  color: #0a9562;
  border: 1rpx solid #b8efd7;
}
.review-status {
  display: block;
  margin-top: 15rpx;
  padding: 15rpx 18rpx;
  border-radius: 18rpx;
  background: #f7f1df;
  color: #876d34;
  font-size: 18rpx;
  text-align: center;
}
.remove-action {
  background: #f3f5f4;
  color: #56665f;
  border: 1rpx solid #dce3df;
}
.review-mask {
  position: fixed;
  inset: 0;
  background: #0b1d1775;
  z-index: 999;
  display: flex;
  align-items: flex-end;
}
.review-sheet {
  width: 100%;
  background: #fbfaf5;
  border-radius: 34rpx 34rpx 0 0;
  padding: 26rpx 28rpx calc(34rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.review-sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.review-sheet-head view text {
  display: block;
}
.review-sheet-head view text:first-child {
  font-size: 29rpx;
  font-weight: 700;
  color: #1d4037;
}
.review-sheet-head view text:last-child {
  font-size: 17rpx;
  color: #82908b;
  margin-top: 7rpx;
}
.review-sheet-head > text {
  font-size: 42rpx;
  color: #7e8b86;
}
.rating-row {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin: 28rpx 0 20rpx;
}
.rating-row button {
  margin: 0;
  padding: 0;
  background: transparent;
  color: #d8ddd9;
  font-size: 48rpx;
  line-height: 60rpx;
}
.rating-row button.selected {
  color: #d1a244;
}
.review-sheet textarea {
  width: 100%;
  height: 190rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f0f4f2;
  box-sizing: border-box;
  font-size: 20rpx;
  color: #334b43;
}
.submit-review {
  margin-top: 20rpx;
  border-radius: 32rpx;
  line-height: 70rpx;
  font-size: 21rpx;
}
.review-disclosure {
  display: block;
  text-align: center;
  color: #8b9792;
  font-size: 16rpx;
  line-height: 1.5;
  margin-top: 14rpx;
}
