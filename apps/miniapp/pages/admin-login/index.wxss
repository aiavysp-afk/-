.page {
  padding: 42rpx 30rpx;
}
.title {
  display: block;
  font-size: 38rpx;
  color: #1d4b3f;
  margin-bottom: 30rpx;
}
.notice {
  display: block;
  padding: 24rpx;
  background: #fff5df;
  border-radius: 20rpx;
  color: #705d3f;
}
input {
  margin: 28rpx 0;
  padding: 24rpx;
  background: #fff;
  border: 1rpx solid #dfe2dc;
  border-radius: 16rpx;
  font-size: 26rpx;
}
button {
  background: #1d4b3f;
  color: #fff;
  font-size: 26rpx;
  margin: 24rpx 0;
}
text {
  display: block;
  margin: 16rpx 0;
  font-size: 26rpx;
}
.error {
  color: #a64e40;
}
