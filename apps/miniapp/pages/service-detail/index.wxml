<view class="detail-page">
  <view class="sub-nav"><text bindtap="back">‹</text><text>项目详情</text><text/></view>
  <view wx:if="{{error}}" class="state-card"><view class="empty-art">◇</view><text>{{error}}</text><button wx:if="{{slug}}" bindtap="load">重新加载</button></view>
  <view wx:elif="{{service}}">
    <view class="project-hero {{service.artwork}}">
      <view class="hero-copy"><text class="eyebrow">ZHONGYUAN · CARE AT HOME</text><text class="hero-title">{{service.name}}</text><text class="hero-subtitle">{{service.subtitle}}</text><view class="hero-tags"><text>{{service.categoryLabel}}</text><text>非医疗放松</text></view></view>
      <view class="hero-art"><view class="art-orbit"/><view class="art-stone one"/><view class="art-stone two"/><view class="art-leaf"/><text>舒缓时光</text></view>
      <text class="art-note">视觉示意 · 非服务实拍</text>
    </view>
    <view class="project-summary"><view><text class="project-price">¥{{service.price}}</text><text>项目费 / 次</text></view><view><text>{{service.durationMinutes}}分钟</text><text>服务时长</text></view><view><text>¥0.00</text><text>免出行费</text></view></view>
    <view class="tab-bar"><button wx:for="{{tabs}}" wx:key="key" class="{{activeTab===item.key?'active':''}}" data-key="{{item.key}}" bindtap="selectTab">{{item.label}}</button></view>
    <view wx:if="{{activeTab==='INTRO'}}">
      <view class="section"><text class="section-kicker">ABOUT THIS SERVICE</text><text class="section-title">给自己一段放松时光</text><text class="body-copy">{{service.description}}</text><view class="scene-strip"><view><view class="scene-symbol">坐</view><text>久坐之后</text></view><view><view class="scene-symbol">忙</view><text>忙碌之后</text></view><view><view class="scene-symbol">休</view><text>休息时光</text></view></view><text class="muted-copy">日常放松场景示意，不作疾病诊断或效果承诺。</text></view>
      <view class="section"><text class="section-title">服务说明</text><view class="info-table"><view><text>项目</text><text>{{service.name}}</text></view><view><text>时长</text><text>{{service.durationMinutes}}分钟</text></view><view><text>项目价格</text><text>¥{{service.price}} / 次</text></view><view><text>出行费用</text><text>免出行费 · ¥0.00</text></view><view><text>优惠抵扣</text><text>已领取券按项目费门槛核算</text></view><view><text>服务时间</text><text>以预约页真实可选时段为准</text></view></view><text class="muted-copy">这里展示项目价格；优惠后的最终实付在确认订单页实时读取。</text></view>
      <view class="section"><text class="section-title">为什么选择中原到家</text><view class="assurance-grid"><view wx:for="{{assurances}}" wx:key="title"><text class="assurance-mark">{{item.mark}}</text><text>{{item.title}}</text><text>{{item.copy}}</text></view></view></view>
      <view class="section"><text class="section-title">服务边界与禁忌提示</text><view wx:for="{{service.boundaries}}" wx:key="*this" class="boundary-row"><text>✓</text><text>{{item}}</text></view><text class="body-copy">本平台项目属于非医疗保健放松，不替代诊疗。身体不适或对是否适合服务有疑问时，先停止预约并咨询专业人员。</text></view>
    </view>
    <view wx:elif="{{activeTab==='STEPS'}}">
      <view class="section"><text class="section-kicker">SERVICE PROCESS</text><text class="section-title">{{service.name}} · 服务流程</text><text class="muted-copy">以下为管理后台发布的项目步骤；不添加未确认的操作或疗效。</text><view wx:for="{{service.process}}" wx:key="number" class="process-row"><view class="step-number">{{item.number}}</view><view><text>{{item.title}}</text><text>具体范围与力度须在服务前沟通确认</text></view></view><view wx:if="{{!service.process.length}}" class="empty-panel"><view class="empty-art">▤</view><text>项目流程待发布</text><text>请在预约前向平台确认完整服务内容</text></view></view>
      <view class="section"><text class="section-title">用品与卫生 · 服务前先确认</text><view class="hygiene-list"><view><text>01</text><view><text>核对用品配置</text><text>确认项目所需用品及一次性耗材，不使用来源不明的用品。</text></view></view><view><text>02</text><view><text>检查清洁与消毒</text><text>服务前核对用品清洁及铺巾，有疑问可拒绝开始服务并联系平台。</text></view></view><view><text>03</text><view><text>确认入户卫生要求</text><text>提前沟通换鞋、鞋套等要求，以双方确认和公示内容为准。</text></view></view></view><text class="muted-copy">这是服务前检查提示，不代表页面已验证某次服务的实际执行情况。</text></view>
      <view class="section"><text class="section-title">下单前仔细阅读 · 9项预约提醒</text><view wx:for="{{reminders}}" wx:key="*this" class="reminder-row"><text>{{index+1}}</text><text>{{item}}</text></view></view>
    </view>
    <view wx:elif="{{activeTab==='REVIEWS'}}" class="section"><view class="section-head"><text class="section-title">用户评价</text><text>{{reviews.length}}条已公开</text></view><text class="muted-copy">仅展示真实已完成订单、审核通过的公开评价。</text><view wx:if="{{reviewsLoading}}" class="state-copy">正在读取评价…</view><view wx:elif="{{reviewsError}}" class="state-card"><text>{{reviewsError}}</text><button bindtap="load">重试读取</button></view><view wx:elif="{{reviews.length}}" class="review-list"><view wx:for="{{reviews}}" wx:key="id" class="review-row"><view><text>{{item.customerAlias}}</text><text>{{item.dateLabel}}</text></view><text class="review-stars">{{item.stars}}</text><text>{{item.content}}</text></view></view><view wx:else class="empty-panel"><view class="empty-art">☆</view><text>暂无已公开评价</text><text>不生成虚构评价或晒单</text></view></view>
    <view wx:else class="section"><view class="section-head"><text class="section-title">选择服务技师</text><text>{{availabilityLabel}}</text></view><text class="muted-copy">仅展示有公开资料、当前项目真实可约时段的技师；最终时段在预约页确认。</text><view wx:if="{{availabilityLoading}}" class="state-copy">正在核对公开资料与排班…</view><view wx:elif="{{availabilityError}}" class="state-card"><text>{{availabilityError}}</text><button bindtap="load">重试读取</button></view><view wx:elif="{{therapists.length}}"><view wx:for="{{therapists}}" wx:key="id" class="therapist-card"><image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:else class="portrait-empty">人</view><view class="therapist-copy"><text>{{item.alias || '查看公开资料'}}</text><text>{{item.statusLabel}} · 免出行费</text><text>最早 {{item.earliestLabel}}</text></view><button data-id="{{item.id}}" bindtap="openTherapist">查看技师 ›</button></view></view><view wx:else class="empty-panel"><view class="empty-art">▤</view><text>该项目预约时段待开放</text><text>资料审核与真实排班完成后显示，可稍后刷新</text><button bindtap="load">刷新可约时段</button></view></view>
    <view class="compliance-note">仅提供公示范围内的正规非医疗服务；禁止违法违规要求及私下交易。</view>
    <view class="safe-bottom"/>
    <view class="fixed-action"><view><text>项目费 ¥{{service.price}}</text><text>{{availabilityLabel}} · {{service.durationMinutes}}分钟</text></view><button bindtap="chooseTechnician">{{availabilityLoading?'读取技师中':'选择技师'}}</button></view>
  </view>
  <view wx:else class="state-card"><view class="empty-art">◇</view><text>正在读取项目详情…</text></view>
</view>
