.page{min-height:100vh;padding:28rpx 22rpx;background:#f4f7f6;box-sizing:border-box}.security-card{overflow:hidden;border-radius:28rpx;background:#fff;box-shadow:0 9rpx 28rpx rgba(31,72,59,.05)}.security-card>view{display:flex;align-items:center;justify-content:space-between;padding:30rpx 27rpx;border-bottom:1rpx solid #edf0ef;color:#243e36;font-size:23rpx}.security-card>view:last-child{border:0}.security-card>view:first-child>view{display:flex;align-items:center;gap:11rpx}.security-card>view:first-child>view>text:first-child{font-size:24rpx;font-weight:700}.security-card>view:first-child>view>text:last-child{padding:4rpx 11rpx;border-radius:16rpx;background:#e5fff2;color:#0db778;font-size:15rpx}.deletion-row>view text{display:block}.deletion-row>view text:first-child{font-size:23rpx}.deletion-row>view text:last-child{margin-top:8rpx;color:#ef654e;font-size:16rpx}.deletion-row>text{color:#a5afab}.request-card,.risk-card{margin-top:19rpx;padding:25rpx;border-radius:24rpx;background:#fff}.request-card{border-left:7rpx solid #22c486}.request-card text,.risk-card text{display:block}.request-card text:first-child{color:#234238;font-size:21rpx;font-weight:700}.request-card text:nth-child(2){margin-top:8rpx;color:#8f9b97;font-size:16rpx}.request-card text:last-child{margin-top:13rpx;color:#697a74;font-size:17rpx;line-height:1.55}.risk-card{background:#fff8ed;color:#795e32}.risk-card text:first-child{margin-bottom:14rpx;color:#6b4e20;font-size:21rpx;font-weight:700}.risk-card text:not(:first-child){margin-top:8rpx;font-size:17rpx;line-height:1.5}.error{display:block;margin-top:18rpx;padding:17rpx;border-radius:17rpx;background:#fff0ed;color:#bf5344;font-size:17rpx}.delete-action{margin-top:55rpx;border:1rpx solid #f1b7ad;border-radius:44rpx;background:#fff;color:#dc5f4d;font-size:21rpx;line-height:78rpx}.delete-action[disabled]{border-color:#d7dfdc;color:#9da9a5}
