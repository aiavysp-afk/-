.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 24rpx 70rpx;
  background: linear-gradient(180deg, #e4f8ed, #f5f7f4 450rpx);
  color: #244b3d;
  font-size: 30rpx;
}
.hero {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 22rpx 8rpx;
  line-height: 1.65;
}
.title {
  font-size: 40rpx;
  font-weight: 700;
}
.card {
  margin-top: 24rpx;
  padding: 30rpx;
  background: white;
  border: 1rpx solid #dfebe4;
  border-radius: 28rpx;
}
.heading {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}
.label {
  display: block;
  margin: 28rpx 0 14rpx;
  font-weight: 600;
}
.field,
input,
textarea {
  display: block;
  box-sizing: border-box;
  width: 100%;
  padding: 20rpx;
  background: #f2f8f4;
  border-radius: 16rpx;
  line-height: 1.6;
  font-size: 30rpx;
}
input {
  height: 86rpx;
}
textarea {
  height: 220rpx;
}
.help,
.footer {
  display: block;
  margin-top: 18rpx;
  color: #536e60;
  font-size: 28rpx;
  line-height: 1.7;
}
.options {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-top: 24rpx;
}
.option,
.authorization {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  line-height: 1.6;
}
.option checkbox,
.authorization checkbox {
  flex-shrink: 0;
}
.authorization {
  margin-top: 28rpx;
  font-size: 28rpx;
}
.portrait {
  display: block;
  width: 250rpx;
  height: 320rpx;
  border-radius: 20rpx;
  margin: 24rpx auto;
}
.gallery {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}
.gallery image {
  width: 180rpx;
  height: 220rpx;
  border-radius: 16rpx;
}
.document {
  margin-top: 24rpx;
  padding: 22rpx;
  background: #f4f8f5;
  border-radius: 20rpx;
}
.document > text {
  font-weight: 600;
}
.document image {
  display: block;
  width: 100%;
  height: 300rpx;
  margin-top: 20rpx;
}
button {
  margin-top: 24rpx;
  border-radius: 44rpx;
  background: #168764;
  color: white;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 84rpx;
}
button::after {
  border: none;
}
.secondary {
  background: #e7f4ed;
  color: #276b53;
}
button[disabled] {
  background: #d1ded7;
  color: #768d80;
}
.notice {
  padding: 22rpx;
  border-radius: 18rpx;
  line-height: 1.6;
  margin-top: 18rpx;
  background: white;
}
.error {
  background: #fff0ec;
  color: #a03b2e;
}
.success {
  background: #def7e8;
  color: #286b51;
}
.actions {
  display: flex;
  gap: 20rpx;
}
.actions button {
  flex: 1;
  padding: 0 14rpx;
}
.footer {
  padding: 18rpx 8rpx;
}
