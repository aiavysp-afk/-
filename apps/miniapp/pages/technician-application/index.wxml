<view class="page">
  <view class="hero"><text class="title">填写本人入驻资料</text><text>资料提交后由平台审核，审核通过后再次登录即可进入技师工作台。</text></view>
  <view wx:if="{{loading}}" class="notice">正在读取本人资料…</view>
  <view wx:if="{{error}}" class="notice error">{{error}}</view>
  <view wx:if="{{message}}" class="notice success">{{message}}</view>
  <button wx:if="{{error && !application}}" bindtap="load" disabled="{{loading}}">重新读取</button>
  <block wx:if="{{application}}">
    <view wx:if="{{application.rejectionReason}}" class="notice error">退回原因：{{application.rejectionReason}}</view>
    <view class="card"><text class="heading">基本资料</text><text class="label">真实姓名（仅供审核）</text><input data-field="realName" value="{{realName}}" maxlength="40" bindinput="updateField" placeholder="填写本人真实姓名" disabled="{{busy}}"/><text class="label">服务城市</text><text class="field">{{serviceCity}}</text><text class="label">接单区域</text><input data-field="serviceAreas" value="{{serviceAreas}}" maxlength="800" bindinput="updateField" placeholder="如：金水区，中原区" disabled="{{busy}}"/><text class="label">个人简介</text><textarea data-field="bio" value="{{bio}}" maxlength="2000" bindinput="updateField" placeholder="至少10字，介绍真实服务经验与特点" disabled="{{busy}}"/></view>
    <view class="card"><text class="heading">可接单时间段（多选）</text><text class="help">北京时间，实际接单排班由平台审核后安排。</text><checkbox-group bindchange="chooseTimes" class="options"><label wx:for="{{timeSlots}}" wx:key="value" class="option"><checkbox value="{{item.value}}" checked="{{item.checked}}" disabled="{{busy}}" color="#168764"/><text>{{item.label}}</text></label></checkbox-group></view>
    <view class="card"><text class="heading">擅长项目（多选）</text><checkbox-group bindchange="chooseServices" class="options"><label wx:for="{{services}}" wx:key="id" class="option"><checkbox value="{{item.id}}" checked="{{item.checked}}" disabled="{{busy}}" color="#168764"/><text>{{item.name}} · {{item.durationMinutes}}分钟</text></label></checkbox-group><text wx:if="{{!services.length}}" class="help">项目暂未读取，请刷新后再选择。</text></view>
    <checkbox-group bindchange="confirmAuthorization"><label class="authorization"><checkbox value="authorized" checked="{{authorized}}" color="#168764"/><text>确认资料及照片属于本人，同意平台用于入驻审核；形象照审核发布后公开，身份证照片仅限后台审核。</text></label></checkbox-group>
    <view class="card"><text class="heading">形象照</text><image wx:if="{{avatarPreview}}" class="portrait" src="{{avatarPreview}}" mode="aspectFill" data-url="{{avatarPreview}}" bindtap="preview"/><button data-kind="AVATAR" bindtap="upload" loading="{{busy}}" disabled="{{busy}}">{{application.avatarUrl ? '更换形象照' : '拍照或从相册上传形象照'}}</button><view class="gallery"><image wx:for="{{galleryPreviews}}" wx:key="*this" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="preview"/></view><button class="secondary" data-kind="GALLERY" bindtap="upload" disabled="{{busy || galleryPreviews.length >= 12}}">添加个人相册照片</button></view>
    <view class="card"><text class="heading">身份证照片（仅供审核）</text><text class="help">请使用独立证件上传入口，勿上传到公开形象照或相册。</text><view class="document"><text>身份证人像面 · {{application.hasIdFront ? '已上传' : '待上传'}}</text><image wx:if="{{idFrontPreview}}" src="{{idFrontPreview}}" mode="aspectFit" data-url="{{idFrontPreview}}" bindtap="preview"/><button data-kind="ID_FRONT" bindtap="upload" disabled="{{busy}}">{{application.hasIdFront ? '重新上传人像面' : '拍照或选择人像面'}}</button></view><view class="document"><text>身份证国徽面 · {{application.hasIdBack ? '已上传' : '待上传'}}</text><image wx:if="{{idBackPreview}}" src="{{idBackPreview}}" mode="aspectFit" data-url="{{idBackPreview}}" bindtap="preview"/><button data-kind="ID_BACK" bindtap="upload" disabled="{{busy}}">{{application.hasIdBack ? '重新上传国徽面' : '拍照或选择国徽面'}}</button></view></view>
    <view class="actions"><button class="secondary" bindtap="saveDraft" loading="{{busy}}" disabled="{{busy}}">保存填写资料</button><button bindtap="submitReview" loading="{{busy}}" disabled="{{busy || !services.length}}">提交后台审核</button></view>
    <text class="footer">公开称呼及年龄段仍可由后台补录。申请资料、照片和审核状态自动同步后台，待审核期间不开放接单。</text>
  </block>
</view>
