.page{min-height:100vh;padding:29rpx 23rpx;background:#f4f7f6;box-sizing:border-box}.title-block{padding:6rpx 7rpx 22rpx}.title-block text{display:block}.title-block text:first-child{color:#203c33;font-size:31rpx;font-weight:700}.title-block text:last-child{margin-top:7rpx;color:#899892;font-size:17rpx}.empty{display:flex;align-items:center;flex-direction:column;padding-top:150rpx;color:#94a29d;text-align:center}.empty>text{display:block}.empty>text:nth-child(2){margin-top:31rpx;color:#536861;font-size:25rpx;font-weight:600}.empty>text:nth-child(3){margin-top:11rpx;font-size:17rpx}.empty button{margin-top:35rpx;padding:0 38rpx;border-radius:38rpx;background:#16c180;color:#fff;font-size:20rpx;line-height:70rpx}.empty-art{position:relative;width:145rpx;height:105rpx}.empty-art view{position:absolute;top:20rpx;width:85rpx;height:68rpx;border-radius:15rpx;background:#e0ebe7;transform:rotate(-8deg)}.empty-art view:nth-child(2){right:0;background:#edf3f1;transform:rotate(11deg)}.empty-art text{position:absolute;z-index:2;top:35rpx;left:51rpx;display:flex;width:49rpx;height:49rpx;align-items:center;justify-content:center;border-radius:50%;background:#c7dad3;color:#fff;font-size:25rpx}.form-card{padding:29rpx;border-radius:28rpx;background:#fff;box-shadow:0 10rpx 30rpx rgba(31,70,58,.055)}.form-card>text{display:block;margin-bottom:12rpx;color:#344d45;font-size:20rpx;font-weight:600}.form-card textarea{width:100%;height:235rpx;margin-bottom:25rpx;padding:19rpx;border-radius:18rpx;background:#f4f7f6;color:#243c35;font-size:19rpx;box-sizing:border-box}.form-card input{height:76rpx;padding:0 19rpx;border-radius:18rpx;background:#f4f7f6;font-size:19rpx}.form-card .privacy{margin-top:12rpx;color:#99a6a1;font-size:15rpx;font-weight:400}.form-card .error{margin-top:15rpx;padding:12rpx;border-radius:13rpx;background:#fff0ed;color:#c35c4d;font-size:17rpx;font-weight:400}.form-card button{border-radius:39rpx;font-size:20rpx;line-height:74rpx}.submit{margin-top:25rpx;background:#13be7c;color:#fff}.contact{margin-top:14rpx;background:#effaf5;color:#18996d}.about-card,.news-card{display:flex;align-items:center;flex-direction:column;padding:45rpx 29rpx;border-radius:29rpx;background:#fff;text-align:center;box-shadow:0 10rpx 30rpx rgba(31,70,58,.055)}.brand-mark{display:flex;width:95rpx;height:95rpx;align-items:center;justify-content:center;border-radius:30rpx;background:linear-gradient(145deg,#2edb99,#08b573);color:#fff;font:700 39rpx "STSong"}.about-card>text:nth-child(2){margin-top:20rpx;color:#1e4035;font-size:31rpx;font-weight:700}.about-card>text:nth-child(3){margin-top:8rpx;color:#84948e;font-size:18rpx}.about-card>view:nth-child(4){display:flex;gap:14rpx;margin-top:35rpx}.about-card>view:nth-child(4) text{padding:9rpx 16rpx;border-radius:21rpx;background:#e9fff4;color:#16a972;font-size:16rpx}.about-card .disclosure{margin-top:45rpx;padding-top:25rpx;border-top:1rpx solid #edf1ef;color:#8e9b97;font-size:16rpx;line-height:1.7}.news-card{align-items:flex-start;text-align:left}.news-card>text:first-child{color:#213f35;font-size:30rpx;font-weight:700}.news-card>text:nth-child(2){margin-top:28rpx;color:#526760;font-size:21rpx;line-height:1.8}.news-card>view{display:flex;justify-content:space-between;width:100%;margin-top:45rpx;padding-top:20rpx;border-top:1rpx solid #edf1ef;color:#93a09b;font-size:16rpx}
