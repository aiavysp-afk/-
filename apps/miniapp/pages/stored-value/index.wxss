.page{min-height:100vh;padding:32rpx 28rpx 120rpx;background:linear-gradient(180deg,#e9fff5,#f7f9f8 410rpx);box-sizing:border-box}.balance-card{display:flex;align-items:center;justify-content:space-between;min-height:205rpx;padding:33rpx;border-radius:35rpx;background:linear-gradient(115deg,#25c986,#92ebc8);color:#fff;box-shadow:0 19rpx 42rpx rgba(14,169,110,.2);box-sizing:border-box}.balance-card view text{display:block}.balance-card view>text:first-child{font-size:21rpx}.balance{margin:14rpx 0 8rpx;font-size:54rpx;font-weight:700}.balance-card view>text:last-child{color:#e6fff5;font-size:15rpx}.balance-card button{margin:0 -33rpx 0 12rpx;padding:0 31rpx;border:2rpx solid rgba(255,255,255,.78);border-right:0;border-radius:45rpx 0 0 45rpx;background:#0fbd7b;color:#fff;line-height:70rpx;font-size:22rpx}.status-tabs{display:flex;gap:45rpx;margin:42rpx 4rpx 24rpx;color:#50645d;font-size:25rpx}.status-tabs view{position:relative;padding-bottom:15rpx}.status-tabs view.active{color:#13bf7d;font-weight:700}.status-tabs view.active::after{position:absolute;right:25%;bottom:0;left:25%;height:7rpx;border-radius:6rpx;background:#19c584;content:""}.type-tabs{width:100%;white-space:nowrap}.type-tabs-inner{display:inline-flex;gap:15rpx;padding:0 0 18rpx}.type-tabs-inner view{padding:15rpx 27rpx;border-radius:36rpx;background:#edf1ef;color:#61706b;font-size:20rpx}.type-tabs-inner view.active{background:#20c985;color:#fff}.state{display:block;padding:34rpx;text-align:center;color:#899791;font-size:18rpx}.error-card{padding:24rpx;border-radius:22rpx;background:#fff8e9;color:#7b602b;text-align:center}.error-card button{margin-top:17rpx;background:#15bd7c;color:#fff;border-radius:30rpx;line-height:58rpx;font-size:18rpx}.card-list{display:flex;flex-direction:column;gap:17rpx;margin-top:9rpx}.stored-card{display:grid;grid-template-columns:67rpx 1fr auto;align-items:center;gap:15rpx;padding:24rpx;border-radius:25rpx;background:#fff;box-shadow:0 10rpx 28rpx rgba(30,72,58,.07)}.stored-card.disabled{filter:grayscale(.65);opacity:.64}.card-logo{display:flex;width:62rpx;height:62rpx;align-items:center;justify-content:center;border-radius:21rpx;background:linear-gradient(145deg,#2bd695,#0cb776);color:#fff;font:700 27rpx "STSong"}.card-main text,.card-balance text{display:block}.card-main text:first-child{color:#254238;font-size:22rpx;font-weight:700}.card-main text:last-child{margin-top:8rpx;color:#8b9994;font-size:16rpx}.card-balance{text-align:right}.card-balance text:first-child{color:#899791;font-size:15rpx}.card-balance text:last-child{margin-top:5rpx;color:#a06f2e;font-size:23rpx;font-weight:700}.empty{display:flex;align-items:center;flex-direction:column;padding-top:130rpx;color:#9eaca7;text-align:center}.empty>text{display:block}.empty>text:nth-child(2){margin-top:27rpx;color:#6b7d76;font-size:24rpx}.empty>text:last-child{margin-top:10rpx;font-size:17rpx}.empty-card{position:relative;width:150rpx;height:94rpx;border-radius:17rpx;background:#e8efed;box-shadow:17rpx -17rpx 0 #f0f4f3;transform:rotate(-3deg)}.empty-card view{width:94rpx;height:10rpx;margin:22rpx auto 0;border-radius:5rpx;background:#cad8d3}.empty-card view:nth-child(2){width:37rpx;margin-top:13rpx;margin-left:28rpx}.empty-card text{position:absolute;right:-17rpx;bottom:-17rpx;color:#c4d5cf;font-size:37rpx}.ledger-float{position:fixed;right:0;bottom:260rpx;padding:24rpx 15rpx;border-radius:35rpx 0 0 35rpx;background:#fff;color:#53645e;font-size:19rpx;line-height:1.3;text-align:center;box-shadow:0 8rpx 28rpx rgba(34,72,60,.16)}.mask{position:fixed;z-index:20;inset:0;display:flex;align-items:flex-end;background:rgba(14,37,29,.4)}.ledger-sheet{width:100%;height:68vh;padding:29rpx 25rpx calc(24rpx + env(safe-area-inset-bottom));border-radius:36rpx 36rpx 0 0;background:#f7f9f8;box-sizing:border-box}.sheet-head{display:flex;align-items:flex-start;justify-content:space-between;padding:2rpx 5rpx 22rpx}.sheet-head view text{display:block}.sheet-head view text:first-child{font-size:29rpx;font-weight:700;color:#233e35}.sheet-head view text:last-child{margin-top:7rpx;color:#8c9a95;font-size:17rpx}.sheet-head>text{padding:0 8rpx;color:#71817b;font-size:39rpx}.ledger-list{height:calc(68vh - 145rpx)}.ledger-row{display:flex;align-items:center;justify-content:space-between;padding:22rpx 20rpx;margin-bottom:12rpx;border-radius:19rpx;background:#fff}.ledger-row view text{display:block}.ledger-row view text:first-child{font-size:20rpx;color:#2e473f}.ledger-row view text:last-child{margin-top:7rpx;color:#94a09c;font-size:15rpx}.ledger-row>text{color:#293f38;font-size:22rpx;font-weight:700}.ledger-row>text.income{color:#0eb978}.ledger-error,.ledger-empty{display:block;padding:50rpx 20rpx;color:#8b9994;text-align:center;font-size:18rpx}
