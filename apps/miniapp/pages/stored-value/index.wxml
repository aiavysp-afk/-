<view class="page">
  <view class="sub-nav"><text bindtap="back">‹</text><text>储值卡</text><text/></view>
  <view class="balance-card">
    <view><text>储值卡余额（元）</text><text class="balance">{{balanceKnown ? balance : '--'}}</text><text>金额以后台真实账面数据为准</text></view>
    <button bindtap="recharge">立即充值</button>
  </view>

  <view class="status-tabs">
    <view wx:for="{{statusTabs}}" wx:key="key" class="{{activeStatus === item.key ? 'active' : ''}}" data-status="{{item.key}}" bindtap="changeStatus">{{item.label}}</view>
  </view>
  <scroll-view class="type-tabs" scroll-x enhanced show-scrollbar="false">
    <view class="type-tabs-inner"><view wx:for="{{typeTabs}}" wx:key="key" class="{{activeType === item.key ? 'active' : ''}}" data-type="{{item.key}}" bindtap="changeType">{{item.label}}</view></view>
  </scroll-view>

  <text wx:if="{{loading}}" class="state">正在读取真实储值卡…</text>
  <view wx:if="{{error}}" class="error-card"><text>{{error}}</text><button bindtap="load">重新加载</button></view>
  <view class="card-list">
    <view wx:for="{{cards}}" wx:key="id" class="stored-card {{item.status === 'UNAVAILABLE' ? 'disabled' : ''}}">
      <view class="card-logo">中</view>
      <view class="card-main"><text>{{item.name}}</text><text>{{item.typeLabel}} · {{item.expiryLabel}}</text></view>
      <view class="card-balance"><text>余额</text><text>¥{{item.balance}}</text></view>
    </view>
  </view>
  <view wx:if="{{!loading && !error && cards.length === 0}}" class="empty">
    <view class="empty-card"><view/><view/><text>✦</text></view>
    <text>暂无{{activeStatus === 'AVAILABLE' ? '可用' : '不可用'}}储值卡</text>
    <text>不会生成虚拟卡片或虚构余额</text>
  </view>

  <view class="ledger-float" bindtap="openLedger">账单<br/>明细</view>
  <view wx:if="{{ledgerOpen}}" class="mask" bindtap="closeLedger">
    <view class="ledger-sheet" catchtap="keepLedgerOpen">
      <view class="sheet-head"><view><text>账单明细</text><text>仅展示后台真实储值交易</text></view><text bindtap="closeLedger">×</text></view>
      <text wx:if="{{ledgerLoading}}" class="state">账单读取中…</text>
      <text wx:if="{{ledgerError}}" class="ledger-error">{{ledgerError}}</text>
      <scroll-view wx:if="{{ledger.length}}" class="ledger-list" scroll-y enhanced>
        <view wx:for="{{ledger}}" wx:key="id" class="ledger-row"><view><text>{{item.description}}</text><text>{{item.time}} · 余额 ¥{{item.balanceAfter}}</text></view><text class="{{item.changeFen >= 0 ? 'income' : ''}}">{{item.change}}</text></view>
      </scroll-view>
      <view wx:if="{{!ledgerLoading && !ledgerError && ledger.length === 0}}" class="ledger-empty">暂无账单记录</view>
    </view>
  </view>
</view>
