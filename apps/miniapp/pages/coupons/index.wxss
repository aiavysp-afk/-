.page{min-height:100vh;padding:24rpx 22rpx 120rpx;background:#f4f7f6;box-sizing:border-box}.tabs{display:grid;grid-template-columns:repeat(3,1fr);margin-bottom:22rpx;padding:7rpx;border-radius:26rpx;background:#e5f5ef}.tabs view{padding:17rpx 4rpx;border-radius:21rpx;color:#75847f;font-size:19rpx;text-align:center}.tabs view.active{background:#fff;color:#0ab878;font-weight:700;box-shadow:0 7rpx 20rpx rgba(31,91,72,.08)}.state{display:block;padding:32rpx;text-align:center;color:#82918c;font-size:19rpx}.error-card{padding:24rpx;border-radius:22rpx;background:#fff9e9;color:#805f26;font-size:18rpx;text-align:center}.error-card button{margin-top:18rpx;background:#16bd7d;color:#fff;border-radius:30rpx;font-size:18rpx;line-height:60rpx}.coupon-list{display:flex;flex-direction:column;gap:20rpx}.coupon-card{position:relative;display:grid;grid-template-columns:150rpx 1rpx 1fr auto;align-items:center;min-height:190rpx;overflow:hidden;border:2rpx solid #b6edda;border-radius:25rpx;background:linear-gradient(100deg,#effff8,#e2fbf1);box-sizing:border-box;box-shadow:0 10rpx 28rpx rgba(32,102,77,.07)}.coupon-card::before,.coupon-card::after{position:absolute;left:143rpx;width:20rpx;height:20rpx;border:2rpx solid #b6edda;border-radius:50%;background:#f4f7f6;content:"";transform:translateX(-50%)}.coupon-card::before{top:-12rpx}.coupon-card::after{bottom:-12rpx}.coupon-value{padding:20rpx 12rpx;color:#0fc37d;text-align:center}.coupon-value text{display:block}.coupon-value text:first-child{display:inline;font-size:25rpx;font-weight:700}.coupon-value text:nth-child(2){display:inline;font-size:45rpx;font-weight:800}.coupon-value text:last-child{margin-top:8rpx;font-size:17rpx}.dash{height:132rpx;border-left:2rpx dashed #a9dcc9}.coupon-main{padding:22rpx 17rpx;min-width:0}.coupon-main text{display:block}.coupon-title{overflow:hidden;color:#1d493c;font-size:24rpx;font-weight:700;white-space:nowrap;text-overflow:ellipsis}.threshold{margin-top:9rpx;color:#10b977;font-size:20rpx}.validity,.scope{margin-top:7rpx;color:#688178;font-size:15rpx}.coupon-card button{margin:0 18rpx 0 0;padding:0 20rpx;min-width:100rpx;border-radius:33rpx;background:#10c482;color:#fff;font-size:18rpx;line-height:62rpx}.status-label{margin-right:20rpx;color:#96a39f;font-size:18rpx}.coupon-card.disabled{filter:grayscale(.5);opacity:.7}.empty{display:flex;align-items:center;flex-direction:column;padding:170rpx 20rpx 40rpx;color:#97a7a1;text-align:center}.empty>text{display:block}.empty>text:nth-child(2){margin-top:28rpx;color:#5e746c;font-size:24rpx}.empty>text:last-child{margin-top:10rpx;font-size:17rpx}.empty-ticket{position:relative;width:150rpx;height:90rpx;border-radius:17rpx;background:#e5eeeb;transform:rotate(-5deg)}.empty-ticket::before,.empty-ticket::after{position:absolute;top:33rpx;width:23rpx;height:23rpx;border-radius:50%;background:#f4f7f6;content:""}.empty-ticket::before{left:-11rpx}.empty-ticket::after{right:-11rpx}.empty-ticket view{width:68rpx;height:8rpx;margin:22rpx auto 0;border-radius:6rpx;background:#c9d9d3}.history{position:fixed;right:0;bottom:calc(35rpx + env(safe-area-inset-bottom));left:0;color:#9aa7a2;font-size:20rpx;text-align:center}
