.page {
  padding-bottom: 24rpx;
}
.hero {
  height: 690rpx;
  background: linear-gradient(150deg, #173f35, #245b4d);
  color: #fff;
  border-radius: 0 0 54rpx 54rpx;
  position: relative;
  overflow: hidden;
  padding: 100rpx 34rpx 0;
}
.nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  z-index: 2;
}
.brand {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.brand > text {
  width: 66rpx;
  height: 66rpx;
  border: 1rpx solid #d3ba88;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e6d1aa;
  font-family: "STSong";
  font-size: 34rpx;
}
.brand b {
  font-family: "STSong";
  display: block;
  font-size: 31rpx;
  letter-spacing: 5rpx;
}
.brand small {
  display: block;
  font-size: 16rpx;
  color: #a9c2b8;
  letter-spacing: 4rpx;
  margin-top: 5rpx;
}
.brand-name {
  display: block;
  font-family: "STSong";
  font-size: 31rpx;
  letter-spacing: 5rpx;
}
.brand-sub {
  display: block;
  font-size: 16rpx;
  color: #a9c2b8;
  letter-spacing: 4rpx;
  margin-top: 5rpx;
}
.nav button {
  margin: 0;
  background: #ffffff12;
  border: 1rpx solid #ffffff26;
  color: #e8f0ed;
  border-radius: 24rpx;
  font-size: 20rpx;
  line-height: 52rpx;
}
.location {
  width: 340rpx;
  margin-top: 54rpx;
  display: grid;
  grid-template-columns: 34rpx 1fr 20rpx;
  align-items: center;
  position: relative;
  z-index: 2;
}
.location .pin {
  font-size: 30rpx;
  color: #d7bb84;
}
.location small,
.location b {
  display: block;
}
.location-label,
.location-value {
  display: block;
}
.location-label {
  font-size: 18rpx;
  color: #9fbab0;
}
.location-value {
  font-size: 22rpx;
  margin-top: 5rpx;
}
.location small {
  font-size: 18rpx;
  color: #9fbab0;
}
.location b {
  font-size: 22rpx;
  margin-top: 5rpx;
}
.hero-copy {
  margin-top: 46rpx;
  position: relative;
  z-index: 2;
}
.eyebrow {
  display: block;
  font-size: 16rpx;
  letter-spacing: 5rpx;
  color: #cbb27e;
  margin-bottom: 14rpx;
}
.title {
  display: block;
  font-size: 52rpx;
  line-height: 1.35;
  letter-spacing: 5rpx;
}
.desc {
  display: block;
  font-size: 21rpx;
  color: #b9ccc5;
  margin-top: 17rpx;
}
.hero-copy button {
  margin: 38rpx 0 0;
  width: 220rpx;
  background: #d3b574;
  color: #17382f;
  border-radius: 50rpx;
  line-height: 76rpx;
  font-size: 24rpx;
}
.hero-copy button text {
  margin-left: 12rpx;
}
.zen-art {
  position: absolute;
  right: -48rpx;
  bottom: -20rpx;
  width: 330rpx;
  height: 390rpx;
  opacity: 0.95;
}
.sun {
  position: absolute;
  right: 45rpx;
  top: 0;
  width: 170rpx;
  height: 170rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #c4a766, #e1ca94);
  opacity: 0.35;
}
.stone {
  position: absolute;
  border-radius: 50%;
  background: linear-gradient(160deg, #91a59d, #3c685b);
}
.s1 {
  width: 260rpx;
  height: 110rpx;
  right: 0;
  bottom: 25rpx;
  transform: rotate(-7deg);
}
.s2 {
  width: 190rpx;
  height: 90rpx;
  right: 90rpx;
  bottom: 102rpx;
  background: linear-gradient(160deg, #bdc7bf, #5a796e);
}
.leaf {
  position: absolute;
  width: 150rpx;
  height: 55rpx;
  border-radius: 100% 0 100% 0;
  border: 2rpx solid #d1bf91;
  transform: rotate(-35deg);
}
.l1 {
  right: 175rpx;
  top: 80rpx;
}
.l2 {
  right: 105rpx;
  top: 145rpx;
  transform: rotate(-12deg);
}
.dev-note {
  margin: -18rpx 28rpx 22rpx;
  position: relative;
  z-index: 3;
  background: #fff8e9;
  border: 1rpx solid #ead7ad;
  border-radius: 16rpx;
  padding: 16rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-shadow: 0 8rpx 24rpx #18372f0d;
}
.dev-note text {
  font-size: 18rpx;
  background: #b78743;
  color: #fff;
  border-radius: 8rpx;
  padding: 5rpx 10rpx;
}
.dev-note view {
  font-size: 18rpx;
  color: #816c48;
}
.promises {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 12rpx 28rpx 36rpx;
}
.promises view {
  text-align: center;
}
.promises text {
  width: 60rpx;
  height: 60rpx;
  border-radius: 22rpx;
  background: #e3ece7;
  color: #2f6657;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "STSong";
  font-size: 23rpx;
  margin: auto;
}
.promises b,
.promises small {
  display: block;
}
.promises b {
  font-size: 20rpx;
  margin-top: 10rpx;
}
.promises small {
  font-size: 15rpx;
  color: #99a19e;
  margin-top: 3rpx;
}
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 22rpx 32rpx;
}
.section-head view > text {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.section-head small {
  font-size: 18rpx;
  color: #909a96;
}
.section-head navigator {
  font-size: 19rpx;
  color: #37695c;
}
.service-scroll {
  width: 100%;
  white-space: nowrap;
}
.service-row {
  display: flex;
  gap: 20rpx;
  padding: 4rpx 32rpx 25rpx;
}
.service-card {
  width: 390rpx;
  flex: none;
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 28rpx #28483e0e;
}
.service-art {
  height: 220rpx;
  background: linear-gradient(145deg, #dfe9e2, #aebfb5);
  position: relative;
  overflow: hidden;
}
.service-card.tea .service-art {
  background: linear-gradient(145deg, #e8dfcf, #baa57e);
}
.service-card.clay .service-art {
  background: linear-gradient(145deg, #e8ddd8, #c4a89c);
}
.service-art text {
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  background: #ffffffd9;
  color: #43665b;
  font-size: 17rpx;
  border-radius: 20rpx;
  padding: 7rpx 13rpx;
}
.ring {
  position: absolute;
  width: 190rpx;
  height: 190rpx;
  border: 2rpx solid #ffffff55;
  border-radius: 50%;
  right: -22rpx;
  top: 16rpx;
}
.bowl {
  position: absolute;
  width: 170rpx;
  height: 60rpx;
  background: #54756888;
  border-radius: 0 0 100rpx 100rpx;
  right: 75rpx;
  bottom: 35rpx;
  box-shadow: 0 18rpx 35rpx #37564844;
}
.bowl:before {
  content: "";
  position: absolute;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #e6d2a6;
  left: 45rpx;
  top: -50rpx;
  box-shadow:
    -28rpx 10rpx 0 -15rpx #f6ebd4,
    30rpx 13rpx 0 -18rpx #f1e1c1;
}
.service-body {
  padding: 22rpx;
}
.service-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}
.service-sub {
  display: block;
  color: #89938f;
  font-size: 18rpx;
  margin: 7rpx 0 22rpx;
}
.service-meta {
  display: flex;
  justify-content: space-between;
  align-items: end;
}
.service-meta > text {
  font-size: 19rpx;
  color: #6c7974;
}
.service-meta small {
  font-size: 18rpx;
  color: #a87938;
}
.service-meta b {
  font-size: 34rpx;
  color: #9e6d2c;
  margin: 0 3rpx;
}
.therapist-head {
  margin-top: 10rpx;
}
.therapists {
  margin: 0 32rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 0 22rpx;
}
.therapist {
  display: grid;
  grid-template-columns: 92rpx 1fr 20rpx;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eeeee9;
}
.therapist:last-child {
  border: 0;
}
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 26rpx;
  background: #dae7e1;
  color: #2c6253;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "STSong";
  font-size: 27rpx;
  position: relative;
}
.avatar.a1 {
  background: #eee2cc;
  color: #80643e;
}
.avatar.a2 {
  background: #eaded9;
  color: #785c52;
}
.avatar i {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #58a17f;
  border: 4rpx solid #fff;
}
.therapist-info > view:first-child {
  display: flex;
  justify-content: space-between;
}
.therapist-info b {
  font-size: 24rpx;
}
.therapist-info > view > text {
  font-size: 18rpx;
  color: #a97c3f;
}
.therapist-info small {
  font-size: 17rpx;
  color: #919b97;
}
.tags {
  display: flex;
  gap: 8rpx;
  margin-top: 7rpx;
}
.tags text {
  font-size: 15rpx;
  background: #f1f4f1;
  color: #60736c;
  border-radius: 8rpx;
  padding: 4rpx 8rpx;
}
.arrow {
  color: #a3aba8;
}
.boundary {
  margin: 32rpx;
  display: flex;
  gap: 18rpx;
  padding: 24rpx;
  background: #edf2ef;
  border-radius: 22rpx;
}
.seal {
  width: 55rpx;
  height: 55rpx;
  flex: none;
  border: 2rpx solid #3f6e60;
  color: #3f6e60;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "STSong";
}
.boundary b,
.boundary view > text {
  display: block;
}
.boundary b {
  font-size: 21rpx;
}
.boundary view > text {
  font-size: 17rpx;
  color: #75827d;
  line-height: 1.7;
  margin-top: 5rpx;
}

.service-area {
  margin: -18rpx 28rpx 22rpx;
  position: relative;
  z-index: 3;
  background: #fff8e9;
  border: 1rpx solid #ead7ad;
  border-radius: 16rpx;
  padding: 16rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-shadow: 0 8rpx 24rpx #18372f0d;
}
.service-area text {
  font-size: 18rpx;
  background: #b78743;
  color: #fff;
  border-radius: 8rpx;
  padding: 5rpx 10rpx;
}
.service-area view {
  font-size: 18rpx;
  color: #816c48;
}
.promise-name {
  font-size: 20rpx;
  margin-top: 10rpx;
}
.promise-desc,
.section-desc {
  font-size: 15rpx;
  color: #99a19e;
  margin-top: 3rpx;
}
.state-text {
  display: block;
  padding: 20rpx 32rpx;
  color: #75827d;
}
.state-card {
  margin: 0 32rpx 24rpx;
  padding: 22rpx;
  background: #fff;
  border-radius: 20rpx;
  color: #875d52;
}
.state-card button {
  margin-top: 16rpx;
  font-size: 19rpx;
}
.currency,
.unit {
  font-size: 18rpx;
  color: #a87938;
}
.amount {
  font-size: 34rpx;
  color: #9e6d2c;
  margin: 0 3rpx;
}
.team-note {
  margin: 26rpx 32rpx;
  background: #fff;
  border-radius: 26rpx;
  padding: 26rpx;
}
.team-note > text {
  display: block;
  font-size: 28rpx;
  color: #24473e;
}
.team-note view {
  font-size: 18rpx;
  color: #75827d;
  line-height: 1.7;
  margin: 10rpx 0;
}
.team-note navigator {
  font-size: 19rpx;
  color: #37695c;
}
.boundary-title {
  display: block;
  font-size: 21rpx;
  font-weight: 600;
}
