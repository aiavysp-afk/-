.page {
  padding: calc(env(safe-area-inset-top) + 18rpx) 24rpx 30rpx;
  background: linear-gradient(
    180deg,
    #dcfbef 0,
    #effbf6 450rpx,
    #f5f7f7 830rpx
  );
  min-height: 100vh;
  box-sizing: border-box;
}
.topbar {
  height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.brand {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.brand-mark {
  width: 58rpx;
  height: 58rpx;
  border-radius: 19rpx;
  background: #163f35;
  color: #d9ffef;
  display: flex;
  align-items: center;
  justify-content: center;
  font: 28rpx "STSong";
  box-shadow: 0 8rpx 18rpx #1e725329;
}
.brand text {
  display: block;
  font-size: 17rpx;
  color: #6d827a;
  letter-spacing: 2rpx;
}
.brand text:first-child {
  font-size: 28rpx;
  color: #183c32;
  font-weight: 700;
  letter-spacing: 3rpx;
}
.top-support {
  margin: 0;
  padding: 0 16rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  gap: 7rpx;
  background: #ffffffb8;
  color: #245f50;
  border-radius: 25rpx;
  font-size: 19rpx;
  line-height: 62rpx;
}
.top-support text:first-child {
  font-size: 31rpx;
}
.hero {
  height: 470rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #27d395, #0fb979);
  position: relative;
  overflow: hidden;
  color: #fff;
  box-shadow: 0 22rpx 55rpx #19b97a33;
}
.hero:before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 82% 10%, #dffff387, transparent 38%),
    linear-gradient(110deg, #0b614a26, transparent 55%);
}
.hero-content {
  position: relative;
  z-index: 2;
  padding: 32rpx;
}
.location {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  border-radius: 30rpx;
  padding: 10rpx 15rpx;
  background: #ffffff2c;
  font-size: 19rpx;
}
.pin {
  font-size: 25rpx;
}
.hero-kicker {
  display: block;
  font-size: 16rpx;
  letter-spacing: 4rpx;
  color: #dbfff1;
  margin: 32rpx 0 10rpx;
}
.hero-title {
  display: block;
  font-size: 48rpx;
  line-height: 1.25;
  font-weight: 700;
  letter-spacing: 3rpx;
}
.hero-desc {
  display: block;
  font-size: 20rpx;
  color: #ddfff2;
  margin-top: 14rpx;
}
.hero-action {
  width: 190rpx;
  margin: 28rpx 0 0;
  background: #fff;
  color: #10a96f;
  border-radius: 44rpx;
  line-height: 70rpx;
  font-size: 23rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 24rpx #08734a32;
}
.hero-art {
  position: absolute;
  right: -25rpx;
  bottom: -18rpx;
  width: 300rpx;
  height: 330rpx;
}
.halo {
  position: absolute;
  width: 230rpx;
  height: 230rpx;
  border-radius: 50%;
  border: 25rpx solid #c9ffea31;
  right: 0;
  top: 0;
}
.massage-line {
  position: absolute;
  border: 5rpx solid #eafff6b8;
  border-color: #eafff6b8 transparent transparent;
  border-radius: 50%;
  transform: rotate(-10deg);
}
.line-a {
  width: 210rpx;
  height: 90rpx;
  right: 4rpx;
  top: 93rpx;
}
.line-b {
  width: 170rpx;
  height: 70rpx;
  right: 46rpx;
  top: 126rpx;
}
.massage-stone {
  position: absolute;
  border-radius: 52% 48% 42% 58%;
  background: linear-gradient(150deg, #ddfff2, #8aefc6);
  box-shadow: 0 20rpx 35rpx #06704438;
}
.stone-a {
  width: 250rpx;
  height: 100rpx;
  right: 0;
  bottom: 38rpx;
  transform: rotate(-6deg);
}
.stone-b {
  width: 170rpx;
  height: 82rpx;
  right: 85rpx;
  bottom: 112rpx;
}
.leaf {
  position: absolute;
  width: 80rpx;
  height: 30rpx;
  border: 3rpx solid #fff6ae;
  border-radius: 100% 0 100% 0;
}
.leaf-a {
  right: 210rpx;
  top: 60rpx;
  transform: rotate(-35deg);
}
.leaf-b {
  right: 150rpx;
  top: 28rpx;
  transform: rotate(12deg);
}
.quick-grid {
  margin: -20rpx 18rpx 22rpx;
  position: relative;
  z-index: 3;
  background: #fff;
  border-radius: 30rpx;
  padding: 28rpx 14rpx 22rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  box-shadow: 0 16rpx 44rpx #22463b12;
}
.quick-grid navigator,
.quick-grid button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #243b35;
  font-size: 20rpx;
  background: transparent;
  padding: 0;
  margin: 0;
  line-height: 1.2;
}
.quick-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 27rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 13rpx;
}
.mint {
  background: #dbfff0;
  color: #12b97b;
}
.peach {
  background: #fff0df;
  color: #ff8c5a;
}
.lime {
  background: #eaffdc;
  color: #49bc68;
}
.blue {
  background: #e1f3ff;
  color: #35a7ef;
}
.assurance {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  background: #ffffffad;
  border: 1rpx solid #fff;
  border-radius: 24rpx;
  padding: 18rpx 8rpx;
  margin-bottom: 22rpx;
}
.assurance view {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  font-size: 17rpx;
  color: #53655f;
}
.assurance-icon {
  color: #11b878;
  font-weight: 700;
}
.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 22rpx 8rpx 18rpx;
}
.section-title,
.section-desc {
  display: block;
}
.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #183a31;
}
.section-desc {
  font-size: 18rpx;
  color: #87958f;
  margin-top: 5rpx;
}
.section-head navigator {
  color: #0db777;
  font-size: 21rpx;
}
.service-card {
  display: grid;
  grid-template-columns: 190rpx 1fr;
  min-height: 220rpx;
  background: #fff;
  border-radius: 30rpx;
  padding: 18rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 12rpx 34rpx #23443a0d;
  box-sizing: border-box;
}
.service-visual {
  border-radius: 23rpx;
  background: linear-gradient(145deg, #d9fff0, #78dab3);
  position: relative;
  overflow: hidden;
}
.service-visual.tea {
  background: linear-gradient(145deg, #fff1d9, #efbd79);
}
.service-visual.clay {
  background: linear-gradient(145deg, #fbe5e0, #df9f92);
}
.service-visual > text {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  background: #ffffffdc;
  color: #246955;
  border-radius: 17rpx;
  padding: 5rpx 11rpx;
  font-size: 15rpx;
}
.visual-orbit {
  position: absolute;
  width: 130rpx;
  height: 130rpx;
  border: 2rpx solid #ffffff8c;
  border-radius: 50%;
  right: -18rpx;
  top: 35rpx;
}
.visual-stone {
  position: absolute;
  width: 130rpx;
  height: 55rpx;
  border-radius: 50%;
  background: #267a6082;
  right: 28rpx;
  bottom: 25rpx;
  box-shadow: 0 -35rpx 0 -12rpx #effff8;
}
.service-main {
  min-width: 0;
  padding: 8rpx 4rpx 4rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.service-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx;
}
.service-heading text:first-child {
  font-size: 28rpx;
  color: #1c3931;
  font-weight: 700;
}
.service-heading text:last-child {
  font-size: 20rpx;
  font-weight: 600;
  color: #0bb675;
  background: #e4fff3;
  padding: 6rpx 10rpx;
  border-radius: 18rpx;
}
.service-sub {
  display: block;
  color: #5c7267;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.6;
  margin: 8rpx 0;
}
.service-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}
.service-bottom > view > text {
  display: block;
  font-size: 21rpx;
  font-weight: 500;
  color: #5c7267;
}
.service-bottom > view > text:last-child {
  margin-top: 5rpx;
}
.currency,
.unit {
  color: #ff6f48;
  font-size: 18rpx;
}
.amount {
  color: #ff6840;
  font-size: 34rpx;
  font-weight: 700;
  margin: 0 3rpx;
}
.service-bottom button {
  margin: 0;
  background: #13c581;
  color: #fff;
  border-radius: 33rpx;
  font-size: 20rpx;
  line-height: 60rpx;
  padding: 0 25rpx;
}
.state-text {
  display: block;
  padding: 30rpx;
  text-align: center;
  color: #72827c;
}
.state-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 22rpx;
  color: #9f4e43;
}
.state-card button {
  margin-top: 14rpx;
  background: #19bf81;
  color: #fff;
  font-size: 20rpx;
}
.boundary {
  display: flex;
  gap: 18rpx;
  background: #ecf7f2;
  border-radius: 26rpx;
  padding: 24rpx;
  margin-top: 26rpx;
}
.boundary-badge {
  width: 54rpx;
  height: 54rpx;
  flex: none;
  border-radius: 18rpx;
  border: 2rpx solid #21a877;
  color: #18875f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "STSong";
}
.boundary view text {
  display: block;
  color: #71817b;
  font-size: 18rpx;
  line-height: 1.6;
}
.boundary view text:first-child {
  color: #21493e;
  font-size: 23rpx;
  font-weight: 600;
  margin-bottom: 5rpx;
}
.quick-grid .quick-link {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #243b35;
  font-size: 20rpx;
  background: transparent;
  padding: 0;
  margin: 0;
  line-height: 1.2;
}
.section-more {
  color: #0db777;
  font-size: 21rpx;
}
.newcomer-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 18rpx 0 8rpx;
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  background: linear-gradient(120deg, #fff7dd, #e7fff3);
  box-shadow: 0 10rpx 30rpx rgba(42, 91, 75, 0.08);
}
.newcomer-card view text {
  display: block;
}
.newcomer-card view text:first-child {
  color: #8d6420;
  font-size: 25rpx;
  font-weight: 700;
}
.newcomer-card view text:last-child {
  margin-top: 7rpx;
  color: #6f7f79;
  font-size: 18rpx;
}
.newcomer-card > text {
  color: #147d5d;
  font-size: 20rpx;
  font-weight: 600;
}
.service-facts {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin: 10rpx 0;
}
.service-facts text {
  padding: 5rpx 10rpx;
  border-radius: 12rpx;
  background: #eef8f3;
  color: #315d4e;
  font-size: 20rpx;
  font-weight: 600;
}

.city-line,
.city-line > view,
.newcomer-heading,
.newcomer-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.city-line {
  margin: 0 2rpx 24rpx;
  color: #426d5e;
  font-size: 20rpx;
  min-height: 54rpx;
}
.city-line > view {
  justify-content: flex-start;
  max-width: 470rpx;
  gap: 8rpx;
}
.city-line > view > text:last-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.city-pin {
  color: #0bad71;
  font-size: 32rpx;
}
.newcomer-panel {
  border: 2rpx solid #fff;
  padding: 26rpx 22rpx 22rpx;
  border-radius: 32rpx;
  background: linear-gradient(125deg, #0fad74, #13c587 62%, #33dbaa);
  box-shadow: 0 16rpx 38rpx #12a86e22;
  color: #fff;
  animation: home-enter 300ms ease-out;
}
.newcomer-heading {
  align-items: flex-end;
  margin-bottom: 24rpx;
}
.newcomer-heading view text {
  display: block;
}
.newcomer-eyebrow {
  font-size: 14rpx;
  letter-spacing: 2rpx;
  color: #c8fdea;
  margin-bottom: 7rpx;
}
.newcomer-title {
  font-size: 30rpx;
  font-weight: 700;
}
.newcomer-more {
  flex: none;
  color: #e8fff7;
  font-size: 20rpx;
  padding: 8rpx 0 8rpx 8rpx;
}
.coupon-pair {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}
.newcomer-coupon {
  display: flex;
  align-items: center;
  gap: 13rpx;
  min-height: 135rpx;
  padding: 0 14rpx;
  border-radius: 18rpx;
  background: linear-gradient(120deg, #fff, #edfff6);
  color: #128958;
  position: relative;
  box-sizing: border-box;
}
.newcomer-coupon:before,
.newcomer-coupon:after {
  content: "";
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  position: absolute;
  left: -8rpx;
  top: calc(50% - 8rpx);
  background: #11ba7d;
}
.newcomer-coupon:after {
  left: auto;
  right: -8rpx;
  background: #1aca90;
}
.coupon-value {
  flex: none;
  display: flex;
  align-items: baseline;
  border-right: 2rpx dashed #b5e3cf;
  padding-right: 13rpx;
}
.coupon-value text:first-child {
  font-size: 22rpx;
}
.coupon-value text:last-child {
  font-size: 54rpx;
  line-height: 1.2;
  font-weight: 800;
}
.coupon-description {
  min-width: 0;
}
.coupon-description text {
  display: block;
  font-size: 18rpx;
  line-height: 1.6;
}
.coupon-description text:first-child {
  color: #18513d;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 7rpx;
}
.newcomer-footer {
  gap: 12rpx;
  margin-top: 22rpx;
}
.newcomer-footer > view {
  flex: 1;
  min-width: 0;
}
.newcomer-footer > view > text {
  display: block;
  color: #e0fff2;
  font-size: 20rpx;
  line-height: 1.6;
}
.newcomer-footer > view > text:last-child {
  color: #c7fae8;
  font-size: 18rpx;
}
.newcomer-footer button {
  flex: none;
  border-radius: 30rpx;
  color: #079365;
  background: #fff;
  font-weight: 700;
  font-size: 22rpx;
  line-height: 64rpx;
  padding: 0 20rpx;
  margin: 0;
  box-shadow: 0 8rpx 16rpx #07794f25;
}
.newcomer-footer button[disabled] {
  color: #6d9784;
  background: #dcf4e9;
}
.category-tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 30rpx;
  border-radius: 24rpx;
  background: #fff;
  padding: 24rpx 10rpx 0;
}
.category-tab {
  text-align: center;
  color: #7b8b83;
  position: relative;
  padding-bottom: 22rpx;
}
.category-tab text {
  display: block;
  font-size: 18rpx;
  line-height: 1.6;
}
.category-tab text:first-child {
  color: #345146;
  font-size: 28rpx;
  font-weight: 600;
}
.category-tab.active text:first-child {
  color: #079d67;
  font-weight: 700;
}
.category-underline {
  position: absolute;
  bottom: 0;
  left: calc(50% - 26rpx);
  width: 52rpx;
  height: 7rpx;
  border-radius: 9rpx;
  background: transparent;
  transition: background 180ms ease;
}
.category-tab.active .category-underline {
  background: #0dc382;
}
.therapist-section {
  padding-top: 32rpx;
}
.therapist-scroll {
  width: 100%;
}
.therapist-stream {
  display: flex;
  gap: 18rpx;
  padding-bottom: 10rpx;
}
.therapist-card {
  width: 228rpx;
  flex: none;
  background: #fff;
  border-radius: 26rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 18rpx #1e694910;
  transition: transform 160ms ease;
}
.therapist-card:active,
.service-card:active {
  transform: scale(0.985);
}
.therapist-portrait {
  height: 240rpx;
  position: relative;
  overflow: hidden;
  background: linear-gradient(130deg, #e2f6ee, #f6fcf8);
}
.therapist-portrait image {
  display: block;
  width: 100%;
  height: 100%;
}
.therapist-status {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  font-size: 18rpx;
  background: #11b77ee8;
  border-radius: 18rpx;
  padding: 5rpx 12rpx;
  color: #fff;
}
.portrait-placeholder {
  position: relative;
  height: 100%;
  width: 100%;
}
.portrait-head {
  position: absolute;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #c6e9dc;
  top: 48rpx;
  left: calc(50% - 38rpx);
}
.portrait-body {
  position: absolute;
  width: 146rpx;
  height: 118rpx;
  border-radius: 75rpx 75rpx 0 0;
  background: #c6e9dc;
  left: calc(50% - 73rpx);
  bottom: -8rpx;
}
.therapist-copy {
  padding: 18rpx 14rpx 14rpx;
}
.therapist-name,
.therapist-rating,
.therapist-next {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.therapist-name {
  font-weight: 700;
  font-size: 28rpx;
  color: #23473b;
}
.therapist-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  margin: 12rpx 0;
}
.therapist-tags text {
  border-radius: 9rpx;
  background: #e4fbef;
  color: #159568;
  padding: 4rpx 7rpx;
  font-size: 20rpx;
  font-weight: 600;
}
.therapist-tags .express-tag {
  color: #bc7a28;
  background: #fff3df;
}
.therapist-rating {
  color: #687e71;
  font-size: 20rpx;
  margin-bottom: 7rpx;
}
.therapist-next {
  color: #526c5c;
  font-size: 22rpx;
  font-weight: 500;
}
.therapist-action {
  background: #effaf4;
  border-radius: 18rpx;
  padding: 13rpx;
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  color: #098b5e;
  font-size: 20rpx;
}
.empty-state {
  padding: 30rpx 20rpx;
  background: #ffffffb8;
  border: 2rpx solid #fff;
  border-radius: 28rpx;
  text-align: center;
  color: #526e61;
}
.empty-state > text {
  display: block;
  font-size: 25rpx;
  line-height: 1.6;
}
.empty-state > text:last-child {
  font-size: 20rpx;
  color: #7f9689;
  margin-top: 6rpx;
}
.empty-calendar {
  position: relative;
  width: 90rpx;
  height: 77rpx;
  border: 4rpx solid #c3e3d4;
  border-radius: 14rpx;
  margin: 10rpx auto 26rpx;
  background: #eaf7f0;
  box-shadow: 8rpx 8rpx 0 #f1faf5;
}
.empty-calendar view {
  position: absolute;
  width: 6rpx;
  height: 20rpx;
  border-radius: 5rpx;
  left: 22rpx;
  top: -12rpx;
  background: #a3d4be;
}
.empty-calendar view:nth-child(2) {
  left: auto;
  right: 22rpx;
}
.empty-calendar text {
  color: #aacdba;
  font-size: 42rpx;
  line-height: 82rpx;
}
.service-card {
  transition: transform 160ms ease;
}
.service-visual > .visual-caption {
  top: auto;
  bottom: 11rpx;
  left: 14rpx;
  background: transparent;
  padding: 0;
  color: #226647;
  font-size: 12rpx;
  letter-spacing: 1rpx;
}
.visual-leaf {
  position: absolute;
  width: 66rpx;
  height: 29rpx;
  border: 2rpx solid #fff9;
  border-radius: 100% 0 100% 0;
  right: 11rpx;
  top: 76rpx;
  transform: rotate(-18deg);
}
.service-visual.care .visual-stone {
  width: 85rpx;
  height: 90rpx;
  border-radius: 50% 50% 38% 42%;
  right: 53rpx;
  bottom: 37rpx;
  background: #fff9;
  box-shadow: inset -13rpx -10rpx 0 #2f806540;
}
.service-action {
  flex: none;
  color: #fff;
  background: #11be7e;
  padding: 0 18rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 62rpx;
  border-radius: 32rpx;
}
.service-action.muted {
  background: #eaf5ef;
  color: #7b9387;
}
.service-bottom {
  flex-wrap: wrap;
  gap: 12rpx;
}
.schedule-notice {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 12rpx 0;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #fff7e9;
  color: #7b602c;
  font-size: 22rpx;
  line-height: 1.6;
}
.schedule-notice > text:last-child {
  flex: none;
  color: #157e5a;
  font-weight: 600;
}
.empty-state button {
  margin-top: 18rpx;
  color: #137e57;
  font-size: 24rpx;
  border-radius: 24rpx;
  background: #e3faee;
}
.awaiting-schedule .service-heading text:last-child {
  color: #789385;
