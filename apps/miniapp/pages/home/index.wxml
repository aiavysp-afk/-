<view class="page">
  <view class="topbar">
    <view class="brand"><image class="premium-logo" src="/assets/brand/zhongyuan-premium-logo.png" mode="aspectFit" aria-label="中原到家"/><text class="brand-caption">安心上门 · 悦享松弛</text></view>
  </view>
  <view class="city-line" bindtap="chooseAddress"><view><text class="city-pin">⌖</text><text>{{locationLabel}}</text></view><text>{{locationBusy?'定位中':'选择地址 ›'}}</text></view>
  <view wx:if="{{campaign}}" class="campaign-entry" bindtap="showCampaign"><view><text>新人专享好礼</text><text>{{campaign.title}}</text></view><text>查看活动 ›</text></view>

  <view class="newcomer-panel">
    <view class="newcomer-heading"><view><text class="newcomer-eyebrow">NEW MEMBER BENEFITS</text><text class="newcomer-title">新人专享 · 先领券再预约</text></view><text class="newcomer-more" bindtap="openNewcomer">我的券 ›</text></view>
    <view class="coupon-pair">
      <view class="newcomer-coupon"><view class="coupon-value"><text>¥</text><text>40</text></view><view class="coupon-description"><text>新人优惠券</text><text>仅项目费满498元可用</text></view></view>
      <view class="newcomer-coupon"><view class="coupon-value"><text>¥</text><text>30</text></view><view class="coupon-description"><text>新人优惠券</text><text>仅项目费满398元可用</text></view></view>
    </view>
    <view class="newcomer-footer"><view><text>另含20元、10元项目优惠券</text><text>{{newcomerError || newcomerReason}}</text></view><button loading="{{newcomerBusy}}" disabled="{{newcomerBusy || (!newcomerAvailable && !newcomerClaimed && !newcomerError)}}" bindtap="claimNewcomer">{{newcomerClaimed?'已领取 · 去使用':newcomerError?'重试领取':'一键领取'}}</button></view>
  </view>

  <view class="category-tabs">
    <view wx:for="{{categories}}" wx:key="key" class="category-tab {{activeCategory===item.key?'active':''}}" data-key="{{item.key}}" bindtap="selectCategory"><text>{{item.label}}</text><text>{{item.description}}</text><view class="category-underline"/></view>
  </view>

  <view class="section-head"><view><text class="section-title">推荐项目</text><text class="section-desc">选好项目，查看预约时间</text></view><text class="section-more" bindtap="openServices">全部项目 ›</text></view>
  <text wx:if="{{loading}}" class="state-text">正在读取服务目录…</text>
  <view wx:elif="{{error}}" class="state-card"><text>{{error}}</text><button bindtap="retryServices">重新加载</button></view>
  <view wx:elif="{{services.length}}" class="service-list">
    <view wx:for="{{services}}" wx:key="id" class="service-card {{item.bookableCount?'':'awaiting-schedule'}}" data-slug="{{item.slug}}" bindtap="bookService">
      <view class="service-visual {{item.tone}} {{item.artwork}}"><view class="visual-orbit"/><view class="visual-stone"/><view class="visual-leaf"/><text>{{item.badge || item.categoryLabel}}</text><text class="visual-caption">CARE AT HOME</text></view>
      <view class="service-main"><view class="service-heading"><text>{{item.name}}</text><text>{{item.bookingLabel}}</text></view><text class="service-sub">{{item.subtitle}}</text><view class="service-facts"><text>{{item.duration}}</text><text>免出行费</text></view><view class="service-bottom"><view><text>项目费用</text><text><text class="currency">¥</text><text class="amount">{{item.price}}</text><text class="unit">/次</text></text></view><view class="service-action {{item.bookableCount?'':'muted'}}">{{item.bookingAction}}</view></view><button class="project-detail-link" data-slug="{{item.slug}}" catchtap="openServiceDetail">项目介绍与服务流程 ›</button></view>
    </view>
  </view>
  <view wx:else class="empty-state service-empty"><view class="empty-calendar"><view/><view/><text>◇</text></view><text>该分类暂无已上架项目</text><text>可切换其他分类，查看更多正规服务</text></view>

  <view class="quick-grid">
    <view class="quick-link" bindtap="openServices"><view class="quick-icon mint">✦</view><text>选服务</text></view>
    <view class="quick-link" bindtap="openTechnicianIntake"><view class="quick-icon peach">人</view><text>技师入驻</text></view>
    <view class="quick-link" bindtap="openOrders"><view class="quick-icon lime">▤</view><text>查订单</text></view>
    <button wx:if="{{accessReady}}" open-type="contact" show-message-card session-from="home-quick"><view class="quick-icon blue">•••</view><text>在线客服</text></button>
    <button wx:else bindtap="requireAccess"><view class="quick-icon blue">•••</view><text>在线客服</text></button>
  </view>
  <view class="assurance"><view><text class="assurance-icon">✓</text><text>平台核验</text></view><view><text class="assurance-icon">¥</text><text>价格透明</text></view><view><text class="assurance-icon">盾</text><text>服务留痕</text></view><view><text class="assurance-icon">洁</text><text>规范洁净</text></view></view>
  <view class="boundary"><view class="boundary-badge">正</view><view><text>正规服务边界</text><text>仅提供公示的非医疗养生放松服务，不提供疾病诊断、治疗或违法违规服务。</text></view></view>
  <view class="safe-bottom"/>
</view>
  <view wx:if="{{campaignVisible && campaign}}" class="campaign-overlay" catchtouchmove="stopCampaignTap" bindtap="closeCampaign">
    <view class="campaign-card" catchtap="stopCampaignTap">
      <button class="campaign-close" aria-label="关闭活动" bindtap="closeCampaign">×</button>
      <image wx:if="{{campaignImage}}" class="campaign-image" src="{{campaignImage}}" mode="widthFix" binderror="campaignImageFailed"/>
      <view wx:else class="campaign-art"><text>中原到家</text><text class="campaign-art-title">专享好礼</text><text>把放松带回家</text><view class="campaign-orbit"/></view>
      <view class="campaign-copy"><text class="campaign-title">{{campaign.title}}</text><text class="campaign-body">{{campaign.body}}</text><button class="campaign-cta" bindtap="openCampaign">{{campaign.buttonText}}</button><text class="campaign-dismiss" bindtap="closeCampaign">暂不参加，继续浏览</text></view>
    </view>
  </view>
