<view class="page">
  <view class="topbar">
    <view class="brand"><view class="brand-mark">中</view><view><text>中原到家</text><text>正规上门养护服务</text></view></view>
    <button class="top-support" open-type="contact" show-message-card session-from="home-header"><text>◌</text><text>客服</text></button>
  </view>
  <view class="hero">
    <view class="hero-content">
      <view class="location" bindtap="chooseAddress"><text class="pin">⌖</text><text>{{serviceCity}}全域服务</text><text>›</text></view>
      <text class="hero-kicker">CARE · RELAX · HOME</text>
      <text class="hero-title">让专业放松</text><text class="hero-title">如约到家</text>
      <text class="hero-desc">按摩舒缓 · SPA放松 · 足部养护</text>
      <button class="hero-action" bindtap="bookNow">立即预约 <text>›</text></button>
    </view>
    <view class="hero-art"><view class="halo"/><view class="massage-line line-a"/><view class="massage-line line-b"/><view class="massage-stone stone-a"/><view class="massage-stone stone-b"/><view class="leaf leaf-a"/><view class="leaf leaf-b"/></view>
  </view>
  <view class="quick-grid">
    <navigator url="/pages/services/index" open-type="switchTab"><view class="quick-icon mint">✦</view><text>选服务</text></navigator>
    <navigator url="/pages/therapists/index" open-type="switchTab"><view class="quick-icon peach">人</view><text>看审核</text></navigator>
    <navigator url="/pages/orders/index" open-type="switchTab"><view class="quick-icon lime">▤</view><text>查订单</text></navigator>
    <button open-type="contact" show-message-card session-from="home-quick"><view class="quick-icon blue">•••</view><text>在线客服</text></button>
  </view>
  <view class="assurance">
    <view><text class="assurance-icon">✓</text><text>平台核验</text></view><view><text class="assurance-icon">¥</text><text>价格透明</text></view><view><text class="assurance-icon">盾</text><text>服务留痕</text></view><view><text class="assurance-icon">洁</text><text>规范洁净</text></view>
  </view>
  <view class="section-head"><view><text class="section-title">精选服务</text><text class="section-desc">为忙碌生活留一段松弛</text></view><navigator url="/pages/services/index" open-type="switchTab">更多 ›</navigator></view>
  <text wx:if="{{loading}}" class="state-text">正在读取服务目录…</text>
  <view wx:if="{{error}}" class="state-card"><text>{{error}}</text><button bindtap="loadServices">重新加载</button></view>
  <view wx:if="{{services.length}}" class="service-list">
    <view wx:for="{{services}}" wx:key="id" class="service-card" data-slug="{{item.slug}}" bindtap="bookService">
      <view class="service-visual {{item.tone}}"><view class="visual-orbit"/><view class="visual-stone"/><text>{{item.badge || '安心到家'}}</text></view>
      <view class="service-main"><view class="service-heading"><text>{{item.name}}</text><text>可预约</text></view><text class="service-sub">{{item.subtitle}}</text><view class="service-bottom"><view><text>{{item.duration}}</text><text><text class="currency">¥</text><text class="amount">{{item.price}}</text><text class="unit">起</text></text></view><button>去下单</button></view></view>
    </view>
  </view>
  <view class="boundary"><view class="boundary-badge">正</view><view><text>正规服务边界</text><text>仅提供公示的非医疗养生放松服务，拒绝任何违法违规要求。</text></view></view>
  <view class="safe-bottom" />
</view>
