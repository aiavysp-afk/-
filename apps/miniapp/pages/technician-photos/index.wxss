.photo-page{min-height:100vh;padding:0 28rpx 60rpx;background:linear-gradient(180deg,#dffbf0,#f4f6f7 420rpx);color:#193d33;font-size:30rpx}.nav{padding-top:env(safe-area-inset-top);height:110rpx;display:flex;align-items:center;justify-content:space-between;font-weight:650}.nav>text:first-child{font-size:54rpx;width:60rpx}.nav>view{width:60rpx}.intro{padding:22rpx 4rpx;display:flex;flex-direction:column;gap:16rpx}.intro>text:first-child{font-size:38rpx;font-weight:700}.intro>text:last-child,.privacy{line-height:1.7;color:#647870}.card{padding:30rpx;background:#fff;border-radius:30rpx;margin:20rpx 0}.heading{display:flex;justify-content:space-between;font-weight:650}.heading>text:last-child{color:#00ad7c;font-size:28rpx}.avatar{display:block;width:200rpx;height:240rpx;border-radius:24rpx;margin:26rpx auto}.gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin:24rpx 0}.gallery image{width:190rpx;height:240rpx;border-radius:16rpx}.empty{margin:36rpx 0;text-align:center;color:#88948e}button{margin-top:24rpx;color:white;background:#08ba87;border-radius:48rpx;font-size:30rpx;font-weight:600}button::after{border:none}button[disabled]{background:#b2c7be;color:#fff}.authorization{display:flex;gap:12rpx;line-height:1.65;margin-top:28rpx}.authorization checkbox{flex-shrink:0}.privacy{font-size:28rpx;margin-top:26rpx}.notice{padding:22rpx;border-radius:20rpx;margin:18rpx 0;line-height:1.6;background:#fff}.error{color:#a23a39;background:#fff0ee}.success{background:#e3fbf0}
.review-help{display:block;margin-top:20rpx;color:#647870;font-size:28rpx;line-height:1.6}.review-form textarea,.review-form input{box-sizing:border-box;width:100%;padding:20rpx;background:#f2f8f5;border-radius:18rpx;margin-top:20rpx;font-size:30rpx}.review-form textarea{height:200rpx}.review-form input{height:90rpx}
