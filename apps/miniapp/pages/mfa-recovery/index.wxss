.page {
  padding: 42rpx 30rpx;
}
.title {
  display: block;
  font-size: 38rpx;
  color: #1d4b3f;
  margin-bottom: 26rpx;
}
.notice {
  display: block;
  padding: 24rpx;
  background: #fff5df;
  border-radius: 20rpx;
  color: #705d3f;
  line-height: 1.7;
}
.card {
  margin-top: 28rpx;
  padding: 24rpx;
  background: #fff;
  border: 1rpx solid #dfe2dc;
  border-radius: 20rpx;
}
.subtitle {
  display: block;
  font-weight: 600;
  color: #1d4b3f;
  margin-bottom: 18rpx;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #edf0ec;
}
.request {
  padding: 20rpx 0;
  border-top: 1rpx solid #edf0ec;
}
text {
  display: block;
  font-size: 26rpx;
  margin: 8rpx 0;
}
button {
  background: #1d4b3f;
  color: #fff;
  font-size: 25rpx;
  margin: 22rpx 0;
}
.muted {
  color: #77837e;
  font-size: 23rpx;
}
.error {
  color: #a64e40;
}
