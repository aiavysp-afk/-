.page{min-height:100vh;padding:42rpx 24rpx 80rpx;box-sizing:border-box;background:linear-gradient(180deg,#e5f8ef 0,#f6f7f4 42%);color:#244b3d;font-size:28rpx}.hero{display:flex;flex-direction:column;padding:24rpx 12rpx 38rpx;gap:18rpx}.eyebrow{color:#497b65;font-size:24rpx;letter-spacing:3rpx}.title{color:#183f34;font-size:42rpx;font-weight:700}.subtitle{font-size:28rpx;font-weight:500;line-height:1.7}.card{padding:34rpx 28rpx;border:1rpx solid #dce9e3;border-radius:30rpx;background:#fff;box-shadow:0 18rpx 45rpx rgba(36,91,77,.08)}.card-title{display:block;font-size:32rpx;font-weight:700}.card button{margin-top:26rpx;border-radius:42rpx;background:linear-gradient(135deg,#2a6c58,#1f8a67);color:#fff;font-size:29rpx;line-height:82rpx}.card button.secondary{background:#edf6f2;color:#2a6655}.error{display:block;margin-top:20rpx;color:#a33a29;font-size:28rpx;line-height:1.6}.success-card{text-align:center}.success-icon{display:flex;width:82rpx;height:82rpx;align-items:center;justify-content:center;margin:0 auto 18rpx;border-radius:50%;background:#dff7ea;color:#1c8b64;font-size:42rpx}.success-card>text{display:block}.note{margin-top:22rpx;color:#516a5e;font-size:28rpx;line-height:1.75;text-align:left}.rules{display:flex;flex-direction:column;gap:18rpx;margin-top:24rpx;padding:28rpx;border-radius:26rpx;background:rgba(255,255,255,.75);color:#536e60;font-size:27rpx;line-height:1.7}.rules text:first-child{color:#345d50;font-size:30rpx;font-weight:700}
.login-card{text-align:center}.wechat-mark{display:flex;align-items:center;justify-content:center;width:104rpx;height:104rpx;margin:0 auto 24rpx;border-radius:30rpx;background:#e5f8ed;color:#24754f;font-size:52rpx;font-weight:700}.login-card .note{margin-top:22rpx}.login-card .wechat-login{margin-top:34rpx;font-weight:700}.agreement-row{display:flex;gap:16rpx;margin-top:28rpx;text-align:left;align-items:flex-start}.agreement-check{width:38rpx;height:38rpx;flex-shrink:0;box-sizing:border-box;border:2rpx solid #a9bcb1;border-radius:50%;margin-top:5rpx;background:#fff;display:flex;align-items:center;justify-content:center;color:#fff;font-size:25rpx}.agreement-check.checked{background:#266b50;border-color:#266b50}.agreement-copy{font-size:25rpx;color:#597064;line-height:1.8}.agreement-link{color:#23694f;font-weight:600}.privacy-note{display:block;margin-top:26rpx;color:#61776a;font-size:24rpx;line-height:1.75;text-align:left}.share-entry{margin-top:24rpx;padding:14rpx;border-radius:34rpx;background:#e7f2eb;color:#2b6650;font-size:27rpx;line-height:1.6}
