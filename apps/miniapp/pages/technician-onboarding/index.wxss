.page{min-height:100vh;padding:42rpx 24rpx 80rpx;box-sizing:border-box;background:linear-gradient(180deg,#e5f8ef 0,#f6f7f4 42%)}.hero{display:flex;flex-direction:column;padding:24rpx 12rpx 38rpx}.eyebrow{color:#4f8d78;font-size:17rpx;letter-spacing:5rpx}.title{margin-top:14rpx;color:#183f34;font:700 45rpx "STSong"}.subtitle{margin-top:14rpx;color:#688078;font-size:20rpx;line-height:1.7}.card{padding:34rpx 28rpx;border:1rpx solid #dce9e3;border-radius:30rpx;background:#fff;box-shadow:0 18rpx 45rpx rgba(36,91,77,.08)}.card-title{display:block;color:#23483d;font-size:28rpx;font-weight:700}.card input{height:86rpx;margin-top:28rpx;padding:0 24rpx;border:1rpx solid #cfe0d8;border-radius:20rpx;background:#f8fbf9;color:#1f4539;font-size:27rpx;letter-spacing:5rpx}.card button{margin-top:26rpx;border-radius:42rpx;background:linear-gradient(135deg,#2a6c58,#1f8a67);color:#fff;font-size:23rpx;line-height:82rpx}.card button.secondary{background:#edf6f2;color:#2a6655;line-height:72rpx}.error{display:block;margin-top:20rpx;color:#b85745;font-size:20rpx;line-height:1.6}.success-card{text-align:center}.success-icon{display:flex;width:82rpx;height:82rpx;align-items:center;justify-content:center;margin:0 auto 18rpx;border-radius:50%;background:#dff7ea;color:#1c8b64;font-size:42rpx}.success-card>text{display:block}.success-card>.card-title{font-size:31rpx}.success-card>.card-title+text{margin-top:12rpx;color:#3d6659;font-size:22rpx}.note{margin-top:22rpx;color:#71827c;font-size:19rpx;line-height:1.75;text-align:left}.rules{display:flex;flex-direction:column;gap:13rpx;margin-top:24rpx;padding:28rpx;border-radius:26rpx;background:rgba(255,255,255,.75);color:#74847e;font-size:18rpx;line-height:1.5}.rules text:first-child{color:#345d50;font-size:22rpx;font-weight:700}.rules .text-action{margin-top:12rpx;border:1rpx solid #d6e5de;border-radius:34rpx;background:#fff;color:#2f6756;font-size:19rpx;line-height:64rpx}
