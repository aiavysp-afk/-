.detail-page { min-height: 100vh; padding: env(safe-area-inset-top) 24rpx 65rpx; box-sizing: border-box; background: linear-gradient(160deg, #e2fff2, #f3f6f5 600rpx); color: #193d34; }
.nav { height: 86rpx; display: flex; align-items: center; justify-content: space-between; font-size: 32rpx; font-weight: 650; }
.nav > text:first-child, .nav > view { width: 70rpx; }
.nav > text:first-child { font: 54rpx Georgia; }
.own-photo-entry { margin: 18rpx 0 24rpx; border-radius: 42rpx; background: #e5fcf0; color: #007b59; font-size: 30rpx; font-weight: 600; }
.own-photo-entry::after { border: 1rpx solid #b8ebd6; border-radius: 42rpx; }
.green-banner { display: flex; flex-direction: column; gap: 8rpx; padding: 24rpx 30rpx; border-radius: 30rpx 30rpx 0 0; background: linear-gradient(115deg, #0bbf82, #45d4ac); color: #fff; }
.green-banner > text:first-child { font-size: 32rpx; font-weight: 700; }
.green-banner > text:last-child { font-size: 25rpx; font-weight: 500; }
.profile-hero { display: flex; gap: 24rpx; align-items: center; padding: 30rpx; background: #fff; }
.portrait { width: 150rpx; height: 190rpx; border-radius: 25rpx; background: linear-gradient(155deg, #dbf4e9, #f0faf5); position: relative; overflow: hidden; flex: none; }
.portrait > image { width: 100%; height: 100%; }
.portrait .head { position: absolute; width: 62rpx; height: 72rpx; border-radius: 50%; background: #c7e1d4; left: 44rpx; top: 34rpx; }
.portrait .head:before { content: ""; position: absolute; width: 68rpx; height: 38rpx; background: #5d9980; border-radius: 50% 55% 24% 24%; left: -3rpx; top: -8rpx; }
.portrait .body { position: absolute; width: 110rpx; height: 94rpx; border-radius: 52rpx 52rpx 16rpx 16rpx; background: #5d9980; left: 20rpx; top: 104rpx; }
.profile-copy { min-width: 0; }
.profile-copy > view:first-child { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; }
.name { font-size: 34rpx; font-weight: 700; overflow-wrap: anywhere; }
.status { position: static; width: auto; height: auto; right: auto; bottom: auto; border: 0; display: inline-block; font-size: 25rpx; font-weight: 600; border-radius: 18rpx; padding: 6rpx 12rpx; }
.status.online { background: #dff8ec; color: #087953; }
.status.scheduled { background: #edf3f0; color: #456b5a; }
.tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; }
.tags text { font-size: 25rpx; font-weight: 500; border: 1rpx solid #bfe7d6; color: #187859; border-radius: 14rpx; padding: 4rpx 9rpx; }
.earliest { display: block; color: #356650; font-size: 26rpx; font-weight: 600; margin-top: 14rpx; line-height: 1.6; }
.service-guarantees { display: flex; flex-wrap: wrap; gap: 16rpx; background: #f0fff7; padding: 18rpx 24rpx; border-radius: 0 0 30rpx 30rpx; color: #067751; font-size: 25rpx; font-weight: 550; }
.summary { background: #fff; border-radius: 26rpx; display: grid; grid-template-columns: repeat(3, 1fr); padding: 25rpx 8rpx; margin-top: 18rpx; }
.summary view { text-align: center; border-right: 1rpx solid #e6efe9; padding: 0 5rpx; }
.summary view:last-child { border: 0; }
.summary text { display: block; }
.summary text:first-child { font-size: 28rpx; font-weight: 700; color: #21443a; }
.summary text:last-child { font-size: 25rpx; color: #657a6f; margin-top: 7rpx; }
.section { background: #fff; border-radius: 28rpx; padding: 27rpx; margin-top: 18rpx; }
.section-title { font-size: 32rpx; font-weight: 700; color: #1d4037; }
.section-body { display: block; color: #506b5e; font-size: 27rpx; font-weight: 500; line-height: 1.8; margin-top: 15rpx; overflow-wrap: anywhere; }
.section-head { display: flex; flex-wrap: wrap; gap: 10rpx; align-items: center; justify-content: space-between; }
.section-head > text:last-child { font-size: 25rpx; font-weight: 500; color: #657a6f; }
.empty-panel { min-height: 250rpx; padding: 24rpx 14rpx; box-sizing: border-box; border-radius: 22rpx; background: linear-gradient(145deg, #f2faf6, #edf7f1); display: flex; flex-direction: column; align-items: center; justify-content: center; margin-top: 18rpx; color: #657a6f; gap: 12rpx; text-align: center; }
.empty-panel > text { font-size: 27rpx; font-weight: 600; color: #365b49; line-height: 1.6; }
.empty-panel > text:last-child { font-size: 25rpx; font-weight: 500; color: #657a6f; }
.empty-art { width: 120rpx; height: 90rpx; position: relative; margin: 4rpx 0 12rpx; }
.empty-art:before { content: ""; width: 120rpx; height: 28rpx; border-radius: 50%; background: #dceee4; position: absolute; bottom: -9rpx; left: 0; }
.empty-art > view:first-child { position: absolute; width: 88rpx; height: 68rpx; border-radius: 15rpx; top: 2rpx; left: 16rpx; background: #fff; border: 5rpx solid #b2dac5; box-sizing: border-box; }
.empty-art > view:last-child { position: absolute; width: 44rpx; height: 5rpx; border-radius: 5rpx; left: 38rpx; top: 24rpx; background: #84c6a7; box-shadow: 0 14rpx #c5e6d5, 0 28rpx #c5e6d5; }
.comment-art > view:first-child { border-radius: 24rpx 24rpx 24rpx 5rpx; }
.photo-art > view:last-child { width: 18rpx; height: 18rpx; border-radius: 50%; top: 16rpx; left: 64rpx; box-shadow: -24rpx 20rpx 0 7rpx #c5e6d5; }
.calendar-art > view:first-child { border-top-width: 15rpx; }
.calendar-art > view:last-child { top: 31rpx; }
.certificate { display: flex; align-items: center; gap: 18rpx; margin-top: 19rpx; padding: 19rpx; background: #f0faf5; border: 1rpx solid #cfe8da; border-radius: 20rpx; }
.certificate > view:first-child { width: 60rpx; height: 60rpx; flex: none; border-radius: 19rpx; background: #d7f0e2; color: #19734f; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 600; }
.certificate > view:last-child text { display: block; font-size: 26rpx; line-height: 1.6; }
.certificate > view:last-child text:first-child { color: #365b49; font-weight: 600; }
.certificate > view:last-child text:last-child { color: #657a6f; margin-top: 5rpx; }
.gallery-row { display: flex; gap: 14rpx; margin-top: 18rpx; }
.gallery-row image { width: 260rpx; height: 330rpx; border-radius: 22rpx; flex: none; background: #edf5f0; }
.qualification-list { display: flex; flex-direction: column; gap: 12rpx; margin-top: 18rpx; }
.qualification-list view { display: flex; align-items: center; gap: 14rpx; padding: 16rpx 18rpx; border-radius: 18rpx; background: #f0faf5; color: #365b49; font-size: 27rpx; font-weight: 550; }
.qualification-list view text:first-child { width: 44rpx; height: 44rpx; flex: none; border-radius: 14rpx; display: flex; align-items: center; justify-content: center; background: #d7f0e2; color: #19734f; }
.project-tabs { display: flex; position: sticky; top: 0; z-index: 2; gap: 3rpx; background: #fff; border-radius: 24rpx; margin-top: 22rpx; padding: 6rpx 5rpx; box-shadow: 0 8rpx 22rpx #204b3710; }
.project-tabs .tab { flex: 1; min-width: 0; margin: 0; padding: 13rpx 2rpx 18rpx; line-height: 1.6; background: transparent; color: #587164; border-radius: 20rpx; font-size: 27rpx; font-weight: 600; position: relative; }
.tab::after, .project-actions button::after, .project-empty button::after { border: 0; }
.project-tabs .active { color: #00865a; background: #f0fff7; font-weight: 700; }
.project-tabs .active::before { content: ""; width: 42rpx; height: 5rpx; border-radius: 5rpx; background: #0bbf82; position: absolute; bottom: 6rpx; left: 50%; transform: translateX(-50%); }
.selected-note { margin-top: 18rpx; padding: 15rpx 17rpx; border-radius: 16rpx; background: #effbf5; color: #227654; font-size: 25rpx; font-weight: 550; line-height: 1.6; }
.project-card { padding: 25rpx 0; border-bottom: 1rpx solid #e6efe9; }
.project-card:last-child { border-bottom: 0; padding-bottom: 0; }
.project-main { display: flex; gap: 18rpx; align-items: flex-start; }
.project-illustration { width: 154rpx; height: 172rpx; flex: none; border-radius: 21rpx; position: relative; overflow: hidden; background: linear-gradient(150deg, #d3fae8, #a3e2c9); }
.project-illustration.category-SPA_RELAXATION { background: linear-gradient(150deg, #c6f2e2, #78ccb0); }
.project-illustration.category-FOOT_CARE { background: linear-gradient(150deg, #e1f7de, #aedcb4); }
.illustration-orbit { position: absolute; width: 112rpx; height: 112rpx; border: 2rpx solid #ffffffad; border-radius: 50%; top: 19rpx; left: 38rpx; }
.illustration-leaf { position: absolute; width: 100rpx; height: 30rpx; border-radius: 50%; background: #f2fff9; top: 62rpx; left: 27rpx; transform: rotate(-10deg); box-shadow: 0 14rpx 0 #b6efd6; }
.illustration-base { position: absolute; width: 112rpx; height: 46rpx; border-radius: 50%; background: #409d7c; opacity: .55; top: 93rpx; left: 19rpx; }
.project-illustration > text { position: absolute; bottom: 10rpx; left: 0; width: 100%; text-align: center; color: #2a6950; font-size: 22rpx; font-weight: 550; }
.project-copy { min-width: 0; flex: 1; }
.project-name { display: block; color: #193d34; font-size: 32rpx; font-weight: 700; line-height: 1.5; overflow-wrap: anywhere; }
.project-subtitle { display: block; color: #4f6f5e; font-size: 27rpx; font-weight: 550; line-height: 1.6; margin-top: 5rpx; overflow-wrap: anywhere; }
.project-meta { display: flex; flex-wrap: wrap; gap: 13rpx; color: #34795a; font-size: 26rpx; font-weight: 600; margin-top: 10rpx; }
.project-price { display: block; color: #078858; font-size: 35rpx; font-weight: 700; margin-top: 10rpx; }
.project-actions { display: flex; gap: 16rpx; align-items: center; justify-content: space-between; margin-top: 18rpx; }
.project-actions button { margin: 0; font-size: 27rpx; font-weight: 650; line-height: 64rpx; border-radius: 32rpx; }
.project-actions .details-button { color: #087751; background: #effbf5; padding: 0 17rpx; }
.project-actions .book-button { color: #fff; background: #0abf82; padding: 0 34rpx; min-width: 174rpx; }
.slot-row { display: flex; gap: 10rpx; margin-top: 18rpx; }
.slot-row text { white-space: nowrap; padding: 11rpx 17rpx; border-radius: 18rpx; background: #edf8f1; color: #285e45; font-size: 25rpx; font-weight: 550; }
.project-empty button { background: #0abf82; color: #fff; font-size: 27rpx; font-weight: 600; padding: 0 30rpx; line-height: 65rpx; border-radius: 35rpx; margin: 14rpx 0 0; }
.review-list { margin-top: 15rpx; }
.review-card { padding: 22rpx 0; border-bottom: 1rpx solid #e6efe9; }
.review-card:last-child { border-bottom: 0; padding-bottom: 0; }
.review-card > view { display: flex; flex-wrap: wrap; gap: 8rpx; justify-content: space-between; align-items: center; }
.review-card > view text:first-child { color: #098b5b; letter-spacing: 3rpx; font-size: 28rpx; }
.review-card > view text:last-child, .review-card > text:nth-child(2) { color: #657a6f; font-size: 25rpx; }
.review-card > text { display: block; margin-top: 10rpx; color: #395e4b; font-size: 27rpx; font-weight: 500; line-height: 1.75; overflow-wrap: anywhere; }
.travel-note { display: block; margin: 20rpx 4rpx 0; padding: 20rpx; border-radius: 20rpx; background: #e6f8ee; color: #3d6b54; font-size: 25rpx; font-weight: 500; line-height: 1.8; }
.detail-state { min-height: 430rpx; display: flex; align-items: center; justify-content: center; color: #597264; font-size: 28rpx; line-height: 1.7; }
.detail-state.error { color: #a3483f; }
