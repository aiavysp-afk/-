.page{min-height:100vh;padding:calc(env(safe-area-inset-top) + 23rpx) 21rpx 46rpx;background:linear-gradient(180deg,#e2fff3,#f3f6f5 430rpx);box-sizing:border-box}.title{padding:3rpx 7rpx 23rpx}.title text{display:block}.title text:first-child{color:#203e34;font:700 35rpx "STSong"}.title text:last-child{margin-top:5rpx;color:#83958e;font-size:17rpx}.category-card{display:grid;grid-template-columns:repeat(4,1fr);padding:26rpx 8rpx;border-radius:29rpx;background:#fff;box-shadow:0 10rpx 28rpx rgba(28,70,56,.06)}.category-card>view{display:flex;align-items:center;flex-direction:column;color:#3b514a;font-size:18rpx}.category-card>view.active{color:#0db97a;font-weight:700}.category-icon{display:flex;width:68rpx;height:68rpx;align-items:center;justify-content:center;margin-bottom:12rpx;border-radius:24rpx;font-size:23rpx;font-weight:700}.category-icon.mint{background:#ddfff1;color:#10be7c}.category-icon.peach{background:#fff0df;color:#f18756}.category-icon.lime{background:#e9ffdd;color:#50ba69}.category-icon.blue{background:#e5f4ff;color:#439edb}.state,.error{display:block;padding:37rpx;text-align:center;color:#899791;font-size:18rpx}.error{margin-top:20rpx;padding:17rpx;border-radius:16rpx;background:#fff8e8;color:#7d622d}.message-list{display:flex;flex-direction:column;gap:13rpx;margin-top:19rpx}.message-row{display:grid;grid-template-columns:18rpx 1fr auto;align-items:center;gap:15rpx;padding:23rpx;border-radius:22rpx;background:#fff;box-shadow:0 8rpx 25rpx rgba(29,70,57,.05)}.message-dot{width:13rpx;height:13rpx;border-radius:50%;background:#14c480}.message-row view:nth-child(2) text{display:block}.message-row view:nth-child(2) text:first-child{color:#29443b;font-size:21rpx;font-weight:700}.message-row view:nth-child(2) text:nth-child(2){margin-top:7rpx;color:#7e8e88;font-size:16rpx}.message-row view:nth-child(2) text:last-child{margin-top:5rpx;color:#a2ada9;font-size:14rpx}.message-row>text{color:#a6b0ac}.system-card{display:flex;gap:19rpx;margin-top:20rpx;padding:27rpx;border-radius:24rpx;background:#fff}.system-mark{display:flex;width:64rpx;height:64rpx;align-items:center;justify-content:center;flex-shrink:0;border-radius:21rpx;background:#e1fff0;color:#12b978;font:700 25rpx "STSong"}.system-card>view:last-child text{display:block}.system-card>view:last-child text:first-child{color:#264239;font-size:22rpx;font-weight:700}.system-card>view:last-child text:nth-child(2){margin-top:10rpx;color:#5e746c;font-size:18rpx;line-height:1.6}.system-card>view:last-child text:last-child{margin-top:13rpx;color:#9ca8a4;font-size:14rpx}.service-card{display:flex;align-items:center;flex-direction:column;margin-top:20rpx;padding:65rpx 30rpx;border-radius:27rpx;background:#fff;text-align:center}.service-icon{display:flex;width:92rpx;height:92rpx;align-items:center;justify-content:center;border-radius:34rpx;background:#e5f4ff;color:#3d9edc;font-size:29rpx}.service-card>text{display:block}.service-card>text:nth-child(2){margin-top:22rpx;color:#264239;font-size:25rpx;font-weight:700}.service-card>text:nth-child(3){margin-top:8rpx;color:#87958f;font-size:17rpx}.service-card button{margin-top:31rpx;padding:0 44rpx;border-radius:37rpx;background:#13bf7c;color:#fff;font-size:20rpx;line-height:70rpx}.empty{display:flex;align-items:center;flex-direction:column;padding-top:180rpx;text-align:center}.bubble{position:relative;display:flex;width:116rpx;height:82rpx;align-items:center;justify-content:center;border-radius:32rpx;background:#e0ebe7;color:#fff;font-size:28rpx}.bubble::after{position:absolute;right:12rpx;bottom:-12rpx;border-top:22rpx solid #e0ebe7;border-left:22rpx solid transparent;content:""}.empty>text{display:block}.empty>text:nth-child(2){margin-top:32rpx;color:#5b7068;font-size:24rpx}.empty>text:last-child{margin-top:10rpx;color:#97a49f;font-size:17rpx}
