.page{min-height:100vh;padding:25rpx 22rpx 70rpx;background:#f4f7f6;box-sizing:border-box}.user-card{display:flex;align-items:center;gap:22rpx;padding:34rpx 28rpx;margin-bottom:20rpx;border-radius:28rpx;background:#fff;box-shadow:0 10rpx 28rpx rgba(32,72,58,.05)}.avatar{display:flex;width:88rpx;height:88rpx;align-items:center;justify-content:center;border-radius:50%;background:linear-gradient(145deg,#fff6ce,#f2dda3);color:#2b6554;font:700 33rpx "STSong"}.user-card>view:last-child text{display:block}.user-card>view:last-child text:first-child{color:#243e36;font-size:29rpx;font-weight:700}.user-card>view:last-child text:last-child{margin-top:10rpx;color:#9ba7a3;font-size:18rpx}.error{display:block;margin:-8rpx 4rpx 15rpx;padding:15rpx;border-radius:16rpx;background:#fff8e8;color:#80642e;font-size:17rpx}.menu-card{overflow:hidden;margin-top:18rpx;border-radius:25rpx;background:#fff;box-shadow:0 8rpx 26rpx rgba(31,71,58,.045)}.menu-card>view{display:flex;align-items:center;justify-content:space-between;margin:0 25rpx;padding:26rpx 0;border-bottom:1rpx solid #edf1ef;color:#29423a;font-size:22rpx}.menu-card>view:last-child{border-bottom:0}.menu-card>view>text:last-child{color:#a6afac}.menu-card .phone{color:#2b4b41;font-weight:600}.logout{margin-top:85rpx;border-radius:45rpx;background:#fff;color:#41534d;font-size:22rpx;line-height:82rpx;box-shadow:0 8rpx 26rpx rgba(31,71,58,.045)}.privacy-note{display:block;padding:22rpx 25rpx;color:#98a49f;font-size:16rpx;line-height:1.6;text-align:center}
