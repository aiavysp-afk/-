<view class="page">
  <view class="sub-nav"><text bindtap="back">‹</text><text>设置</text><text/></view>
  <view class="user-card">
    <view class="avatar">{{avatarText}}</view>
    <view><text>{{displayName}}</text><text>{{registeredAt === '--' ? '注册时间读取中' : registeredAt + ' 注册'}}</text></view>
  </view>
  <text wx:if="{{error}}" class="error">{{error}}</text>

  <view class="menu-card single">
    <view bindtap="openAddresses"><text>地址管理</text><text>›</text></view>
  </view>
  <view class="menu-card single">
    <view bindtap="openSecurity"><text>账号与安全</text><text>›</text></view>
  </view>
  <view class="menu-card">
    <view data-kind="about" bindtap="openRecord"><text>关于我们</text><text>›</text></view>
    <view data-kind="feedback" bindtap="openRecord"><text>意见反馈</text><text>›</text></view>
    <view bindtap="clearChat"><text>清空聊天记录</text><text>›</text></view>
  </view>
  <view class="menu-card single">
    <view bindtap="callCustomerService"><text>客服电话</text><text class="phone">{{customerServicePhone || '待后台配置'}}</text></view>
  </view>

  <button class="logout" bindtap="logout">退出登录</button>
  <text class="privacy-note">账户资料、订单和资金信息均从后台实时读取，本页不会在本机持久保存完整地址或手机号。</text>
</view>
