.page{min-height:100vh;background:#f2f8f5;padding:32rpx 24rpx;box-sizing:border-box;color:#244d3e;font-size:28rpx}.heading,.card{display:flex;flex-direction:column;gap:16rpx}.heading{padding:24rpx 10rpx;font-size:34rpx;font-weight:700}.heading text+text{font-size:27rpx;font-weight:500}.card{margin:24rpx 0;padding:30rpx;background:#fff;border-radius:24rpx;line-height:1.6}.title{font-size:32rpx;font-weight:650}button{margin:20rpx 0;border-radius:40rpx;background:#0ab987;color:#fff;font-size:29rpx}.secondary{background:#e0efe8;color:#27664e}.error{display:block;padding:24rpx;background:#fff0ee;color:#a33524;border-radius:16rpx}.notice{display:block;font-size:26rpx;line-height:1.7;color:#587164;margin:26rpx 0}.empty{display:flex;flex-direction:column;gap:22rpx;align-items:center;text-align:center;padding:70rpx 20rpx}.empty text:first-child{font-size:80rpx;color:#12b48a}
