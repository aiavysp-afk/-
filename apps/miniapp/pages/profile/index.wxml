<view class="page"
  ><view class="profile"
    ><view class="avatar">客</view
    ><view
      ><text class="profile-name">{{displayName}}</text
      ><text
        >{{loggedIn ? '已安全登录当前设备' : '登录后管理预约与售后'}}</text
      ></view
    ><button
      wx:if="{{!loggedIn}}"
      loading="{{loggingIn}}"
      disabled="{{loggingIn}}"
      bindtap="login"
    >
      登录</button
    ><button wx:else bindtap="logout">退出</button></view
  ><view class="stats"
    ><view><text class="stat-value">0</text><text>待服务</text></view
    ><view><text class="stat-value">0</text><text>进行中</text></view
    ><view><text class="stat-value">0</text><text>待评价</text></view
    ><view><text class="stat-value">0</text><text>售后</text></view></view
  ><view class="menus"
    ><view wx:for="{{menus}}" wx:key="*this"
      ><text>{{item}}</text><text class="chevron">›</text></view
    ><view bindtap="openCustomerService"
      ><text>企业微信客服</text
      ><text>{{customerService.available ? '联系' : '待配置'}} ›</text></view
    ><view bindtap="callEmergency"
      ><text>商家紧急值班电话</text
      ><text>{{emergencyContact.configured ? '拨号' : '待配置'}} ›</text></view
    ><view bindtap="openAdminLogin"
      ><text>后台登录确认（授权工作人员）</text><text>›</text></view
    ><view bindtap="openMfaRecovery"
      ><text>验证器丢失恢复（本人申请）</text><text>›</text></view
    ></view
  ><view class="version">中原到家 · 开发预览版</view></view
>
