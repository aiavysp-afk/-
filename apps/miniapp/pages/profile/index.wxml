<view class="page">
  <view class="header"><text>我的</text><button open-type="contact" show-message-card session-from="profile-header"><text>◌</text><text>客服</text></button></view>
  <view class="profile-card">
    <view class="profile-main"><view class="avatar">客</view><view class="identity"><text class="profile-name">{{displayName}}</text><text>{{loggedIn ? (phoneVerified ? '已登录 · 手机号已验证' : '已登录 · 待验证手机号') : '登录后管理预约与售后'}}</text><text class="level">中原到家用户</text></view></view>
    <button wx:if="{{!loggedIn}}" class="login-action" bindtap="openLogin">微信授权登录</button>
    <button wx:elif="{{!phoneVerified}}" class="verify-action" bindtap="verifyPhone">继续验证手机号</button>
    <view wx:else class="verified"><text>✓</text><text>账号已验证</text></view>
    <text wx:if="{{!loggedIn}}" class="login-note">微信授权后自动进入手机号短信验证，新用户自动注册</text>
  </view>
  <view class="stats-card"><view class="stats-title"><text>我的订单</text><navigator url="/pages/orders/index" open-type="switchTab">全部订单 ›</navigator></view><view class="stats"><view><text class="stat-icon mint">□</text><text class="stat-value">{{stats.upcoming}}</text><text>待服务</text></view><view><text class="stat-icon peach">▤</text><text class="stat-value">{{stats.active}}</text><text>进行中</text></view><view><text class="stat-icon lime">✓</text><text class="stat-value">{{stats.confirmation}}</text><text>待确认</text></view><view><text class="stat-icon blue">↺</text><text class="stat-value">{{stats.afterSale}}</text><text>售后</text></view></view><navigator class="order-banner" url="/pages/services/index" open-type="switchTab"><view><text>此刻想放松一下？</text><text>查看正规上门服务</text></view><text>去下单 ›</text></navigator></view>
  <view class="quick-actions"><navigator url="/pages/services/index" open-type="switchTab"><text>♡</text><text>收藏服务</text></navigator><navigator url="/pages/orders/index" open-type="switchTab"><text>⌖</text><text>服务足迹</text></navigator><button open-type="contact" show-message-card session-from="profile-help"><text>◌</text><text>在线客服</text></button></view>
  <view class="menus">
    <button open-type="contact" show-message-card session-from="profile-menu"><view><text class="menu-icon customer">•••</text><text>微信在线客服</text></view><text>立即咨询 ›</text></button>
    <view bindtap="callEmergency"><view><text class="menu-icon phone">☎</text><text>商家紧急值班电话</text></view><text>{{emergencyContact.configured ? '拨号' : '待配置'}} ›</text></view>
    <view bindtap="openAdminLogin"><view><text class="menu-icon staff">盾</text><text>工作人员登录确认</text></view><text>›</text></view>
    <view bindtap="openMfaRecovery"><view><text class="menu-icon safe">钥</text><text>验证器丢失恢复</text></view><text>›</text></view>
  </view>
  <button wx:if="{{loggedIn}}" class="logout" bindtap="logout">安全退出当前账号</button>
  <view class="version">中原到家 · 郑州全域正规上门服务</view>
  <view class="safe-bottom" />
</view>
