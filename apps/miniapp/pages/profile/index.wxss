.page{min-height:100vh;padding:calc(env(safe-area-inset-top) + 16rpx) 24rpx 30rpx;background:linear-gradient(180deg,#dffcf1 0,#eefbf6 380rpx,#f4f6f7 760rpx);box-sizing:border-box}.header{height:78rpx;display:flex;align-items:center;justify-content:space-between;font-size:34rpx;color:#173d33;font-weight:700}.header button{margin:0;padding:0 17rpx;display:flex;align-items:center;gap:7rpx;background:#ffffffb8;color:#176d55;border-radius:25rpx;line-height:56rpx;font-size:19rpx}.profile-card{background:linear-gradient(135deg,#24cc8c,#0eb476);color:#fff;border-radius:34rpx;padding:28rpx;box-shadow:0 20rpx 48rpx #13b6792d}.profile-main{display:flex;align-items:center;gap:20rpx}.avatar{width:90rpx;height:90rpx;border-radius:31rpx;background:#fff1c7;color:#3a6959;display:flex;align-items:center;justify-content:center;font:34rpx "STSong";box-shadow:0 8rpx 20rpx #087b5124}.identity text{display:block}.profile-name{font-size:31rpx;font-weight:700}.identity>text:nth-child(2){color:#dcfff1;font-size:18rpx;margin:6rpx 0}.level{display:inline-block!important;background:#ffffff2b;border:1rpx solid #ffffff55;border-radius:18rpx;padding:5rpx 12rpx;font-size:16rpx}.login-action,.verify-action{margin:24rpx 0 0;background:#fff;color:#0ba96e;border-radius:40rpx;line-height:78rpx;font-size:24rpx;font-weight:600}.verify-action{background:#fff5cf;color:#8d6820}.verified{display:flex;align-items:center;gap:9rpx;margin-top:22rpx;color:#e8fff5;font-size:20rpx}.verified text:first-child{width:36rpx;height:36rpx;border-radius:50%;background:#fff;color:#09ad70;display:flex;align-items:center;justify-content:center}.login-note{display:block;color:#d8fff0;font-size:17rpx;margin-top:12rpx;text-align:center}.stats-card{background:#fff;border-radius:30rpx;margin-top:18rpx;padding:25rpx 22rpx;box-shadow:0 12rpx 36rpx #274b4010}.stats-title{display:flex;align-items:center;justify-content:space-between}.stats-title>text{font-size:28rpx;font-weight:700}.stats-title navigator{font-size:19rpx;color:#97a39e}.stats{display:grid;grid-template-columns:repeat(4,1fr);margin:25rpx 0}.stats view{text-align:center}.stats view>text{display:block}.stat-icon{width:56rpx;height:56rpx;border-radius:20rpx;display:flex!important;align-items:center;justify-content:center;margin:0 auto 8rpx;font-size:24rpx}.stat-icon.mint{background:#dffbed;color:#0eb877}.stat-icon.peach{background:#fff0df;color:#f08454}.stat-icon.lime{background:#ecffdf;color:#52b86c}.stat-icon.blue{background:#e5f4ff;color:#409ddd}.stat-value{font-size:24rpx;font-weight:700;color:#223c34}.stats view>text:last-child{font-size:17rpx;color:#82908b}.order-banner{background:linear-gradient(100deg,#dcfff0,#a8f4d4);border-radius:22rpx;padding:21rpx 24rpx;display:flex;align-items:center;justify-content:space-between;color:#0a9f68}.order-banner view text{display:block;font-size:17rpx}.order-banner view text:first-child{font-size:24rpx;color:#174d3d;font-weight:700;margin-bottom:4rpx}.quick-actions{margin-top:18rpx;background:#fff;border-radius:26rpx;display:grid;grid-template-columns:repeat(3,1fr);padding:20rpx 6rpx}.quick-actions navigator,.quick-actions button{display:flex;align-items:center;justify-content:center;gap:8rpx;color:#28453d;font-size:20rpx;background:transparent;margin:0;padding:0;line-height:50rpx;border-right:1rpx solid #edf0ee}.quick-actions button{border-right:0}.quick-actions navigator>text:first-child,.quick-actions button>text:first-child{color:#11b878;font-size:27rpx}.menus{background:#fff;border-radius:28rpx;margin-top:18rpx;padding:0 22rpx}.menus>view,.menus>button{display:flex;justify-content:space-between;align-items:center;padding:23rpx 2rpx;border-bottom:1rpx solid #eff1ef;font-size:20rpx;background:transparent;margin:0;width:100%;line-height:1.4;color:#29423b;box-sizing:border-box}.menus>view:last-child{border:0}.menus>view>view,.menus>button>view{display:flex;align-items:center;gap:14rpx}.menus>view>text,.menus>button>text{color:#9ca7a3;font-size:18rpx}.menu-icon{width:46rpx;height:46rpx;border-radius:16rpx;display:flex;align-items:center;justify-content:center;font-size:18rpx;font-weight:600}.customer{background:#e4f4ff;color:#369cde}.wecom{background:#e2fff1;color:#0aa86d}.phone{background:#fff0e4;color:#df8051}.staff{background:#eef0ff;color:#6873c7}.safe{background:#f4efff;color:#8a62ba}.logout{margin-top:22rpx;background:#fff;color:#6e7e78;border-radius:24rpx;font-size:21rpx;line-height:70rpx}.version{text-align:center;color:#a2ada9;font-size:17rpx;margin-top:26rpx}
