.page{min-height:100vh;padding:25rpx 22rpx 70rpx;background:#f4f7f6;box-sizing:border-box}.intro{display:flex;align-items:center;justify-content:space-between;padding:7rpx 5rpx 23rpx}.intro view text{display:block}.intro view text:first-child{color:#203e35;font-size:30rpx;font-weight:700}.intro view text:last-child{margin-top:5rpx;color:#899792;font-size:16rpx}.intro button{margin:0;padding:0 22rpx;border-radius:30rpx;background:#16bf7d;color:#fff;line-height:59rpx;font-size:18rpx}.state{display:block;padding:35rpx;text-align:center;color:#899791;font-size:18rpx}.error-card{display:block;margin-bottom:16rpx;padding:17rpx;border-radius:17rpx;background:#fff1ed;color:#ba5849;font-size:17rpx}.address-list{display:flex;flex-direction:column;gap:15rpx}.address-card{padding:25rpx;border-radius:24rpx;background:#fff;box-shadow:0 8rpx 26rpx rgba(31,70,58,.05)}.address-head{display:flex;align-items:center;justify-content:space-between}.address-head>view{display:flex;align-items:center;gap:12rpx}.address-head>view>text:first-child{color:#274139;font-size:22rpx;font-weight:700}.address-head>view>text:nth-child(2){color:#6f817a;font-size:18rpx}.address-head>view>text:last-child{padding:4rpx 10rpx;border-radius:14rpx;background:#e4fff1;color:#0fb878;font-size:14rpx}.address-head>text{color:#17ad76;font-size:17rpx}.address-detail{display:block;margin-top:15rpx;color:#435a52;font-size:20rpx;line-height:1.55}.address-foot{display:flex;align-items:center;justify-content:space-between;margin-top:19rpx;padding-top:15rpx;border-top:1rpx solid #eef1f0;color:#96a39e;font-size:15rpx}.address-foot>view{display:flex;gap:22rpx}.address-foot>view text:first-child{color:#16aa74}.address-foot>view text:last-child{color:#d06959}.empty{display:flex;align-items:center;flex-direction:column;padding-top:160rpx;color:#95a39e;text-align:center}.pin{display:flex;width:110rpx;height:110rpx;align-items:center;justify-content:center;border-radius:50%;background:#e2ede9;color:#b8cbc4;font-size:47rpx}.empty>text{display:block}.empty>text:nth-child(2){margin-top:28rpx;color:#5a6f67;font-size:24rpx}.empty>text:nth-child(3){max-width:500rpx;margin-top:10rpx;font-size:17rpx;line-height:1.5}.empty button{margin-top:31rpx;padding:0 34rpx;border-radius:35rpx;background:#15bf7c;color:#fff;font-size:19rpx;line-height:68rpx}.mask{position:fixed;z-index:30;inset:0;display:flex;align-items:flex-end;background:rgba(13,35,28,.42)}.form-sheet{width:100%;max-height:90vh;overflow-y:auto;padding:29rpx 25rpx calc(25rpx + env(safe-area-inset-bottom));border-radius:36rpx 36rpx 0 0;background:#f7f9f8;box-sizing:border-box}.sheet-head{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:24rpx}.sheet-head view text{display:block}.sheet-head view text:first-child{color:#234139;font-size:29rpx;font-weight:700}.sheet-head view text:last-child{margin-top:7rpx;color:#899792;font-size:16rpx}.sheet-head>text{padding:0 7rpx;color:#70817b;font-size:40rpx}.field{margin-top:16rpx}.field>text,.address-field>view>text{display:block;margin:0 6rpx 10rpx;color:#3f554e;font-size:18rpx;font-weight:600}.field input,.field textarea{width:100%;padding:0 19rpx;border-radius:18rpx;background:#fff;color:#263e36;font-size:19rpx;box-sizing:border-box}.field input{height:72rpx}.field textarea{height:147rpx;padding-top:18rpx}.address-field>view{display:flex;align-items:center;justify-content:space-between}.address-field>view button{margin:0 0 8rpx;padding:0 17rpx;border-radius:24rpx;background:#e5fff2;color:#10a970;font-size:16rpx;line-height:48rpx}.coordinate-note{display:flex;align-items:center;justify-content:space-between;margin:11rpx 5rpx;color:#83938d;font-size:15rpx}.coordinate-note text:first-child{color:#17aa75}.default-row{display:flex;align-items:center;justify-content:space-between;margin-top:18rpx;padding:18rpx 20rpx;border-radius:18rpx;background:#fff}.default-row view text{display:block}.default-row view text:first-child{color:#334b43;font-size:19rpx;font-weight:600}.default-row view text:last-child{margin-top:5rpx;color:#96a29e;font-size:15rpx}.form-error{display:block;margin-top:16rpx;padding:14rpx;border-radius:14rpx;background:#fff0ed;color:#bd594b;font-size:16rpx;line-height:1.5}.save{margin-top:22rpx;border-radius:39rpx;background:#14bf7d;color:#fff;font-size:21rpx;line-height:76rpx}
