<view class="page"><scroll-view scroll-x class="filters"><view class="filter-row"><text wx:for="{{categories}}" wx:key="*this" class="{{active===index?'active':''}}" data-index="{{index}}" bindtap="select">{{item}}</text></view></scroll-view><view class="intro"><text class="eyebrow">正规、透明、可追溯</text><text class="intro-title serif">为你挑选适合此刻的放松</text><text class="intro-desc">所有项目均为非医疗养生放松服务</text></view><view class="list"><view wx:for="{{services}}" wx:key="name" class="card"><view class="art a{{index}}"><text>0{{index+1}}</text></view><view><text class="card-name serif">{{item.name}}</text><text class="card-desc">{{item.desc}}</text><text>{{item.time}}</text><view class="price"><text>¥</text>{{item.price}}<text> 起</text></view></view></view></view></view>
