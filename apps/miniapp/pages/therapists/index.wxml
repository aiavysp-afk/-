<view class="page">
  <view class="header">
    <text class="eyebrow">平台资料审核</text>
    <text class="header-title serif">认真服务，也安心选择</text>
    <text class="header-desc">不展示未经授权的人员姓名、证件或实时位置</text>
  </view>
  <view class="standard" wx:for="{{standards}}" wx:key="title">
    <view class="standard-index">0{{index + 1}}</view>
    <view>
      <text class="standard-title">{{item.title}}</text>
      <text class="standard-detail">{{item.detail}}</text>
    </view>
  </view>
  <view class="notice">可约人员与服务时段会在预约页根据真实排班返回；未取得公开展示授权前，不使用虚构或演示技师资料。</view>
  <button bindtap="openServices">查看服务与可约时段</button>
</view>
