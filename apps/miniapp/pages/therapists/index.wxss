.page{min-height:100vh;padding:calc(env(safe-area-inset-top) + 24rpx) 26rpx 35rpx;background:linear-gradient(180deg,#dffcf1 0,#f2f7f5 580rpx);box-sizing:border-box}.header{margin:8rpx 0 28rpx;background:linear-gradient(135deg,#22cd8c,#0bb576);border-radius:34rpx;padding:35rpx;color:#fff;box-shadow:0 18rpx 44rpx #10b6762d;position:relative;overflow:hidden}.header:after{content:"人";position:absolute;right:22rpx;bottom:-25rpx;width:145rpx;height:145rpx;border-radius:50%;background:#ffffff1f;color:#e5fff5;display:flex;align-items:center;justify-content:center;font:52rpx "STSong"}.eyebrow{display:block;font-size:18rpx;color:#dffff1;letter-spacing:2rpx}.header-title{display:block;font-size:37rpx;margin:10rpx 0;font-weight:700;position:relative;z-index:2}.header-desc{display:block;max-width:450rpx;font-size:18rpx;color:#dbfff0;position:relative;z-index:2}.standard{background:#fff;border-radius:26rpx;padding:25rpx;display:grid;grid-template-columns:72rpx 1fr;gap:19rpx;margin-bottom:17rpx;box-shadow:0 10rpx 30rpx #244a3d0b}.standard-index{width:58rpx;height:58rpx;border-radius:19rpx;background:#ddfff0;color:#0baa70;display:flex;align-items:center;justify-content:center;font-weight:700}.standard-title{display:block;font-size:25rpx;font-weight:700;color:#24473e}.standard-detail{display:block;font-size:18rpx;color:#788780;line-height:1.7;margin-top:7rpx}.notice{background:#fff8e8;border:1rpx solid #f0ddb6;border-radius:21rpx;padding:22rpx;font-size:18rpx;color:#796743;line-height:1.7;margin:25rpx 0}.page>button{background:linear-gradient(90deg,#22ca88,#08b879);color:#fff;border-radius:40rpx;font-size:22rpx;line-height:78rpx;box-shadow:0 12rpx 28rpx #10b7772c}
