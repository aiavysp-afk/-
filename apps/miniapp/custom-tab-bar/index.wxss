.tab-shell{position:fixed;z-index:1000;right:0;bottom:0;left:0;background:rgba(255,255,255,.97);box-shadow:0 -10rpx 32rpx rgba(31,75,61,.09)}.tab-bar{display:flex;align-items:flex-end;justify-content:space-around;height:112rpx;padding:7rpx 16rpx 5rpx;box-sizing:border-box}.tab-item{display:flex;flex:1;min-width:0;min-height:92rpx;align-items:center;justify-content:center;flex-direction:column;color:#a4b5af}.icon-frame{display:flex;width:55rpx;height:44rpx;align-items:center;justify-content:center;border-radius:22rpx}.tab-icon{font-family:Arial,sans-serif;font-size:30rpx;line-height:1}.tab-label{margin-top:5rpx;font-size:18rpx;line-height:1}.tab-item.active{color:#0ab878;font-weight:600}.tab-item.active .icon-frame{background:#e0fff1;color:#09b777}.tab-item.center{transform:translateY(-22rpx)}.tab-item.center .icon-frame{width:86rpx;height:86rpx;border-radius:50%;background:linear-gradient(145deg,#28d894,#06b774);color:#fff;border:7rpx solid #fff;box-shadow:0 10rpx 30rpx rgba(13,183,120,.32)}.tab-item.center .tab-icon{font-size:34rpx}.tab-item.center .tab-label{margin-top:0}.tab-item.center.active .icon-frame{box-shadow:0 0 0 5rpx #baffdf,0 12rpx 32rpx rgba(13,183,120,.36)}.safe-area{height:env(safe-area-inset-bottom)}
