<view class="tab-shell">
  <view class="tab-bar" role="tablist" aria-label="主导航">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-item {{selected === index ? 'active' : ''}} {{index === 2 ? 'center' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
      role="tab"
      aria-label="{{item.text}}"
      aria-selected="{{selected === index}}"
    >
      <view class="icon-frame"><text class="tab-icon">{{item.icon}}</text></view>
      <text class="tab-label">{{item.text}}</text>
    </view>
  </view>
  <view class="safe-area" />
</view>
