page{background:#f7f5ef;color:#20332d;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;padding-bottom:calc(116rpx + env(safe-area-inset-bottom));box-sizing:border-box}button{font-weight:400}button::after{border:0}.safe-bottom{height:calc(28rpx + env(safe-area-inset-bottom))}.serif{font-family:"Songti SC","STSong",serif}
.brand-name,.brand-sub,.location-label,.location-value,.intro-title,.intro-desc,.header-title,.header-desc,.profile-name,.stat-value,.empty-title,.empty-note{display:block}.brand-name{font-family:"STSong";font-size:31rpx;letter-spacing:5rpx;font-weight:600}.brand-sub{font-size:16rpx;color:#a9c2b8;letter-spacing:4rpx;margin-top:5rpx}.location-label{font-size:18rpx;color:#9fbab0}.location-value{font-size:22rpx;margin-top:5rpx;font-weight:600}.promise-name{font-size:20rpx;margin-top:10rpx;font-weight:600}.promise-desc{font-size:15rpx;color:#99a19e;margin-top:3rpx}.section-desc{font-size:18rpx;color:#909a96}.currency,.unit{font-size:18rpx;color:#a87938}.amount{font-size:34rpx;color:#9e6d2c;margin:0 3rpx;font-weight:600}.online{position:absolute;right:-2rpx;bottom:-2rpx;width:14rpx;height:14rpx;border-radius:50%;background:#58a17f;border:4rpx solid #fff}.person-name{font-size:24rpx;font-weight:600}.person-level{font-size:17rpx;color:#919b97}.boundary-title{display:block;font-size:21rpx;font-weight:600}.intro .eyebrow,.header .eyebrow{font-size:18rpx;color:#af8240;letter-spacing:2rpx}.intro-title,.header-title{font-size:36rpx;margin:10rpx 0;font-weight:600}.intro-desc,.header-desc{font-size:19rpx;color:#8d9793}.card-name{display:block;font-size:28rpx;margin-top:7rpx;font-weight:600}.card-desc{display:block;font-size:18rpx;color:#8c9692;margin:9rpx 0 20rpx}.price{margin:16rpx 0 0;color:#986b2f;font-size:32rpx}.price text{font-size:17rpx}.available{position:absolute;bottom:12rpx;left:12rpx;background:#ffffffd9;color:#2e6656;border-radius:20rpx;font-size:16rpx;padding:6rpx 12rpx}.info-name{font-size:27rpx;font-weight:600}.score{font-size:18rpx;color:#a87836}.info-meta{font-size:17rpx;color:#8f9895}.skills{font-size:18rpx;color:#5e716b;background:#f1f5f2;border-radius:8rpx;padding:8rpx;margin:20rpx 0}.empty-title{font-size:32rpx;margin-top:28rpx;font-weight:600}.empty-note{font-size:17rpx;color:#b08a52;margin-top:25rpx}.profile-name{font-size:27rpx;font-weight:600}.stat-value{font-size:28rpx;font-weight:600}.chevron{color:#a4aca9}
