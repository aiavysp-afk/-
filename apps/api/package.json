{
  "name": "@zydj/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:mall": "tsx scripts/verify-mall-flow.ts",
    "test:mfa": "tsx scripts/verify-mfa-flow.ts",
    "test:mfa-recovery": "tsx scripts/verify-mfa-recovery.ts",
    "test:browser-login": "tsx scripts/verify-browser-login.ts",
    "test:wechat-db": "tsx scripts/verify-wechat-payments.ts",
    "test:safety": "tsx scripts/verify-safety-duty.ts",
    "test:safety-notifications": "tsx scripts/verify-safety-notifications.ts",
    "bootstrap:public-booking": "tsx scripts/bootstrap-production-booking.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.0.2",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@prisma/client": "6.16.3",
    "@zydj/contracts": "workspace:*",
    "fastify": "5.12.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "24.7.0",
    "prisma": "6.16.3",
    "tsx": "4.20.6",
    "vitest": "3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
