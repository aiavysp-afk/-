generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  THERAPIST
  OPERATOR
  DISPATCHER
  FINANCE_REQUESTER
  FINANCE_APPROVER
  SAFETY_DUTY
  ADMIN
}

enum IdentityProvider {
  WECHAT_MINIAPP
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum MfaRecoveryStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum SafetyIncidentStatus {
  OPEN
  ESCALATED
  ACKNOWLEDGED
  CLOSED
}

enum SafetyIncidentCategory {
  PERSONAL_SAFETY
  MEDICAL_CONCERN
  SERVICE_DISPUTE
  OTHER_URGENT
}

enum ServiceCategory {
  MASSAGE
  SPA_RELAXATION
  FOOT_CARE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  DISPATCHING
  ASSIGNED
  EN_ROUTE
  ARRIVED
  IN_SERVICE
  AWAITING_CONFIRMATION
  COMPLETED
  CANCELLED
  REFUNDING
  REFUNDED
}

enum ShiftStatus {
  ACTIVE
  CANCELLED
}

enum ReservationStatus {
  HOLD
  CONFIRMED
  RELEASED
  EXPIRED
}

enum PaymentProvider {
  MOCK
  WECHAT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CLOSED
  FAILED
  REFUNDING
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  UNKNOWN
  ABNORMAL
  CLOSED
  SUCCEEDED
  REJECTED
}

enum RefundReason {
  CUSTOMER_CANCELLED
  UNFULFILLABLE
  LATE_PAYMENT
}

model Organization {
  id                  String                   @id @default(cuid())
  name                String
  createdAt           DateTime                 @default(now())
  users               User[]
  memberships         StaffMembership[]
  services            Service[]
  orders              Order[]
  shifts              TherapistShift[]
  reservations        AppointmentReservation[]
  mfaRecoveryRequests MfaRecoveryRequest[]
  safetyDutyRosters   SafetyDutyRoster[]
  safetyIncidents     SafetyIncident[]
}

model User {
  id                          String                       @id @default(cuid())
  organizationId              String?
  organization                Organization?                @relation(fields: [organizationId], references: [id])
  role                        UserRole
  displayName                 String
  phoneEncrypted              String?
  phoneVerifiedAt             DateTime?
  status                      String                       @default("ACTIVE")
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  identities                  ExternalIdentity[]
  sessions                    Session[]
  memberships                 StaffMembership[]
  mfaCredential               MfaCredential?
  customerOrders              Order[]                      @relation("CustomerOrders")
  therapistOrders             Order[]                      @relation("TherapistOrders")
  therapistShifts             TherapistShift[]             @relation("TherapistShifts")
  customerReservations        AppointmentReservation[]     @relation("CustomerReservations")
  therapistReservations       AppointmentReservation[]     @relation("TherapistReservations")
  requestedMfaRecoveries      MfaRecoveryRequest[]         @relation("MfaRecoveryTarget")
  reviewedMfaRecoveries       MfaRecoveryRequest[]         @relation("MfaRecoveryReviewer")
  createdSafetyRosters        SafetyDutyRoster[]           @relation("SafetyRosterCreator")
  primarySafetyRosters        SafetyDutyRoster[]           @relation("SafetyRosterPrimary")
  backupSafetyRosters         SafetyDutyRoster[]           @relation("SafetyRosterBackup")
  reportedSafetyIncidents     SafetyIncident[]             @relation("SafetyIncidentReporter")
  primarySafetyIncidents      SafetyIncident[]             @relation("SafetyIncidentPrimary")
  backupSafetyIncidents       SafetyIncident[]             @relation("SafetyIncidentBackup")
  acknowledgedIncidents       SafetyIncident[]             @relation("SafetyIncidentAcknowledger")
  closedSafetyIncidents       SafetyIncident[]             @relation("SafetyIncidentCloser")
  addressVerifications        AddressVerification[]
  phoneVerificationChallenges PhoneVerificationChallenge[]
  technicianLocation          TechnicianLocation?
}

model ExternalIdentity {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         IdentityProvider
  subjectHash      String
  subjectEncrypted String
  unionIdHash      String?
  unionIdEncrypted String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([provider, subjectHash])
  @@index([userId, provider])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  lastSeenAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  mfaVerifiedUntil DateTime?
  authChannel      String    @default("LEGACY")
  authProvider     String    @default("unknown")

  @@index([userId, expiresAt])
}

model BrowserLoginChallenge {
  id                String    @id
  browserSecretHash String
  confirmationHash  String
  status            String    @default("PENDING")
  failedAttempts    Int       @default(0)
  approvedUserId    String?
  approvedSessionId String?
  claimedSessionId  String?   @unique
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  approvedAt        DateTime?
  consumedAt        DateTime?
  lastPolledAt      DateTime?

  @@index([expiresAt])
}

model BrowserLoginRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

model MapRequestRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

model PhoneVerificationChallenge {
  id                String    @id
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneHash         String
  phoneEncrypted    String
  codeHash          String
  status            String    @default("PENDING")
  attempts          Int       @default(0)
  providerRequestId String?
  providerBizId     String?
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([phoneHash, createdAt])
  @@index([status, expiresAt])
}

model PhoneVerificationRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

model AddressVerification {
  id               String                 @id @default(cuid())
  userId           String
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservationId    String                 @unique
  reservation      AppointmentReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  detailHash       String
  adcode           String
  latitude         Float
  longitude        Float
  coordinateSystem String                 @default("GCJ-02")
  expiresAt        DateTime
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([userId, expiresAt])
}

model MfaCredential {
  userId              String    @id
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEncrypted     String
  enabledAt           DateTime?
  enrollmentSessionId String?
  enrollmentExpiresAt DateTime?
  lastAcceptedStep    BigInt?
  failedAttempts      Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model MfaRecoveryRequest {
  id                String            @id
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  targetUserId      String
  targetUser        User              @relation("MfaRecoveryTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  sourceSessionId   String
  status            MfaRecoveryStatus @default(PENDING)
  reviewerUserId    String?
  reviewerUser      User?             @relation("MfaRecoveryReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  reviewerSessionId String?
  reasonCode        String?
  createdAt         DateTime          @default(now())
  expiresAt         DateTime
  reviewedAt        DateTime?
  executedAt        DateTime?

  @@index([organizationId, status, createdAt])
  @@index([targetUserId, createdAt])
}

model StaffMembership {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           UserRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, organizationId, role])
  @@index([organizationId, status, role])
}

model Service {
  id              String                   @id @default(cuid())
  organizationId  String
  organization    Organization             @relation(fields: [organizationId], references: [id])
  slug            String                   @unique
  name            String
  category        ServiceCategory
  subtitle        String
  badge           String?
  description     String
  durationMinutes Int
  priceFen        BigInt
  featured        Boolean                  @default(false)
  published       Boolean                  @default(false)
  steps           Json
  boundaries      Json
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  orderItems      OrderItem[]
  reservations    AppointmentReservation[]
}

model TherapistShift {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  therapistId    String
  therapist      User         @relation("TherapistShifts", fields: [therapistId], references: [id])
  startsAt       DateTime
  endsAt         DateTime
  status         ShiftStatus  @default(ACTIVE)
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, startsAt])
  @@index([therapistId, status, startsAt])
}

model AppointmentReservation {
  id                  String               @id @default(cuid())
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id])
  serviceId           String
  service             Service              @relation(fields: [serviceId], references: [id])
  therapistId         String
  therapist           User                 @relation("TherapistReservations", fields: [therapistId], references: [id])
  customerId          String
  customer            User                 @relation("CustomerReservations", fields: [customerId], references: [id])
  serviceAmountFen    BigInt
  startsAt            DateTime
  endsAt              DateTime
  expiresAt           DateTime
  status              ReservationStatus    @default(HOLD)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  order               Order?
  addressVerification AddressVerification?

  @@index([organizationId, startsAt])
  @@index([therapistId, status, startsAt])
  @@index([customerId, status, expiresAt])
}

model Order {
  id                      String                  @id @default(cuid())
  orderNo                 String                  @unique
  organizationId          String
  organization            Organization            @relation(fields: [organizationId], references: [id])
  customerId              String
  customer                User                    @relation("CustomerOrders", fields: [customerId], references: [id])
  therapistId             String?
  therapist               User?                   @relation("TherapistOrders", fields: [therapistId], references: [id])
  reservationId           String?                 @unique
  reservation             AppointmentReservation? @relation(fields: [reservationId], references: [id])
  status                  OrderStatus
  appointmentStart        DateTime
  appointmentEnd          DateTime
  serviceAmountFen        BigInt
  travelFeeFen            BigInt
  discountFen             BigInt                  @default(0)
  payableFen              BigInt
  addressEncrypted        String
  addressLatitude         Float?
  addressLongitude        Float?
  addressCoordinateSystem String?
  policyVersion           String
  paymentExpiresAt        DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  items                   OrderItem[]
  events                  OrderEvent[]
  payment                 Payment?
  idempotencyKey          String
  requestFingerprint      String
  safetyIncidents         SafetyIncident[]

  @@unique([customerId, idempotencyKey])
  @@index([organizationId, status, appointmentStart])
}

model TechnicianLocation {
  id               String   @id @default(cuid())
  technicianId     String   @unique
  technician       User     @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  latitude         Float
  longitude        Float
  coordinateSystem String   @default("GCJ-02")
  accuracyMeters   Float?
  reportedAt       DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([reportedAt])
}

model SafetyDutyRoster {
  id                            String           @id @default(cuid())
  organizationId                String
  organization                  Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  primaryUserId                 String
  primaryUser                   User             @relation("SafetyRosterPrimary", fields: [primaryUserId], references: [id], onDelete: Restrict)
  backupUserId                  String
  backupUser                    User             @relation("SafetyRosterBackup", fields: [backupUserId], references: [id], onDelete: Restrict)
  acknowledgementTimeoutSeconds Int
  active                        Boolean          @default(true)
  createdById                   String
  createdBy                     User             @relation("SafetyRosterCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt                     DateTime         @default(now())
  deactivatedAt                 DateTime?
  incidents                     SafetyIncident[]

  @@index([organizationId, active])
  @@index([primaryUserId, active])
  @@index([backupUserId, active])
}

model SafetyIncident {
  id                   String                 @id @default(cuid())
  organizationId       String
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orderId              String
  order                Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reporterUserId       String
  reporter             User                   @relation("SafetyIncidentReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  rosterId             String
  roster               SafetyDutyRoster       @relation(fields: [rosterId], references: [id], onDelete: Restrict)
  primaryUserId        String
  primaryUser          User                   @relation("SafetyIncidentPrimary", fields: [primaryUserId], references: [id], onDelete: Restrict)
  backupUserId         String
  backupUser           User                   @relation("SafetyIncidentBackup", fields: [backupUserId], references: [id], onDelete: Restrict)
  category             SafetyIncidentCategory
  status               SafetyIncidentStatus   @default(OPEN)
  idempotencyKey       String
  requestFingerprint   String
  acknowledgementDueAt DateTime
  acknowledgedById     String?
  acknowledgedBy       User?                  @relation("SafetyIncidentAcknowledger", fields: [acknowledgedById], references: [id], onDelete: Restrict)
  acknowledgedAt       DateTime?
  escalatedAt          DateTime?
  closedById           String?
  closedBy             User?                  @relation("SafetyIncidentCloser", fields: [closedById], references: [id], onDelete: Restrict)
  resolutionCode       String?
  closedAt             DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  events               SafetyIncidentEvent[]

  @@unique([reporterUserId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([status, acknowledgementDueAt])
  @@index([orderId, createdAt])
}

model SafetyIncidentEvent {
  id         String         @id @default(cuid())
  incidentId String
  incident   SafetyIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type       String
  actorId    String?
  payload    Json
  createdAt  DateTime       @default(now())

  @@index([incidentId, createdAt])
}

enum WechatPrepayState {
  NONE
  DISPATCHING
  READY
  UNKNOWN
}

enum WechatCloseState {
  NONE
  DISPATCHING
  UNKNOWN
  CONFIRMED
}

model Payment {
  id                    String            @id @default(cuid())
  orderId               String            @unique
  order                 Order             @relation(fields: [orderId], references: [id])
  provider              PaymentProvider
  status                PaymentStatus     @default(PENDING)
  merchantPaymentNo     String            @unique
  amountFen             BigInt
  refundReservedFen     BigInt            @default(0)
  refundedFen           BigInt            @default(0)
  providerReference     String?
  prepayState           WechatPrepayState @default(NONE)
  prepayRequestedAt     DateTime?
  prepayReadyAt         DateTime?
  prepayFailureCode     String?
  closeState            WechatCloseState  @default(NONE)
  closeRequestedAt      DateTime?
  closeReason           String?
  closeDispatchedAt     DateTime?
  closeVerifiedAt       DateTime?
  closeAttempts         Int               @default(0)
  providerTradeState    String?
  providerCheckedAt     DateTime?
  recoveryAttempts      Int               @default(0)
  recoveryNextCheckAt   DateTime?
  recoveryLeaseToken    String?
  recoveryLeaseUntil    DateTime?
  recoveryFailureCode   String?
  recoveryReviewAt      DateTime?
  providerTransactionId String?           @unique
  failureCode           String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  succeededAt           DateTime?
  closedAt              DateTime?
  events                PaymentEvent[]
  refunds               Refund[]

  @@index([status, createdAt])
  @@index([provider, status, recoveryNextCheckAt])
}

model PaymentEvent {
  id              String   @id @default(cuid())
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id])
  type            String
  providerEventId String?  @unique
  payload         Json
  createdAt       DateTime @default(now())

  @@index([paymentId, createdAt])
}

model Refund {
  id                 String               @id @default(cuid())
  paymentId          String
  payment            Payment              @relation(fields: [paymentId], references: [id])
  merchantRefundNo   String               @unique
  amountFen          BigInt
  status             RefundStatus         @default(REQUESTED)
  reason             RefundReason
  policyVersion      String
  requestedById      String
  reviewedById       String?
  reviewCode         String?
  idempotencyKey     String
  requestFingerprint String
  providerRefundId   String?              @unique
  requestedAt        DateTime             @default(now())
  reviewedAt         DateTime?
  submittedAt        DateTime?
  succeededAt        DateTime?
  nextCheckAt        DateTime?
  checkAttempts      Int                  @default(0)
  updatedAt          DateTime             @updatedAt
  events             RefundEvent[]
  posting            RefundLedgerPosting?

  @@unique([paymentId, idempotencyKey])
  @@index([paymentId, status])
  @@index([status, nextCheckAt])
}

model RefundEvent {
  id              String   @id @default(cuid())
  refundId        String
  refund          Refund   @relation(fields: [refundId], references: [id])
  type            String
  actorId         String?
  providerEventId String?  @unique
  payload         Json
  createdAt       DateTime @default(now())

  @@index([refundId, createdAt])
}

// A single posting represents two equal debit/credit legs. Success is appended once.
model RefundLedgerPosting {
  id            String   @id @default(cuid())
  refundId      String   @unique
  refund        Refund   @relation(fields: [refundId], references: [id])
  amountFen     BigInt
  debitAccount  String   @default("CUSTOMER_REFUND_LIABILITY")
  creditAccount String   @default("CHANNEL_REFUND_OUTFLOW")
  createdAt     DateTime @default(now())
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id])
  serviceId       String
  service         Service @relation(fields: [serviceId], references: [id])
  serviceName     String
  durationMinutes Int
  unitPriceFen    BigInt
  quantity        Int     @default(1)
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  type      String
  actorId   String?
  payload   Json
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  organizationId String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

model OutboxEvent {
  id                    String    @id @default(cuid())
  organizationId        String?
  aggregateId           String
  type                  String
  payload               Json
  createdAt             DateTime  @default(now())
  publishedAt           DateTime?
  attempts              Int       @default(0)
  nextAttemptAt         DateTime  @default(now())
  leaseToken            String?
  leaseUntil            DateTime?
  dispatchStartedAt     DateTime?
  lastErrorCode         String?
  providerReference     String?
  providerBizId         String?
  deadLetteredAt        DateTime?
  deliveryStatus        String?
  deliveryQueryAttempts Int       @default(0)
  deliveryNextQueryAt   DateTime?
  deliveryCheckedAt     DateTime?
  deliveredAt           DateTime?
  deliveryErrorCode     String?

  @@index([publishedAt, createdAt])
  @@index([organizationId, createdAt])
  @@index([publishedAt, deadLetteredAt, nextAttemptAt, leaseUntil], map: "OutboxEvent_dispatch_idx")
  @@index([deliveryStatus, deliveryNextQueryAt, leaseUntil], map: "OutboxEvent_delivery_query_idx")
}
