generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  THERAPIST
  OPERATOR
  DISPATCHER
  FINANCE_REQUESTER
  FINANCE_APPROVER
  SAFETY_DUTY
  ADMIN
}

enum IdentityProvider {
  WECHAT_MINIAPP
  WECHAT_H5
}

enum TechnicianIdentityDocumentKind {
  ID_FRONT
  ID_BACK
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum MfaRecoveryStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum SafetyIncidentStatus {
  OPEN
  ESCALATED
  ACKNOWLEDGED
  CLOSED
}

enum SafetyIncidentCategory {
  PERSONAL_SAFETY
  MEDICAL_CONCERN
  SERVICE_DISPUTE
  OTHER_URGENT
}

enum ServiceCategory {
  MASSAGE
  SPA_RELAXATION
  FOOT_CARE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  DISPATCHING
  ASSIGNED
  EN_ROUTE
  ARRIVED
  IN_SERVICE
  AWAITING_CONFIRMATION
  COMPLETED
  CANCELLED
  REFUNDING
  REFUNDED
}

enum ShiftStatus {
  ACTIVE
  CANCELLED
}

enum ReservationStatus {
  HOLD
  CONFIRMED
  RELEASED
  EXPIRED
}

enum PaymentProvider {
  MOCK
  WECHAT
}

enum PaymentKind {
  SELF
  FRIEND
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CLOSED
  FAILED
  REFUNDING
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  UNKNOWN
  ABNORMAL
  CLOSED
  SUCCEEDED
  REJECTED
}

enum RefundReason {
  CUSTOMER_CANCELLED
  UNFULFILLABLE
  LATE_PAYMENT
}

enum TechnicianProfileStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
}

enum TechnicianReviewStatus {
  PENDING_REVIEW
  PUBLISHED
  HIDDEN
}

enum TechnicianInvitationStatus {
  PENDING
  CLAIMED
  REVOKED
}

enum CustomerCouponStatus {
  AVAILABLE
  USED
  EXPIRED
}

enum StoredValueCardStatus {
  AVAILABLE
  UNAVAILABLE
}

enum StoredValueCardType {
  PHYSICAL
  DISCOUNT_93
  DISCOUNT_90
}

enum StoredValueRechargeStatus {
  PENDING
  SUCCEEDED
  UNKNOWN
  CLOSED
}

enum CustomerFeedbackStatus {
  OPEN
  RESOLVED
}

enum AccountDeletionRequestStatus {
  PENDING
  CANCELLED
  COMPLETED
}

model Organization {
  id                      String                   @id @default(cuid())
  name                    String
  createdAt               DateTime                 @default(now())
  users                   User[]
  memberships             StaffMembership[]
  services                Service[]
  orders                  Order[]
  shifts                  TherapistShift[]
  reservations            AppointmentReservation[]
  mfaRecoveryRequests     MfaRecoveryRequest[]
  safetyDutyRosters       SafetyDutyRoster[]
  safetyIncidents         SafetyIncident[]
  technicianProfiles      TechnicianProfile[]
  technicianReviews       TechnicianReview[]
  technicianInvitations   TechnicianInvitation[]
  customerCenterConfig    CustomerCenterConfig?
  homeCampaign            HomeCampaign?
  customerCoupons         CustomerCoupon[]
  storedValueAccounts     StoredValueAccount[]
  storedValueRecharges    StoredValueRecharge[]
  customerFeedbacks       CustomerFeedback[]
  accountDeletionRequests AccountDeletionRequest[]
  customerAddresses       CustomerAddress[]
}

model User {
  id                           String                        @id @default(cuid())
  organizationId               String?
  organization                 Organization?                 @relation(fields: [organizationId], references: [id])
  role                         UserRole
  displayName                  String
  phoneEncrypted               String?
  phoneVerifiedAt              DateTime?
  customerPhoneIdentity        CustomerPhoneIdentity?
  status                       String                        @default("ACTIVE")
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  identities                   ExternalIdentity[]
  wechatUnionIdentity          WechatUnionIdentity?
  sessions                     Session[]
  technicianH5LoginTickets     TechnicianH5LoginTicket[]
  memberships                  StaffMembership[]
  mfaCredential                MfaCredential?
  staffPasswordCredential      StaffPasswordCredential?
  staffPasswordLoginChallenges StaffPasswordLoginChallenge[]
  staffPasswordSetupChallenges StaffPasswordSetupChallenge[]
  staffTrustedDevices          StaffTrustedDevice[]
  customerOrders               Order[]                       @relation("CustomerOrders")
  payerPayments                Payment[]                     @relation("PaymentPayer")
  therapistOrders              Order[]                       @relation("TherapistOrders")
  therapistShifts              TherapistShift[]              @relation("TherapistShifts")
  customerReservations         AppointmentReservation[]      @relation("CustomerReservations")
  therapistReservations        AppointmentReservation[]      @relation("TherapistReservations")
  requestedMfaRecoveries       MfaRecoveryRequest[]          @relation("MfaRecoveryTarget")
  reviewedMfaRecoveries        MfaRecoveryRequest[]          @relation("MfaRecoveryReviewer")
  createdSafetyRosters         SafetyDutyRoster[]            @relation("SafetyRosterCreator")
  primarySafetyRosters         SafetyDutyRoster[]            @relation("SafetyRosterPrimary")
  backupSafetyRosters          SafetyDutyRoster[]            @relation("SafetyRosterBackup")
  reportedSafetyIncidents      SafetyIncident[]              @relation("SafetyIncidentReporter")
  primarySafetyIncidents       SafetyIncident[]              @relation("SafetyIncidentPrimary")
  backupSafetyIncidents        SafetyIncident[]              @relation("SafetyIncidentBackup")
  acknowledgedIncidents        SafetyIncident[]              @relation("SafetyIncidentAcknowledger")
  closedSafetyIncidents        SafetyIncident[]              @relation("SafetyIncidentCloser")
  addressVerifications         AddressVerification[]
  phoneVerificationChallenges  PhoneVerificationChallenge[]
  technicianLocation           TechnicianLocation?
  technicianProfile            TechnicianProfile?            @relation("TechnicianProfileOwner")
  reviewedTechnicianProfiles   TechnicianProfile[]           @relation("TechnicianProfileReviewer")
  submittedTechnicianReviews   TechnicianReview[]            @relation("TechnicianReviewCustomer")
  receivedTechnicianReviews    TechnicianReview[]            @relation("TechnicianReviewTechnician")
  createdTechnicianInvitations TechnicianInvitation[]        @relation("TechnicianInvitationCreator")
  claimedTechnicianInvitations TechnicianInvitation[]        @relation("TechnicianInvitationClaimant")
  customerCoupons              CustomerCoupon[]
  storedValueAccounts          StoredValueAccount[]
  storedValueRecharges         StoredValueRecharge[]
  customerFeedbacks            CustomerFeedback[]
  accountDeletionRequests      AccountDeletionRequest[]
  customerAddresses            CustomerAddress[]
}

model CustomerCenterConfig {
  organizationId       String       @id
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  levelLabel           String       @default("普通用户")
  customerServicePhone String?
  cityNewsTitle        String       @default("城市快讯")
  cityNewsContent      String       @default("中原到家持续为郑州用户提供规范上门服务")
  appBannerTitle       String       @default("中原到家小程序")
  appBannerSubtitle    String       @default("无需下载 APP，微信内即可预约")
  appDownloadUrl       String?
  safeguardItems       Json         @default("[]")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model HomeCampaign {
  organizationId String @id
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  version Int @default(0)
  content Json
  imageBytes Bytes?
  updatedAt DateTime @updatedAt
}

model CustomerCoupon {
  id                  String               @id @default(cuid())
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerId          String
  customer            User                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  title               String
  amountFen           BigInt
  minimumSpendFen     BigInt
  applicability       String               @default("仅限服务项目费")
  canApplyToTravelFee Boolean              @default(false)
  validFrom           DateTime             @default(now())
  expiresAt           DateTime
  status              CustomerCouponStatus @default(AVAILABLE)
  usedAt              DateTime?
  sourceCode          String?
  usedOrderId         String?              @unique
  usedOrder           Order?               @relation(fields: [usedOrderId], references: [id], onDelete: Restrict)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([organizationId, customerId, sourceCode])
  @@index([organizationId, customerId, status, expiresAt])
}

model StoredValueAccount {
  id                  String                          @id @default(cuid())
  organizationId      String
  organization        Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerId          String
  customer            User                            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  balanceFen          BigInt                          @default(0)
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt
  cards               StoredValueCard[]
  transactions        StoredValueTransaction[]
  recharges           StoredValueRecharge[]
  firstRechargeReward StoredValueFirstRechargeReward?

  @@unique([organizationId, customerId])
  @@index([organizationId, updatedAt])
}

model StoredValueCard {
  id         String                @id @default(cuid())
  accountId  String
  account    StoredValueAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name       String
  type       StoredValueCardType
  balanceFen BigInt                @default(0)
  status     StoredValueCardStatus @default(AVAILABLE)
  expiresAt  DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@index([accountId, status, type])
}

model StoredValueTransaction {
  id              String                          @id @default(cuid())
  accountId       String
  account         StoredValueAccount              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  type            String
  changeFen       BigInt
  balanceAfterFen BigInt
  description     String
  occurredAt      DateTime                        @default(now())
  rechargeId      String?                         @unique
  recharge        StoredValueRecharge?            @relation(fields: [rechargeId], references: [id], onDelete: Restrict)
  rewardId        String?                         @unique
  reward          StoredValueFirstRechargeReward? @relation(fields: [rewardId], references: [id], onDelete: Restrict)

  @@index([accountId, occurredAt])
}

model StoredValueRecharge {
  id                    String                          @id @default(cuid())
  organizationId        String
  organization          Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerId            String
  customer              User                            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  accountId             String
  account               StoredValueAccount              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  amountFen             BigInt
  status                StoredValueRechargeStatus       @default(PENDING)
  merchantPaymentNo     String                          @unique
  providerReference     String?
  providerTransactionId String?                         @unique
  payerOpenIdHash       String?
  prepayState           WechatPrepayState               @default(NONE)
  prepayRequestedAt     DateTime?
  prepayReadyAt         DateTime?
  prepayFailureCode     String?
  idempotencyKey        String
  requestFingerprint    String
  expiresAt             DateTime
  succeededAt           DateTime?
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt
  transaction           StoredValueTransaction?
  firstRechargeReward   StoredValueFirstRechargeReward?

  @@unique([customerId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([customerId, status, createdAt])
}

model StoredValueFirstRechargeReward {
  id          String                  @id @default(cuid())
  accountId   String                  @unique
  account     StoredValueAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  rechargeId  String                  @unique
  recharge    StoredValueRecharge     @relation(fields: [rechargeId], references: [id], onDelete: Restrict)
  amountFen   BigInt                  @default(8800)
  claimedAt   DateTime?
  createdAt   DateTime                @default(now())
  transaction StoredValueTransaction?
}

model CustomerFeedback {
  id               String                 @id @default(cuid())
  organizationId   String
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerId       String
  customer         User                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  category         String
  contentEncrypted String
  contactEncrypted String?
  status           CustomerFeedbackStatus @default(OPEN)
  createdAt        DateTime               @default(now())
  resolvedAt       DateTime?

  @@index([organizationId, status, createdAt])
  @@index([customerId, createdAt])
}

model AccountDeletionRequest {
  id              String                       @id @default(cuid())
  organizationId  String
  organization    Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerId      String
  customer        User                         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  reasonEncrypted String?
  status          AccountDeletionRequestStatus @default(PENDING)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  completedAt     DateTime?

  @@index([organizationId, status, createdAt])
  @@index([customerId, status, createdAt])
}

model CustomerAddress {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerId           String
  customer             User         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contactNameEncrypted String
  phoneEncrypted       String
  detailEncrypted      String
  latitude             Float
  longitude            Float
  coordinateSystem     String       @default("GCJ-02")
  isDefault            Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([organizationId, customerId, isDefault, updatedAt])
}

model ExternalIdentity {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         IdentityProvider
  subjectHash      String
  subjectEncrypted String
  unionIdHash      String?
  unionIdEncrypted String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  sessions         Session[]

  @@unique([provider, subjectHash])
  @@index([userId, provider])
}

// A database-enforced cross-channel binding prevents the same WeChat UnionID
// from being attached to two local users during concurrent OAuth callbacks.
model WechatUnionIdentity {
  unionIdHash      String   @id
  unionIdEncrypted String
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Session {
  id                      String              @id @default(cuid())
  userId                  String
  user                    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash               String              @unique
  expiresAt               DateTime
  revokedAt               DateTime?
  lastSeenAt              DateTime            @default(now())
  createdAt               DateTime            @default(now())
  mfaVerifiedUntil        DateTime?
  authChannel             String              @default("LEGACY")
  authProvider            String              @default("unknown")
  // Bind payment identity to the actual WeChat authorization for this session.
  wechatIdentityId        String?
  wechatIdentity          ExternalIdentity?   @relation(fields: [wechatIdentityId], references: [id], onDelete: Restrict)
  // Reverified phone changes invalidate old SMS tokens; same-number refreshes do not.
  customerPhoneHash       String?
  // Login assurance is separate from the five-minute TOTP step-up grant.
  staffVerifiedUntil      DateTime?
  staffVerificationMethod String?
  staffPasswordVersion    Int?
  trustedDeviceId         String?
  trustedDevice           StaffTrustedDevice? @relation(fields: [trustedDeviceId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([trustedDeviceId])
  @@index([wechatIdentityId])
}

// A phone is an authentication binding, never a reason to rewrite financial rows.
model CustomerPhoneIdentity {
  phoneHash String   @id
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomerSmsLoginChallenge {
  id                String    @id
  phoneHash         String
  phoneEncrypted    String
  requestIpHash     String
  codeHash          String
  status            String    @default("PENDING")
  attempts          Int       @default(0)
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  consumedAt        DateTime?
  providerRequestId String?
  providerBizId     String?

  @@index([phoneHash, createdAt])
  @@index([expiresAt])
}

// Purpose-isolated from customer and administrator verification challenges.
model TechnicianPhoneLoginChallenge {
  id                String    @id
  phoneHash         String
  phoneEncrypted    String
  requestIpHash     String
  secretHash        String
  codeHash          String
  status            String    @default("PENDING")
  attempts          Int       @default(0)
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  consumedAt        DateTime?
  providerRequestId String?
  providerBizId     String?

  @@index([phoneHash, createdAt])
  @@index([expiresAt])
}

model StaffPasswordCredential {
  userId         String    @id
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneHash      String    @unique
  loginAlias     String?   @unique
  passwordHash   String
  version        Int       @default(1)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model StaffPasswordLoginChallenge {
  id                String    @id
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretHash        String
  passwordVersion   Int
  phoneHash         String
  codeHash          String
  status            String    @default("PENDING")
  attempts          Int       @default(0)
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  consumedAt        DateTime?
  providerRequestId String?
  providerBizId     String?

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// First-time activation only. Never reused for customer login or password reset.
model StaffPasswordSetupChallenge {
  id                String    @id
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneHash         String
  secretHash        String
  codeHash          String
  status            String    @default("PENDING")
  attempts          Int       @default(0)
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  consumedAt        DateTime?
  providerRequestId String?
  providerBizId     String?

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model StaffTrustedDevice {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash            String    @unique
  userAgentHash        String
  label                String    @default("常用设备")
  createdAt            DateTime  @default(now())
  expiresAt            DateTime
  lastUsedAt           DateTime?
  revokedAt            DateTime?
  mfaEnabledAtSnapshot DateTime
  passwordVersion      Int       @default(0)
  phoneHash            String
  sessions             Session[]

  @@index([userId, revokedAt, expiresAt])
}

model BrowserLoginChallenge {
  id                String    @id
  browserSecretHash String
  confirmationHash  String
  status            String    @default("PENDING")
  failedAttempts    Int       @default(0)
  approvedUserId    String?
  approvedSessionId String?
  claimedSessionId  String?   @unique
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  approvedAt        DateTime?
  consumedAt        DateTime?
  lastPolledAt      DateTime?

  @@index([expiresAt])
}

model BrowserLoginRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

model MapRequestRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

model PhoneVerificationChallenge {
  id                String    @id
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneHash         String
  phoneEncrypted    String
  codeHash          String
  status            String    @default("PENDING")
  attempts          Int       @default(0)
  providerRequestId String?
  providerBizId     String?
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([phoneHash, createdAt])
  @@index([status, expiresAt])
}

model PhoneVerificationRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

model AddressVerification {
  id               String                 @id @default(cuid())
  userId           String
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservationId    String                 @unique
  reservation      AppointmentReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  detailHash       String
  adcode           String
  latitude         Float
  longitude        Float
  coordinateSystem String                 @default("GCJ-02")
  expiresAt        DateTime
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([userId, expiresAt])
}

model MfaCredential {
  userId              String    @id
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEncrypted     String
  enabledAt           DateTime?
  enrollmentSessionId String?
  enrollmentExpiresAt DateTime?
  lastAcceptedStep    BigInt?
  failedAttempts      Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model MfaRecoveryRequest {
  id                String            @id
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  targetUserId      String
  targetUser        User              @relation("MfaRecoveryTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  sourceSessionId   String
  status            MfaRecoveryStatus @default(PENDING)
  reviewerUserId    String?
  reviewerUser      User?             @relation("MfaRecoveryReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  reviewerSessionId String?
  reasonCode        String?
  createdAt         DateTime          @default(now())
  expiresAt         DateTime
  reviewedAt        DateTime?
  executedAt        DateTime?

  @@index([organizationId, status, createdAt])
  @@index([targetUserId, createdAt])
}

model StaffMembership {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           UserRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, organizationId, role])
  @@index([organizationId, status, role])
}

model Service {
  id              String                   @id @default(cuid())
  organizationId  String
  organization    Organization             @relation(fields: [organizationId], references: [id])
  slug            String                   @unique
  name            String
  category        ServiceCategory
  subtitle        String
  badge           String?
  description     String
  durationMinutes Int
  priceFen        BigInt
  featured        Boolean                  @default(false)
  published       Boolean                  @default(false)
  steps           Json
  boundaries      Json
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  orderItems      OrderItem[]
  reservations    AppointmentReservation[]
}

model TherapistShift {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  therapistId    String
  therapist      User         @relation("TherapistShifts", fields: [therapistId], references: [id])
  startsAt       DateTime
  endsAt         DateTime
  status         ShiftStatus  @default(ACTIVE)
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, startsAt])
  @@index([therapistId, status, startsAt])
}

model AppointmentReservation {
  id                  String               @id @default(cuid())
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id])
  serviceId           String
  service             Service              @relation(fields: [serviceId], references: [id])
  therapistId         String
  therapist           User                 @relation("TherapistReservations", fields: [therapistId], references: [id])
  customerId          String
  customer            User                 @relation("CustomerReservations", fields: [customerId], references: [id])
  serviceAmountFen    BigInt
  startsAt            DateTime
  endsAt              DateTime
  expiresAt           DateTime
  status              ReservationStatus    @default(HOLD)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  order               Order?
  addressVerification AddressVerification?

  @@index([organizationId, startsAt])
  @@index([therapistId, status, startsAt])
  @@index([customerId, status, expiresAt])
}

model Order {
  id                      String                  @id @default(cuid())
  orderNo                 String                  @unique
  organizationId          String
  organization            Organization            @relation(fields: [organizationId], references: [id])
  customerId              String
  customer                User                    @relation("CustomerOrders", fields: [customerId], references: [id])
  therapistId             String?
  therapist               User?                   @relation("TherapistOrders", fields: [therapistId], references: [id])
  reservationId           String?                 @unique
  reservation             AppointmentReservation? @relation(fields: [reservationId], references: [id])
  status                  OrderStatus
  appointmentStart        DateTime
  appointmentEnd          DateTime
  serviceAmountFen        BigInt
  travelFeeFen            BigInt
  discountFen             BigInt                  @default(0)
  payableFen              BigInt
  addressEncrypted        String
  addressLatitude         Float?
  addressLongitude        Float?
  addressCoordinateSystem String?
  policyVersion           String
  paymentExpiresAt        DateTime?
  customerHiddenAt        DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  items                   OrderItem[]
  events                  OrderEvent[]
  payment                 Payment?
  friendPaymentShares     FriendPaymentShare[]
  idempotencyKey          String
  requestFingerprint      String
  safetyIncidents         SafetyIncident[]
  technicianReview        TechnicianReview?
  appliedCoupon           CustomerCoupon?

  @@unique([customerId, idempotencyKey])
  @@index([organizationId, status, appointmentStart])
  @@index([customerId, customerHiddenAt, createdAt])
}

model TechnicianProfile {
  id                  String                       @id @default(cuid())
  organizationId      String
  organization        Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  technicianId        String                       @unique
  technician          User                         @relation("TechnicianProfileOwner", fields: [technicianId], references: [id], onDelete: Cascade)
  publicName          String                       @default("")
  ageRange            String?
  version             Int                          @default(0)
  selfRegistered      Boolean                      @default(false)
  registrationChannel String                       @default("LEGACY")
  realNameEncrypted   String?
  serviceCity         String                       @default("")
  serviceAreas        Json                         @default("[]")
  availableTimeSlots  Json                         @default("[]")
  serviceIds          Json                         @default("[]")
  avatarUrl           String?
  galleryUrls         Json                         @default("[]")
  introduction        String                       @default("")
  specialties         Json                         @default("[]")
  serviceYears        Int?
  certificates        Json                         @default("[]")
  status              TechnicianProfileStatus      @default(DRAFT)
  rejectionReason     String?
  reviewedById        String?
  reviewedBy          User?                        @relation("TechnicianProfileReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt          DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  photos              TechnicianPhoto[]
  identityDocuments   TechnicianIdentityDocument[]

  @@index([organizationId, status, updatedAt])
}

// Identity documents are private application material. They are encrypted at
// rest and are never referenced by the public technician profile or a public URL.
model TechnicianIdentityDocument {
  id               String                         @id @default(cuid())
  profileId        String
  profile          TechnicianProfile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind             TechnicianIdentityDocumentKind
  contentEncrypted String
  digest           String
  width            Int
  height           Int
  mimeType         String                         @default("image/jpeg")
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt

  @@unique([profileId, kind])
  @@index([profileId, updatedAt])
}

// OAuth state is one-time and browser-bound. Neither the raw state nor the
// browser nonce is stored, so database reads cannot replay an OAuth callback.
model TechnicianH5OAuthState {
  id                 String    @id @default(cuid())
  stateHash          String    @unique
  browserBindingHash String
  expiresAt          DateTime
  consumedAt         DateTime?
  createdAt          DateTime  @default(now())

  @@index([expiresAt])
}

// The OAuth callback redirects with this one-time ticket in the URL fragment.
// A real session token is minted only after the H5 exchanges the ticket.
model TechnicianH5LoginTicket {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

// Only approved profile references are served publicly. Private drafts require
// owner or organization management authorization; backups include photo bytes.
model TechnicianPhoto {
  id        String            @id @default(cuid())
  profileId String
  profile   TechnicianProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  digest    String
  content   Bytes
  width     Int
  height    Int
  createdAt DateTime          @default(now())

  @@unique([profileId, digest])
  @@index([profileId, createdAt])
}

model TechnicianReview {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orderId        String                 @unique
  order          Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customerId     String
  customer       User                   @relation("TechnicianReviewCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  technicianId   String
  technician     User                   @relation("TechnicianReviewTechnician", fields: [technicianId], references: [id], onDelete: Restrict)
  rating         Int
  content        String
  status         TechnicianReviewStatus @default(PENDING_REVIEW)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([technicianId, status, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([customerId, createdAt])
}

model TechnicianInvitation {
  id             String                     @id @default(cuid())
  organizationId String
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  publicName     String
  tokenHash      String                     @unique
  status         TechnicianInvitationStatus @default(PENDING)
  expiresAt      DateTime
  createdById    String
  createdBy      User                       @relation("TechnicianInvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  claimedById    String?
  claimedBy      User?                      @relation("TechnicianInvitationClaimant", fields: [claimedById], references: [id], onDelete: Restrict)
  claimedAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([organizationId, status, expiresAt])
  @@index([claimedById, claimedAt])
}

model TechnicianLocation {
  id               String   @id @default(cuid())
  technicianId     String   @unique
  technician       User     @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  latitude         Float
  longitude        Float
  coordinateSystem String   @default("GCJ-02")
  accuracyMeters   Float?
  reportedAt       DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([reportedAt])
}

model SafetyDutyRoster {
  id                            String           @id @default(cuid())
  organizationId                String
  organization                  Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  primaryUserId                 String
  primaryUser                   User             @relation("SafetyRosterPrimary", fields: [primaryUserId], references: [id], onDelete: Restrict)
  backupUserId                  String
  backupUser                    User             @relation("SafetyRosterBackup", fields: [backupUserId], references: [id], onDelete: Restrict)
  acknowledgementTimeoutSeconds Int
  active                        Boolean          @default(true)
  createdById                   String
  createdBy                     User             @relation("SafetyRosterCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt                     DateTime         @default(now())
  deactivatedAt                 DateTime?
  incidents                     SafetyIncident[]

  @@index([organizationId, active])
  @@index([primaryUserId, active])
  @@index([backupUserId, active])
}

model SafetyIncident {
  id                   String                 @id @default(cuid())
  organizationId       String
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orderId              String
  order                Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reporterUserId       String
  reporter             User                   @relation("SafetyIncidentReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  rosterId             String
  roster               SafetyDutyRoster       @relation(fields: [rosterId], references: [id], onDelete: Restrict)
  primaryUserId        String
  primaryUser          User                   @relation("SafetyIncidentPrimary", fields: [primaryUserId], references: [id], onDelete: Restrict)
  backupUserId         String
  backupUser           User                   @relation("SafetyIncidentBackup", fields: [backupUserId], references: [id], onDelete: Restrict)
  category             SafetyIncidentCategory
  status               SafetyIncidentStatus   @default(OPEN)
  idempotencyKey       String
  requestFingerprint   String
  acknowledgementDueAt DateTime
  acknowledgedById     String?
  acknowledgedBy       User?                  @relation("SafetyIncidentAcknowledger", fields: [acknowledgedById], references: [id], onDelete: Restrict)
  acknowledgedAt       DateTime?
  escalatedAt          DateTime?
  closedById           String?
  closedBy             User?                  @relation("SafetyIncidentCloser", fields: [closedById], references: [id], onDelete: Restrict)
  resolutionCode       String?
  closedAt             DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  events               SafetyIncidentEvent[]

  @@unique([reporterUserId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([status, acknowledgementDueAt])
  @@index([orderId, createdAt])
}

model SafetyIncidentEvent {
  id         String         @id @default(cuid())
  incidentId String
  incident   SafetyIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type       String
  actorId    String?
  payload    Json
  createdAt  DateTime       @default(now())

  @@index([incidentId, createdAt])
}

enum WechatPrepayState {
  NONE
  DISPATCHING
  READY
  UNKNOWN
}

enum WechatCloseState {
  NONE
  DISPATCHING
  UNKNOWN
  CONFIRMED
}

model Payment {
  id                    String            @id @default(cuid())
  orderId               String            @unique
  order                 Order             @relation(fields: [orderId], references: [id])
  provider              PaymentProvider
  kind                  PaymentKind       @default(SELF)
  payerUserId           String?
  payer                 User?             @relation("PaymentPayer", fields: [payerUserId], references: [id], onDelete: Restrict)
  payerOpenIdHash       String?
  status                PaymentStatus     @default(PENDING)
  merchantPaymentNo     String            @unique
  amountFen             BigInt
  refundReservedFen     BigInt            @default(0)
  refundedFen           BigInt            @default(0)
  providerReference     String?
  prepayState           WechatPrepayState @default(NONE)
  prepayRequestedAt     DateTime?
  prepayReadyAt         DateTime?
  prepayFailureCode     String?
  closeState            WechatCloseState  @default(NONE)
  closeRequestedAt      DateTime?
  closeReason           String?
  closeDispatchedAt     DateTime?
  closeVerifiedAt       DateTime?
  closeAttempts         Int               @default(0)
  providerTradeState    String?
  providerCheckedAt     DateTime?
  recoveryAttempts      Int               @default(0)
  recoveryNextCheckAt   DateTime?
  recoveryLeaseToken    String?
  recoveryLeaseUntil    DateTime?
  recoveryFailureCode   String?
  recoveryReviewAt      DateTime?
  providerTransactionId String?           @unique
  failureCode           String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  succeededAt           DateTime?
  closedAt              DateTime?
  events                PaymentEvent[]
  refunds               Refund[]

  @@index([status, createdAt])
  @@index([provider, status, recoveryNextCheckAt])
  @@index([payerUserId, createdAt])
}

// The bearer share capability is never persisted in plaintext. Ownership stays with Order.customerId.
model FriendPaymentShare {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([orderId, expiresAt])
}

model PaymentEvent {
  id              String   @id @default(cuid())
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id])
  type            String
  providerEventId String?  @unique
  payload         Json
  createdAt       DateTime @default(now())

  @@index([paymentId, createdAt])
}

model Refund {
  id                 String               @id @default(cuid())
  paymentId          String
  payment            Payment              @relation(fields: [paymentId], references: [id])
  merchantRefundNo   String               @unique
  amountFen          BigInt
  status             RefundStatus         @default(REQUESTED)
  reason             RefundReason
  policyVersion      String
  requestedById      String
  reviewedById       String?
  reviewCode         String?
  idempotencyKey     String
  requestFingerprint String
  providerRefundId   String?              @unique
  requestedAt        DateTime             @default(now())
  reviewedAt         DateTime?
  submittedAt        DateTime?
  succeededAt        DateTime?
  nextCheckAt        DateTime?
  checkAttempts      Int                  @default(0)
  updatedAt          DateTime             @updatedAt
  events             RefundEvent[]
  posting            RefundLedgerPosting?

  @@unique([paymentId, idempotencyKey])
  @@index([paymentId, status])
  @@index([status, nextCheckAt])
}

model RefundEvent {
  id              String   @id @default(cuid())
  refundId        String
  refund          Refund   @relation(fields: [refundId], references: [id])
  type            String
  actorId         String?
  providerEventId String?  @unique
  payload         Json
  createdAt       DateTime @default(now())

  @@index([refundId, createdAt])
}

// A single posting represents two equal debit/credit legs. Success is appended once.
model RefundLedgerPosting {
  id            String   @id @default(cuid())
  refundId      String   @unique
  refund        Refund   @relation(fields: [refundId], references: [id])
  amountFen     BigInt
  debitAccount  String   @default("CUSTOMER_REFUND_LIABILITY")
  creditAccount String   @default("CHANNEL_REFUND_OUTFLOW")
  createdAt     DateTime @default(now())
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id])
  serviceId       String
  service         Service @relation(fields: [serviceId], references: [id])
  serviceName     String
  durationMinutes Int
  unitPriceFen    BigInt
  quantity        Int     @default(1)
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  type      String
  actorId   String?
  payload   Json
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  organizationId String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

model OutboxEvent {
  id                    String    @id @default(cuid())
  organizationId        String?
  aggregateId           String
  type                  String
  payload               Json
  createdAt             DateTime  @default(now())
  publishedAt           DateTime?
  attempts              Int       @default(0)
  nextAttemptAt         DateTime  @default(now())
  leaseToken            String?
  leaseUntil            DateTime?
  dispatchStartedAt     DateTime?
  lastErrorCode         String?
  providerReference     String?
  providerBizId         String?
  deadLetteredAt        DateTime?
  deliveryStatus        String?
  deliveryQueryAttempts Int       @default(0)
  deliveryNextQueryAt   DateTime?
  deliveryCheckedAt     DateTime?
  deliveredAt           DateTime?
  deliveryErrorCode     String?

  @@index([publishedAt, createdAt])
  @@index([organizationId, createdAt])
  @@index([publishedAt, deadLetteredAt, nextAttemptAt, leaseUntil], map: "OutboxEvent_dispatch_idx")
  @@index([deliveryStatus, deliveryNextQueryAt, leaseUntil], map: "OutboxEvent_delivery_query_idx")
}
