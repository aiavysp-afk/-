# Shared
NODE_ENV=development
BRAND_NAME=中原到家
PUBLIC_BASE_DOMAIN=mtsc.top
API_PORT=3100
API_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Database / jobs
DATABASE_URL=postgresql://zhongyuan:local_only@localhost:5432/zhongyuan_daojia?schema=public
REDIS_URL=redis://localhost:6379

# WeChat public identifiers (not secrets)
WECHAT_MINIAPP_APP_ID=wxab76ea213eb6d01a
WECHAT_OFFICIAL_ACCOUNT_ID=gh_a4b5f9d63539

# Local authentication defaults. Production startup rejects these values.
AUTH_PROVIDER=mock
# Private test opt-in only. Production always enforces staff MFA even if false.
STAFF_MFA_REQUIRED=false
# Independently opt in only after browser/miniapp identity acceptance.
STAFF_BROWSER_LOGIN_ENABLED=false
# BROWSER_LOGIN_TEST_DATABASE_URL=
# Isolated test database only; never use a production connection for verification.
# MFA_TEST_DATABASE_URL=
# SAFETY_TEST_DATABASE_URL=
AUTH_SESSION_TTL_SECONDS=604800
AUTH_SESSION_PEPPER=local-only-session-pepper-change-before-production
DATA_ENCRYPTION_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Must remain false outside an isolated local database.
SEED_DEVELOPMENT_IDENTITIES=false

# Production integrations must be supplied by the owning enterprise account.
# WECHAT_MINIAPP_SECRET=
# WECHAT_MCH_ID=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_MERCHANT_SERIAL_NO=
# WECHAT_PAY_PRIVATE_KEY_PATH=
# WECHAT_PAY_MERCHANT_CERT_PATH=
# Preferred WeChat Pay platform public-key mode (PUB_KEY_ID_*).
# WECHAT_PAY_PUBLIC_KEY_ID=
# WECHAT_PAY_PUBLIC_KEY_PATH=
# Compatibility only for deployments still using the platform certificate mode.
# WECHAT_PAY_PLATFORM_CERT_PATH=
# WECHAT_PAY_NOTIFY_URL=https://api.example.com/v1/payments/wechat/notify

# Safety gates: production startup rejects mock modes.
PAYMENT_PROVIDER=mock
WECHAT_PAY_PREPAY_ENABLED=false
WECHAT_PAY_RECOVERY_ENABLED=false
WECHAT_PAY_REFUND_ENABLED=false
# WECHAT_PAY_REFUND_NOTIFY_URL=https://api.example.com/v1/payments/wechat/refund-notify
SMS_PROVIDER=mock
MAP_PROVIDER=mock
SMS_SEND_ENABLED=false
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
# Optional STS session token; refresh via controlled secret provisioning.
ALIYUN_SMS_SECURITY_TOKEN=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
MAP_GEOCODING_ENABLED=false
TENCENT_MAP_KEY=
TENCENT_MAP_SIGNING_SECRET=
SAFETY_HOTLINE=
SAFETY_EMERGENCY_PHONE=
# WeChat customer service: public identifiers only, not WeCom secret/access_token.
CUSTOMER_SERVICE_PROVIDER=none
WECOM_CORP_ID=
WECOM_CUSTOMER_SERVICE_URL=
# Confirm link ownership, valid customer-service account and miniapp binding before enabling.
WECOM_CUSTOMER_SERVICE_CONFIRMED=false
# Use wecom only after staffing, response/escalation and device acceptance are confirmed.
SAFETY_CONTACT_MODE=phone
SAFETY_DUTY_CONFIRMED=false
